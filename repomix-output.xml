279:     exportPresentation: function(dataObj: StreamChartSession | null, dateStr: string, currentBrand: string): void {
280:         if (!dataObj || !dataObj.data || dataObj.data.length === 0) return;
281: 
282:         const allViewers = dataObj.data.map(d => d.viewers);
283:         const overall = this.calcStats(allViewers);
284:         const initialViewers = dataObj.initial_viewers || allViewers[0] || 0;
285: 
286:         let p1: number[] = [], p2: number[] = [], p3: number[] = [];
287:         let tQ = dataObj.phase_questions_start || "99:99:99";
288:         let tP = dataObj.phase_prayers_start || "99:99:99";
289: 
290:         const toSec = (t?: string): number => {
291:             if (!t || typeof t !== 'string') return 0;
292:             const clean = t.replace(/\s/g, '');
293:             if (!clean) return 0;
294:             
295:             const parts = clean.split(':');
296:             let sec = 0;
297:             
298:             const parsedParts = parts.map(part => {
299:                 const parsed = parseInt(part, 10);
300:                 return isNaN(parsed) ? 0 : parsed;
301:             });
302:             
303:             parsedParts.reverse().forEach((val, i) => {
304:                 sec += val * Math.pow(60, i);
305:             });
306:             
307:             return sec;
308:         };
309: 
310:         dataObj.data.forEach(d => {
311:             const sTime = toSec(d.time);
312:             const sQ = toSec(tQ);
313:             const sP = toSec(tP);
314: 
315:             if (sTime < sQ) p1.push(d.viewers);
316:             else if (sTime >= sQ && sTime < sP) p2.push(d.viewers);
317:             else p3.push(d.viewers);
318:         });
319: 
320:         const st1 = this.calcStats(p1);
321:         const st2 = this.calcStats(p2);
322:         const st3 = this.calcStats(p3);
323: 
324:         const htmlTemplate = `

 15: const DEFAULT_OPTIONS: OptionsState = {
 16:     newTitleSS: 'СШ Урок',
 17:     newTitlePreach: 'Проповідь',
 18:     ui_locale: 'auto',
 19:     anti_afk_enabled: true,

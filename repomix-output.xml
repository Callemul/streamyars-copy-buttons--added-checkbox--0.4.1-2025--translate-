 59:     const cleaner = (window.SYH_UTILS && window.SYH_UTILS.cleanTelegramHeaders) 
 60:         ? window.SYH_UTILS.cleanTelegramHeaders 
 61:         : (window.cleanTelegramHeaders || (t => t));
 62:     const cleanedText = cleaner(text);
 63: 
 64:     let messages = [cleanedText];
 65: 
 66:     let allQuestions = [];
 67:     let allPrayers = [];
 68:     const deletedItems = [];
 69: 
 70:     const processOldItem = (itemsArray, itemObj, filterIds, id, deletedArr, src) => {
 71:         let lines = itemObj.rawLines;
 72:         while (lines.length > 0 && lines[0].trim() === "") lines.shift();
 73:         if (lines.length === 0) return;
 74: 
 75:         let author = lines[0].trim();
 76:         let rawText = lines.slice(1).map(l => l.trimEnd()).join('\n').trim();
 77:         if (!author) author = "Анонім";
 78: 
 79:         const totalQuestionsInBlock = window.countQuestionsInText(rawText);
 80: 
 81:         if (filterIds && filterIds.includes(id)) {
 82:             deletedArr.push({ originalId: id, author: author, type: 'block', count: totalQuestionsInBlock });
 83:             return;
 84:         }
 85:         
 86:         if (rawText.includes('🔹') && filterIds) {
 87:             const subIndexesToRemove = filterIds.filter(fid => Math.floor(fid) === id && fid % 1 !== 0).map(fid => Math.round((fid % 1) * 10));
 88: 
 89:             if (subIndexesToRemove.length > 0) {
 90:                 let subQuestions = rawText.split('🔹').map(t => t.trim()).filter(Boolean);
 91:                 subIndexesToRemove.forEach(idx => {
 92:                     if (subQuestions[idx-1]) deletedArr.push({ originalId: `${id}.${idx}`, author: author, type: 'sub', count: 1 });
 93:                 });
 94: 
 95:                 let filteredSubQuestions = subQuestions.filter((_, idx) => !subIndexesToRemove.includes(idx + 1));
 96: 
 97:                 if (filteredSubQuestions.length === 0) {
 98:                     deletedArr.push({ originalId: id, author: author, type: 'block', count: totalQuestionsInBlock });
 99:                     return; 
100:                 } else if (filteredSubQuestions.length === 1) {
101:                     rawText = filteredSubQuestions[0];
102:                 } else {
103:                     rawText = filteredSubQuestions.map(q => `🔹${q}`).join('\n');
104:                 }
105:             }
106:         }
107:         itemsArray.push({ author, text: rawText, source: src });
108:     };

350:             list = list.filter(item => {
351:                 if (!item.timestamp) return true;
352:                 return (now - item.timestamp) < thirtyDaysMs;
353:             });
354: 
355:             list = list.filter(item => item.text !== text);
356:             
357:             list.push({ 
358:                 author: author, 
359:                 text: text, 
360:                 type: type, 
361:                 icon: icon,
362:                 roomId: currentRoomId,
363:                 timestamp: now
364:             });
365:             
366:             storage.set({ 'syh_prayers': list });
367:         });
368:     },
369: 
370:     removeFromDatabase: function(text: string): void {
371:         if (this.UI && this.UI.prayersCache) {
372:             this.UI.prayersCache = this.UI.prayersCache.filter((item: any) => item.text !== text);
373:         }
374: 
375:         const storage = SYH_STORAGE || (window as any).SYH_STORAGE || (this.UTILS && this.UTILS.storage) || ((window as any).SYH_UTILS && (window as any).SYH_UTILS.storage);
376: 
377:         if (!storage) {
378:             console.error("SYH_EVENT_COMMENTS: Не знайдено адаптер сховища!");
379:             return;
380:         }
381: 
382:         const now = Date.now();
383:         const thirtyDaysMs = 30 * 24 * 60 * 60 * 1000;
384: 
385:         storage.get(['syh_prayers'], function(result: Record<string, any>) {
386:             let list: PrayerRecord[] = result.syh_prayers || [];
387:             
388:             list = list.filter(item => {
389:                 if (item.text === text) return false;
390:                 if (item.timestamp && (now - item.timestamp) > thirtyDaysMs) return false;
391:                 return true;
392:             });
393:             
394:             storage.set({ 'syh_prayers': list });
395:         });
396:     }
397: };

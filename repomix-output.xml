 96:         const dialog = createMockNode('div', { 'aria-modal': 'true' }, [stayButton]);
 97:         const root = createMockNode('div', {}, [dialog]);
 98: 
 99:         const result = checkAndClickAntiAfk(root);
100:         assert.strictEqual(result, true);
101:         assert.strictEqual(stayButton.wasClicked, true);
102:     });
103: 
104:     test('4. Intercepts Ukrainian localized button text "Залишитися в студії"', () => {
105:         const stayButton = createMockNode('button', {}, [], 'Залишитися в студії');
106:         const dialog = createMockNode('div', { role: 'dialog' }, [stayButton]);
107:         const root = createMockNode('div', {}, [dialog]);
108: 
109:         const i18nMock = {
110:             getMessage: (key) => key === 'stayInStudio' ? 'Залишитися в студії' : ''
111:         };
112: 
113:         const result = checkAndClickAntiAfk(root, i18nMock);
114:         assert.strictEqual(result, true);
115:         assert.strictEqual(stayButton.wasClicked, true);
116:     });
117: 
118:     test('5. Intercepts Russian localized button text "Остаться в студии"', () => {
119:         const stayButton = createMockNode('button', {}, [], 'Остаться в студии');
120:         const dialog = createMockNode('div', { role: 'dialog' }, [stayButton]);
121:         const root = createMockNode('div', {}, [dialog]);
122: 
123:         const result = checkAndClickAntiAfk(root);
124:         assert.strictEqual(result, true);
125:         assert.strictEqual(stayButton.wasClicked, true);
126:     });
127: 
128:     test('6. Returns false when no modal or stay button is present', () => {
129:         const otherButton = createMockNode('button', {}, [], 'Cancel Stream');
130:         const root = createMockNode('div', {}, [otherButton]);
131: 
132:         const result = checkAndClickAntiAfk(root);
133:         assert.strictEqual(result, false);
134:         assert.strictEqual(otherButton.wasClicked, false);
135:     });
136: 
137:     test('7. Returns false gracefully for null or empty document', () => {
138:         assert.strictEqual(checkAndClickAntiAfk(null), false);
139:     });
140: 
141:     test('8. startAntiAfk initializes MutationObserver and handles added nodes', () => {
142:         let observerCallback = null;
143:         let observerObserved = false;
144:         let observerDisconnected = false;
145: 
146:         class MockMutationObserver {
147:             constructor(callback) {
148:                 observerCallback = callback;
149:             }
150:             observe(target, options) {
151:                 observerObserved = true;
152:             }
153:             disconnect() {
154:                 observerDisconnected = true;
155:             }
156:         }
157: 
158:         global.MutationObserver = MockMutationObserver;
159: 
160:         const stayButton = createMockNode('button', {}, [], 'Stay in the studio');
161:         const dialog = createMockNode('div', { role: 'dialog' }, [stayButton]);
162:         const rootNode = createMockNode('div', {}, [dialog]);
163: 
164:         startAntiAfk({}, null, null, rootNode);
165:         assert.strictEqual(observerObserved, true, 'MutationObserver should start observing target node');
166: 
167:         if (observerCallback) {
168:             observerCallback([{ addedNodes: [dialog] }]);
169:         }
170: 
171:         assert.strictEqual(stayButton.wasClicked, true, 'Button should be clicked when MutationObserver fires');
172: 
173:         stopAntiAfk();
174:         assert.strictEqual(observerDisconnected, true, 'stopAntiAfk should disconnect MutationObserver');
175:     });
176: 
177: });

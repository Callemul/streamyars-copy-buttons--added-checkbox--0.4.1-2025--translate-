 42:         local: {
 43:             get: (keys, cb) => mockStorageAdapter.get(keys, cb),
 44:             set: (items, cb) => mockStorageAdapter.set(items, cb),
 45:             remove: (keys, cb) => mockStorageAdapter.remove(keys, cb)
 46:         }
 47:     }
 48: };

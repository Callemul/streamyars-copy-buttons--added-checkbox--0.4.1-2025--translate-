  6: /**
  7:  * Simple DOM element mock for testing Anti-AFK without heavy JSDOM dependency
  8:  */
  9: function createMockNode(tagName, attrs = {}, children = [], textContent = '') {
 10:     let clicked = false;
 11:     const attributes = { ...attrs };
 12: 
 13:     const node = {
 14:         tagName: tagName.toUpperCase(),
 15:         textContent,
 16:         children,
 17:         get wasClicked() {
 18:             return clicked;
 19:         },
 20:         click() {
 21:             clicked = true;
 22:         },
 23:         getAttribute(name) {
 24:             return attributes[name] !== undefined ? attributes[name] : null;
 25:         },
 26:         setAttribute(name, value) {
 27:             attributes[name] = value;
 28:         },
 29:         querySelector(selector) {
 30:             const res = this.querySelectorAll(selector);
 31:             return res.length > 0 ? res[0] : null;
 32:         },
 33:         querySelectorAll(selector) {
 34:             const results = [];
 35:             function walk(current) {
 36:                 for (const child of current.children) {
 37:                     if (matches(child, selector)) {
 38:                         results.push(child);
 39:                     }
 40:                     walk(child);
 41:                 }
 42:             }
 43:             walk(this);
 44:             return results;
 45:         }
 46:     };
 47:     return node;
 48: }

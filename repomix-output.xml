113: export function validateSelectorsSyntax(): void {
114:     if (!SYH_UI.SELECTORS) return;
115:     console.log("[SYH] Запуск синтаксичного сканування CSS-селекторів...");
116:     for (const key in SYH_UI.SELECTORS) {
117:         const selector = SYH_UI.SELECTORS[key];
118:         if (!selector) continue;
119:         try {

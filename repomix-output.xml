  4: const { checkAndClickAntiAfk, startAntiAfk, stopAntiAfk } = await import('../modules/anti_afk.ts');
  5: 
  6: /**
  7:  * Simple DOM element mock for testing Anti-AFK without heavy JSDOM dependency
  8:  */
  9: function createMockNode(tagName, attrs = {}, children = [], textContent = '') {
 10:     let clicked = false;
 11:     const attributes = { ...attrs };
 12: 
 13:     const node = {
 14:         tagName: tagName.toUpperCase(),
 15:         textContent,
 16:         children,
 17:         get wasClicked() {
 18:             return clicked;
 19:         },
 20:         click() {
 21:             clicked = true;
 22:         },
 23:         getAttribute(name) {
 24:             return attributes[name] !== undefined ? attributes[name] : null;
 25:         },
 26:         setAttribute(name, value) {
 27:             attributes[name] = value;
 28:         },
 29:         querySelector(selector) {
 30:             const res = this.querySelectorAll(selector);
 31:             return res.length > 0 ? res[0] : null;
 32:         },
 33:         querySelectorAll(selector) {
 34:             const results = [];
 35:             function walk(current) {
 36:                 for (const child of current.children) {
 37:                     if (matches(child, selector)) {
 38:                         results.push(child);
 39:                     }
 40:                     walk(child);
 41:                 }
 42:             }
 43:             walk(this);
 44:             return results;
 45:         }
 46:     };
 47:     return node;
 48: }
 49: 
 50: function matches(el, selector) {
 51:     if (selector === 'button') {
 52:         return el.tagName === 'BUTTON';
 53:     }
 54:     if (selector === 'div[role="dialog"][aria-label="Are you still there?"]') {
 55:         return el.tagName === 'DIV' && el.getAttribute('role') === 'dialog' && el.getAttribute('aria-label') === 'Are you still there?';
 56:     }
 57:     if (selector === 'div[role="dialog"]') {
 58:         return el.tagName === 'DIV' && el.getAttribute('role') === 'dialog';
 59:     }
 60:     if (selector === '[aria-modal="true"]') {
 61:         return el.getAttribute('aria-modal') === 'true';
 62:     }
 63:     if (selector === 'div[class*="modal"]') {
 64:         return el.tagName === 'DIV' && (el.getAttribute('class') || '').includes('modal');
 65:     }
 66:     if (selector === 'div[class*="Dialog"]') {
 67:         return el.tagName === 'DIV' && (el.getAttribute('class') || '').includes('Dialog');
 68:     }
 69:     return false;
 70: }
 71: 
 72: describe('Anti-AFK Module Tests', () => {
 73: 
 74:     test('1. Intercepts AFK modal with exact "Stay in the studio" button', () => {
 75:         const stayButton = createMockNode('button', {}, [], 'Stay in the studio');
 76:         const dialog = createMockNode('div', { role: 'dialog', 'aria-label': 'Are you still there?' }, [stayButton]);
 77:         const root = createMockNode('div', {}, [dialog]);

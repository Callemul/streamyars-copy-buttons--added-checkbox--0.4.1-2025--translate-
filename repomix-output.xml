181: 
182:         const canvas = document.getElementById('syhChartCanvas') as HTMLCanvasElement | null;
183:         if (!canvas) return;
184: 
185:         if (!todayData || !todayData.data || todayData.data.length === 0) {
186:             const ctx = canvas.getContext('2d');
187:             if (ctx) {
188:                 ctx.clearRect(0, 0, 800, 400);
189:                 ctx.font = "16px Arial";
190:                 ctx.fillStyle = "#aaa";
191:                 ctx.fillText("Немає даних для побудови графіка.", 20, 50);
192:             }
193:             return;
194:         }
195: 
196:         const loaded = await this.loadChartJs();
197:         if (!loaded || typeof Chart === 'undefined') {
198:             console.warn("[SYH] Chart.js недоступний.");
199:             return;
200:         }
201: 
202:         const ctx = canvas.getContext('2d');
203:         const labels = todayData.data.map(item => item.time);
204:         const datasets = [{
205:             label: 'Глядачі',
206:             data: todayData.data.map(item => item.viewers),
207:             borderColor: '#3498db',
208:             backgroundColor: 'rgba(52, 152, 219, 0.2)',
209:             fill: true,
210:             tension: 0.3
211:         }];
212:         
213:         // Малювання ліній вертикальних фаз
214:         const plugins: any[] = [];
215:         const createLine = (label: string, value: string, color: string) => ({
216:             id: label,
217:             beforeDraw: (chart: any) => {
218:                 const index = labels.indexOf(value);
219:                 if (index === -1) return;
220:                 const xAxis = chart.scales.x;
221:                 const yAxis = chart.scales.y;
222:                 const x = xAxis.getPixelForTick(index);
223:                 const ctxCanvas = chart.ctx;
224:                 ctxCanvas.save();
225:                 ctxCanvas.beginPath();
226:                 ctxCanvas.moveTo(x, yAxis.top);
227:                 ctxCanvas.lineTo(x, yAxis.bottom);
228:                 ctxCanvas.lineWidth = 2;
229:                 ctxCanvas.strokeStyle = color;
230:                 ctxCanvas.stroke();
231:                 ctxCanvas.fillStyle = color;
232:                 ctxCanvas.fillText(label, x + 5, yAxis.top + 15);
233:                 ctxCanvas.restore();
234:             }
235:         });
236: 
237:         if (todayData.phase_questions_start) plugins.push(createLine('Питання', todayData.phase_questions_start, '#f39c12'));
238:         if (todayData.phase_prayers_start) plugins.push(createLine('Молитви', todayData.phase_prayers_start, '#28a745'));
239: 
240:         this.chartInstance = new Chart(ctx, {
241:             data: { labels: labels, datasets: datasets },
242:             options: {
243:                 responsive: true,
244:                 maintainAspectRatio: false,
245:                 interaction: { mode: 'index', intersect: false },
246:                 scales: {
247:                     x: { ticks: { color: '#ccc' } },
248:                     y: { type: 'linear', display: true, position: 'left', ticks: { color: '#ccc' } }

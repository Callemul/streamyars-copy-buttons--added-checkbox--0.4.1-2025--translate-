<file path="youtube/yt_ui.ts">
  1: // youtube/yt_ui.ts
  2: import { YT_SELECTORS } from './yt_selectors.ts';
  3: 
  4: export interface CommentData {
  5:     id: string;
  6:     author: string;
  7:     text: string;
  8:     videoId: string;
  9: }
 10: 
 11: /**
 12:  * Витягує ID коментаря з URL посилання (параметр lc=) або з DOM
 13:  */
 14: export function extractCommentId(commentNode: Element): string {
 15:     if (!commentNode) return '';
 16: 
 17:     // 1. Пошук посилання з параметром lc=
 18:     const linkEl = commentNode.querySelector(YT_SELECTORS.commentLink) || 
 19:                    commentNode.querySelector('a[href*="lc="]');
 20:     if (linkEl) {
 21:         const href = linkEl.getAttribute('href') || '';
 22:         const match = href.match(/lc=([^&]+)/);
 23:         if (match && match[1]) {
 24:             return match[1];
 25:         }
 26:     }
 27: 
 28:     // 2. Фолбек на ID вузла
 29:     if (commentNode.id) {
 30:         return commentNode.id;
 31:     }
 32: 
 33:     // 3. Фолбек за атрибутами
 34:     const dataCid = commentNode.getAttribute('data-cid') || commentNode.getAttribute('id');
 35:     if (dataCid) return dataCid;
 36: 
 37:     // 4. Фолбек по автору та початку тексту
 38:     const authorEl = commentNode.querySelector(YT_SELECTORS.commentAuthor);
 39:     const textEl = commentNode.querySelector(YT_SELECTORS.commentText);
 40:     const author = authorEl?.textContent?.trim() || 'unknown';
 41:     const textSnippet = textEl?.textContent?.trim().slice(0, 20) || 'empty';
 42:     
 43:     // Простий хеш для стабільності
 44:     let hash = 0;
 45:     const str = `${author}_${textSnippet}`;
 46:     for (let i = 0; i < str.length; i++) {
 47:         hash = ((hash << 5) - hash) + str.charCodeAt(i);
 48:         hash |= 0;
 49:     }
 50:     return `yt_${Math.abs(hash)}`;
 51: }
 52: 
 53: /**
 54:  * Отримує автора та текст коментаря
 55:  */
 56: export function extractCommentData(commentNode: Element): { author: string; text: string } {
 57:     const authorEl = commentNode.querySelector(YT_SELECTORS.commentAuthor) || 
 58:                      commentNode.querySelector('#author-text');
 59:     const textEl = commentNode.querySelector(YT_SELECTORS.commentText);
 60: 
 61:     const author = authorEl?.textContent?.trim().replace(/^@/, '') || 'Автор';
 62:     const originalText = textEl?.getAttribute('data-syh-original-text');
 63:     const text = (originalText !== null && originalText !== undefined) 
 64:         ? originalText.trim() 
 65:         : (textEl?.textContent?.trim() || '');
 66: 
 67:     return { author, text };
 68: }
 69: 
 70: /**
 71:  * Додає кнопки "Додати до питань", "Додати до молитов", 📄 та чекбокс до коментаря YouTube
 72:  */
 73: export function addButtonsToYTComment(commentNode: Element): HTMLElement | null {
 74:     if (!commentNode || commentNode.querySelector('.syh-yt-buttons')) {
 75:         return null;
 76:     }
 77: 
 78:     const headerAuthor = commentNode.querySelector(YT_SELECTORS.headerAuthor);
 79:     if (!headerAuthor) return null;
 80: 
 81:     const container = document.createElement('div');
 82:     container.className = 'syh-yt-buttons';
 83: 
 84:     // Кнопка "Додати до питань"
 85:     const btnQuestion = document.createElement('button');
 86:     btnQuestion.type = 'button';
 87:     btnQuestion.className = 'syh-yt-btn syh-yt-btn-question';
 88:     btnQuestion.innerText = 'Додати до питань';
 89: 
 90:     // Кнопка "Додати до молитов"
 91:     const btnPrayer = document.createElement('button');
 92:     btnPrayer.type = 'button';
 93:     btnPrayer.className = 'syh-yt-btn syh-yt-btn-prayer';
 94:     btnPrayer.innerText = 'Додати до молитов';
 95: 
 96:     // Плаваюча кнопка копіювання 📄
 97:     const btnCopy = document.createElement('button');
 98:     btnCopy.type = 'button';
 99:     btnCopy.className = 'syh-yt-btn-copy';
100:     btnCopy.title = 'Копіювати текст коментаря (@автор\\n\\nтекст)';
101:     btnCopy.innerText = '📄';
102: 
103:     // Чекбокс
104:     const checkboxWrap = document.createElement('label');
105:     checkboxWrap.className = 'syh-yt-checkbox-wrap';
106:     checkboxWrap.title = 'Прочитано / Не прочитано';
107: 
108:     const checkbox = document.createElement('input');
109:     checkbox.type = 'checkbox';
110:     checkbox.className = 'syh-yt-checkbox';
111: 
112:     checkboxWrap.appendChild(checkbox);
113: 
114:     container.appendChild(btnQuestion);
115:     container.appendChild(btnPrayer);
116:     container.appendChild(btnCopy);
117:     container.appendChild(checkboxWrap);
118: 
119:     headerAuthor.appendChild(container);
120: 
121:     // Додаємо клас user-select: none до тіла коментаря для ПКМ
122:     const bodyEl = commentNode.querySelector(YT_SELECTORS.commentBody);
123:     if (bodyEl) {

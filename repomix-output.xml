 99:     private saveSettings(): void {
100:         const sschoolVal = (document.getElementById('optSschoolName') as HTMLInputElement)?.value.trim() || DEFAULT_OPTIONS.newTitleSS;
101:         const preachVal = (document.getElementById('optPreachName') as HTMLInputElement)?.value.trim() || DEFAULT_OPTIONS.newTitlePreach;
102:         const langVal = (document.getElementById('optLanguage') as HTMLSelectElement)?.value || DEFAULT_OPTIONS.ui_locale;
103:         const antiAfkVal = (document.getElementById('optAntiAfkEnabled') as HTMLInputElement)?.checked;
104:         const antiAfkIntervalVal = parseInt((document.getElementById('optAntiAfkInterval') as HTMLInputElement)?.value || '30', 10);
105:         const autoHealVal = (document.getElementById('optAutoHealEnabled') as HTMLInputElement)?.checked;
106:         const truncVal = parseInt((document.getElementById('optTruncationLength') as HTMLInputElement)?.value || '195', 10);
107:         const showCopyVal = (document.getElementById('optShowCopyButtons') as HTMLInputElement)?.checked;
108: 
109:         SYH_STORAGE.get(['db'], (result) => {
110:             const currentDb = result.db || {};
111:             currentDb.newTitleSS = sschoolVal;
112:             currentDb.newTitlePreach = preachVal;
113: 
114:             const newOptions: OptionsState = {
115:                 newTitleSS: sschoolVal,
116:                 newTitlePreach: preachVal,
117:                 ui_locale: langVal,
118:                 anti_afk_enabled: antiAfkVal,
119:                 anti_afk_interval_sec: antiAfkIntervalVal,
120:                 auto_heal_enabled: autoHealVal,
121:                 text_truncation_length: truncVal,
122:                 show_copy_buttons: showCopyVal
123:             };
124: 
125:             SYH_STORAGE.set({
126:                 'db': currentDb,
127:                 'syh_options': newOptions
128:             }, () => {
129:                 this.showToast('✅ Налаштування успішно збережено!');
130:             });
131:         });
132:     }
133: 
134:     private exportConfig(): void {
135:         SYH_STORAGE.get(['db', 'syh_options'], (result) => {
136:             const exportData = {
137:                 timestamp: new Date().toISOString(),
138:                 version: '1.0.0',
139:                 db: result.db || {},
140:                 syh_options: result.syh_options || DEFAULT_OPTIONS
141:             };
142:             const jsonStr = JSON.stringify(exportData, null, 2);
143:             const blob = new Blob([jsonStr], { type: 'application/json' });
144:             const url = URL.createObjectURL(blob);
145: 
146:             const a = document.createElement('a');
147:             a.href = url;
148:             a.download = `streamyard_helper_config_${new Date().toISOString().slice(0, 10)}.json`;
149:             a.click();
150:             URL.revokeObjectURL(url);
151: 
152:             this.showToast('📥 Конфігурацію успішно експортовано');
153:         });
154:     }
155: 
156:     private importConfig(event: Event): void {
157:         const input = event.target as HTMLInputElement;
158:         if (!input.files || input.files.length === 0) return;
159: 
160:         const file = input.files[0];
161:         const reader = new FileReader();
162:         reader.onload = (e) => {
163:             try {
164:                 const imported = JSON.parse(e.target?.result as string);
165:                 if (imported && (imported.db || imported.syh_options)) {
166:                     SYH_STORAGE.set({
167:                         'db': imported.db || {},
168:                         'syh_options': imported.syh_options || DEFAULT_OPTIONS
169:                     }, () => {
170:                         this.loadSettings();
171:                         this.showToast('📤 Конфігурацію успішно імпортовано!');
172:                     });
173:                 } else {
174:                     alert('Некоректний формат файлу конфігурації.');
175:                 }
176:             } catch (err) {
177:                 alert('Помилка при зчитуванні JSON файлу.');
178:             }
179:         };
180:         reader.readAsText(file);
181:     }
182: 
183:     private resetDefaults(): void {
184:         if (confirm('Ви впевнені, що хочете скинути всі налаштування до стандартних?')) {
185:             SYH_STORAGE.set({
186:                 'db': { newTitleSS: DEFAULT_OPTIONS.newTitleSS, newTitlePreach: DEFAULT_OPTIONS.newTitlePreach },
187:                 'syh_options': DEFAULT_OPTIONS
188:             }, () => {
189:                 this.loadSettings();
190:                 this.showToast('⚠️ Налаштування скинуто до початкових!');
191:             });
192:         }
193:     }
194: 
195:     private showToast(msg: string): void {
196:         const toast = document.getElementById('toastNotification');
197:         if (!toast) return;
198:         toast.textContent = msg;
199:         toast.classList.add('show');
200: 
201:         if (this.toastTimer) clearTimeout(this.toastTimer);
202:         this.toastTimer = setTimeout(() => {
203:             toast.classList.remove('show');
204:         }, 3000);
205:     }
206: }
207: 
208: document.addEventListener('DOMContentLoaded', () => {
209:     new OptionsController();
210: });

<file path="modules/parsers.ts">
  1: import { SYH_CONFIG } from './config.ts';
  2: 
  3: export interface GroupedQuestion {
  4:     number: string;
  5:     author: string;
  6:     textLines: string[];
  7: }
  8: 
  9: export interface SyhParsers {
 10:     parseEmojiNumberedQuestions(rawText: string): string[];
 11:     parseStandardNumberedQuestions(rawText: string): string[];
 12:     parseSabbathSchoolUnnumberedQuestions(rawText: string): string[];
 13: }
 14: 
 15: export const SYH_PARSERS: SyhParsers = {
 16:     /**
 17:      * Парсер для формату з emoji-цифрами, що підтримує підпункти '🔹'.
 18:      */
 19:     parseEmojiNumberedQuestions: function(rawText: string): string[] {
 20:         console.log("Parsing as Emoji-numbered questions with sub-item support.");
 21:         const MAX_LENGTH = (SYH_CONFIG && SYH_CONFIG.LIMITS && SYH_CONFIG.LIMITS.TEXT_TRUNCATION_LENGTH) || 
 22:                            (typeof window !== 'undefined' && (window as any).SYH_CONFIG && (window as any).SYH_CONFIG.LIMITS && (window as any).SYH_CONFIG.LIMITS.TEXT_TRUNCATION_LENGTH) || 195;
 23:         const ELLIPSIS = "...";
 24: 
 25:         const truncate = (text: string): string => {
 26:             if (text.length > MAX_LENGTH) {
 27:                 return text.substring(0, MAX_LENGTH - ELLIPSIS.length) + ELLIPSIS;
 28:             }
 29:             return text;
 30:         };
 31: 
 32:         const groupedQuestions: GroupedQuestion[] = [];
 33:         let currentQuestion: GroupedQuestion | null = null;
 34:         const lines = rawText.split('\n').map(l => l.trim());
 35: 
 36:         for (const line of lines) {
 37:             // Оновлена регулярка: підтримує всі варіанти цифр у квадратиках
 38:             if (/^(?:\d+\uFE0F?\u20E3|🔟)+\s*$/.test(line)) {
 39:                 if (currentQuestion) groupedQuestions.push(currentQuestion);
 40:                 currentQuestion = { number: line, author: '', textLines: [] };
 41:             } else if (currentQuestion && !currentQuestion.author && line) {
 42:                 currentQuestion.author = line;
 43:             } else if (currentQuestion && line) {
 44:                 currentQuestion.textLines.push(line);
 45:             }
 46:         }
 47:         if (currentQuestion) groupedQuestions.push(currentQuestion);
 48: 
 49:         const finalBanners: string[] = [];
 50:         for (const group of groupedQuestions) {
 51:             const fullText = group.textLines.join('\n');
 52:             const subQuestions = fullText.split(/\n?(?=🔹)/);
 53: 
 54:             if (subQuestions.length <= 1) {
 55:                 const bannerText = `${group.number}\n${group.author}: \n${fullText}`;
 56:                 finalBanners.push(truncate(bannerText));
 57:             } else {
 58:                 if (subQuestions[0].trim()) {
 59:                     const firstBannerText = `${group.number}\n${group.author}: \n${subQuestions[0]}`;
 60:                     finalBanners.push(truncate(firstBannerText));
 61:                 }
 62:                 for (let i = 1; i < subQuestions.length; i++) {
 63:                     const subText = subQuestions[i].trim();
 64:                     if (!subText) continue;
 65:                     const subLines = subText.split('\n');
 66:                     const newHeader = subLines.shift();
 67:                     const newBody = subLines.join('\n');
 68:                     const subsequentBannerText = `${newHeader}: \n${newBody}`;
 69:                     finalBanners.push(truncate(subsequentBannerText));
 70:                 }
 71:             }
 72:         }
 73:         return finalBanners;
 74:     },
 75: 
 76:     /**
 77:      * Парсер для старого формату: "1. Текст питання (Автор)"
 78:      */
 79:     parseStandardNumberedQuestions: function(rawText: string): string[] {
 80:         console.log("Parsing as Standard-numbered questions.");
 81:         const formattedText = rawText.replace(/(?:^|\s)(\d+\.)/g, '\n$1');
 82:         const maxLen = (typeof SYH_CONFIG !== 'undefined' && SYH_CONFIG && SYH_CONFIG.LIMITS && SYH_CONFIG.LIMITS.TEXT_TRUNCATION_LENGTH) || 
 83:                        (typeof window !== 'undefined' && (window as any).SYH_CONFIG && (window as any).SYH_CONFIG.LIMITS && (window as any).SYH_CONFIG.LIMITS.TEXT_TRUNCATION_LENGTH) || 195;
 84: 
 85:         return formattedText.split('\n')
 86:             .map(line => line.trim())
 87:             .filter(line => /^\d+\./.test(line))
 88:             .map(line => line.replace(/^\d+[.)]?\s*/, '').replace(/\s*\([^)]+\)$/, '').trim())
 89:             .filter(line => line.length > 0)
 90:             .map(line => {
 91:                 if (line.length >= 200) {
 92:                     return line.substring(0, maxLen) + "...";
 93:                 }
 94:                 return line;
 95:             });
 96:     },
 97: 
 98:     parseSabbathSchoolUnnumberedQuestions: function(rawText: string): string[] {
 99:         console.log("Parsing as Sabbath School Unnumbered questions.");
100:         const lines = rawText.split('\n').map(l => l.trim()).filter(Boolean);
101:         const maxLen = (SYH_CONFIG && SYH_CONFIG.LIMITS && SYH_CONFIG.LIMITS.TEXT_TRUNCATION_LENGTH) || 
102:                        (typeof window !== 'undefined' && (window as any).SYH_CONFIG && (window as any).SYH_CONFIG.LIMITS && (window as any).SYH_CONFIG.LIMITS.TEXT_TRUNCATION_LENGTH) || 195;
103:         
104:         // Знаходимо перший рядок з ключовими словами
105:         const startIndex = lines.findIndex(l => /памятн|пам'ятн|молчанов|опарин|опарін|молчанів/i.test(l));
106:         if (startIndex === -1) return [];
107:         
108:         // Ігноруємо заголовок (все перед startIndex)
109:         const questionLines = lines.slice(startIndex);
110:         
111:         // Помилка якщо більше 10 питань
112:         if (questionLines.length > 10) {
113:             throw new Error("Помилка: Кількість питань перевищує ліміт (максимум 10)!");
114:         }
115:         
116:         return questionLines.map(line => {
117:             const cleanLine = line.replace(/\s*\([^)]+\)$/, '').trim();
118:             return cleanLine.length >= 200 ? cleanLine.substring(0, maxLen) + "..." : cleanLine;
119:         });
120:     }
121: };
122: 
123: if (typeof window !== 'undefined') {
124:     (window as any).SYH_PARSERS = SYH_PARSERS;
125: }
</file>


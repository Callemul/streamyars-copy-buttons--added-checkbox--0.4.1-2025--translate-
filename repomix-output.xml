191: window.processTelegramData = function() {
192:     const oldListText = $('#oldList').val();
193:     const answeredInput = $('#answeredIds').val();
194:     const telegramText = $('#newTelegram').val();
195:     const answeredIds = answeredInput.split(',').map(s => parseFloat(s.trim())).filter(n => !isNaN(n));
196:     let preservedData = window.parseAndFilterOldList(oldListText, answeredIds);
197:     
198:     let newQuestions;
199:     let newPrayers = [];
200:     if (/❓❓❓|🙏+|(?:\d+\uFE0F?\u20E3|🔟)/iu.test(telegramText)) {
201:         let parsedNew = window.parseAndFilterOldList(telegramText, []);
202:         newQuestions = parsedNew.questions.map(q => ({ ...q, source: 'new' }));
203:         newPrayers = parsedNew.prayers.map(p => ({ ...p, source: 'pray' }));
204:     } else {
205:         newQuestions = window.parseTelegramExportLineByLine(telegramText);
206:     }
207:     
208:     const combinedQuestions = [...preservedData.questions, ...newQuestions];
209:     const combinedPrayers = [...preservedData.prayers, ...newPrayers];
210:     
211:     let oldPeople = preservedData.questions.length;
212:     let oldQuestionsTotal = 0;
213:     preservedData.questions.forEach(q => oldQuestionsTotal += window.countQuestionsInText(q.text));
214:     
215:     let newPeople = newQuestions.length;
216:     let newQuestionsTotal = 0;
217:     newQuestions.forEach(q => newQuestionsTotal += window.countQuestionsInText(q.text));
218:     
219:     let newPrayersTotal = newPrayers.length;
220:     
221:     let delPeople = 0;
222:     let delQuestionsTotal = 0;
223:     preservedData.deleted.forEach(d => {
224:         if (d.type === 'block') { delPeople++; delQuestionsTotal += d.count; } 
225:         else if (d.type === 'sub') { delQuestionsTotal += d.count; }
226:     });
227:     
228:     let totalPeople = oldPeople + newPeople;
229:     let totalQuestions = oldQuestionsTotal + newQuestionsTotal;
230:     let totalPrayers = combinedPrayers.length;
231:     
232:     $('.stat-item.old').html(`Залишилось старих: <b>${oldPeople} люд. - ${oldQuestionsTotal} пит.</b>`);
233:     $('#countDel').text(`${delPeople} люд. - ${delQuestionsTotal} пит.`);
234:     
235:     let newText = `${newPeople} люд. - ${newQuestionsTotal} пит.`;
236:     if (newPrayersTotal > 0) newText += ` | Молитви: ${newPrayersTotal}`;
237:     $('#countNew').html(newText);
238:     
239:     let totalText = `${totalPeople} люд. - ${totalQuestions} пит.`;
240:     if (totalPrayers > 0) totalText += ` | Молитви: ${totalPrayers}`;
241:     $('#countTotal').text(totalText);
242:     
243:     $('#statsBar').show();
244:     
245:     const outputDiv = $('#finalResultDiv');
246:     outputDiv.empty();
247:     let fullText = "❓❓❓ВОПРОСЫ 🔹\n";
248:     combinedQuestions.forEach((item, index) => {
249:         const emojiNum = window.numberToEmoji(index + 1);
250:         const textBlock = `${emojiNum}\n${item.author}\n${item.text}\n\n`;
251:         fullText += textBlock;
252:         const block = $('<div>').addClass('q-block').addClass(`q-${item.source}`);
253:         block.text(textBlock);
254:         outputDiv.append(block);
255:     });
256:     if (combinedPrayers.length > 0) {
257:         fullText += "\n\n🙏🙏🙏МОЛИТВЫ\n";
258:         const header = $('<div>').text("\n\n🙏🙏🙏МОЛИТВЫ\n");
259:         outputDiv.append(header);
260:         combinedPrayers.forEach((item, index) => {
261:             const emojiNum = window.numberToEmoji(index + 1);
262:             const textBlock = `${emojiNum}\n${item.author}\n${item.text}\n\n`;
263:             fullText += textBlock;
264:             const block = $('<div>').addClass('q-block').addClass('q-pray');
265:             block.text(textBlock);
266:             outputDiv.append(block);
267:         });
268:     }
269:     const deletedLog = $('#deletedLog');
270:     deletedLog.empty();
271:     if (preservedData.deleted.length > 0) {
272:         preservedData.deleted.forEach(d => {
273:             let msg = `№${d.originalId} (${d.author}): `;
274:             if (d.type === 'block') msg += `Видалено повністю (${d.count} пит.)`;
275:             else msg += `Видалено підпункт`;
276:             deletedLog.append($('<div>').addClass('del-row').text(msg));
277:         });
278:         $('#deletedLogDetails').show();
279:     } else {
280:         $('#deletedLogDetails').hide();
281:     }
282: };

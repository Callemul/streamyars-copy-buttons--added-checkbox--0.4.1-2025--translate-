 24: 
 25:     init: function(config: { SELECTORS: Record<string, string> }): void {
 26:         this.SELECTORS = config ? config.SELECTORS : null;
 27:     },
 28: 
 29:     // Посилання на централізований адаптер сховища
 30:     get storage(): any {

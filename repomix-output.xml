369:                 <td>📖 Субботняя школа</td>
370:                 <td class="accent">${st1.avg ?? '-'}</td>
371:                 <td>${st1.max ?? '-'}</td>
372:                 <td>${st1.median ?? '-'}</td>
373:             </tr>

190:     markPhase: function(phase: 'questions' | 'prayers', btnElement: HTMLElement): void {
191:         const timerWrapper = document.querySelector('div[class*="Timer__TimerWrapper"]') as HTMLElement | null;
192:         if (!timerWrapper) {
193:             alert("Ефір ще не розпочався (немає таймера)!");
194:             return;
195:         }
196:         
197:         const timerText = timerWrapper.innerText.replace(/\n/g, '').trim();
198:         const today = (window as any).SYH_UTILS && typeof (window as any).SYH_UTILS.getTodayDateString === 'function'
199:             ? (window as any).SYH_UTILS.getTodayDateString()
200:             : new Date().toLocaleDateString('sv-SE');
201:         const self = this;
202: 
203:         const storage = SYH_STORAGE || ((window as any).SYH_UTILS && (window as any).SYH_UTILS.storage ? (window as any).SYH_UTILS.storage : null);
204:         if (storage) {
205:             storage.get(['syh_stream_charts'], function(result: any) {
206:                 let db = (result && result.syh_stream_charts) ? result.syh_stream_charts : {};
207:                 if (!db[self.currentBrand]) db[self.currentBrand] = {};
208:                 if (!db[self.currentBrand][today]) db[self.currentBrand][today] = { data: [] };
209: 
210:                 if (phase === 'questions') {
211:                     db[self.currentBrand][today].phase_questions_start = timerText;
212:                     btnElement.innerText = '✅ Питання';
213:                 } else if (phase === 'prayers') {
214:                     db[self.currentBrand][today].phase_prayers_start = timerText;
215:                     btnElement.innerText = '✅ Молитви';
216:                 }
217:                 btnElement.style.opacity = '0.7';
218: 
219:                 storage.set({ 'syh_stream_charts': db });
220:             });
221:         }
222:     },

  7: // Створюємо мок сховища SYH_STORAGE
  8: let mockStorageStore = {};
  9: 
 10: const mockStorageAdapter = {
 11:     get: function(keys, callback) {
 12:         const result = {};
 13:         const keyList = Array.isArray(keys) ? keys : [keys];
 14:         for (const k of keyList) {
 15:             if (k in mockStorageStore) {
 16:                 result[k] = JSON.parse(JSON.stringify(mockStorageStore[k]));
 17:             }
 18:         }
 19:         if (callback) callback(result);
 20:         return Promise.resolve(result);
 21:     },
 22:     set: function(obj, callback) {
 23:         for (const k in obj) {
 24:             mockStorageStore[k] = JSON.parse(JSON.stringify(obj[k]));
 25:         }
 26:         if (callback) callback();
 27:         return Promise.resolve();
 28:     },
 29:     remove: function(keys, callback) {
 30:         const keyList = Array.isArray(keys) ? keys : [keys];
 31:         for (const k of keyList) {
 32:             delete mockStorageStore[k];
 33:         }
 34:         if (callback) callback();
 35:         return Promise.resolve();
 36:     }
 37: };
 38: 
 39: global.chrome = {
 40:     runtime: { id: 'test-extension-id' },
 41:     storage: {
 42:         local: {
 43:             get: (keys, cb) => mockStorageAdapter.get(keys, cb),
 44:             set: (items, cb) => mockStorageAdapter.set(items, cb),
 45:             remove: (keys, cb) => mockStorageAdapter.remove(keys, cb)
 46:         }
 47:     }
 48: };
 49: 
 50: global.SYH_STORAGE = mockStorageAdapter;
 51: global.window.SYH_STORAGE = mockStorageAdapter;

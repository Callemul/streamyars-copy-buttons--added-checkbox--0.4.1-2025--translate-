171:         this.log("Перевірка на чистоту старту...");
172:         const form = this.SELECTORS?.createBannerForm ? document.querySelector(this.SELECTORS.createBannerForm) : null;
173:         
174:         if (form) {
175:             this.log("Форма була відкрита. Закриваю...");
176:             this.clickCancelButton(form);
177:             await new Promise(r => setTimeout(r, 300));
178:         }
179:     },
180: 
181:     finalCleanup: async function(): Promise<void> {
182:         const form = this.SELECTORS?.createBannerForm ? document.querySelector(this.SELECTORS.createBannerForm) : null;
183:         if (form) {
184:             this.log("Прибирання: Закриваю форму...");
185:             this.clickCancelButton(form);
186:         }
187:     },
188: 
189:     createSingleBanner: function(text: string): Promise<void> {
190:         return new Promise((resolve, reject) => {
191:             (async () => {
192:                 try {
193:                     let createBtn: HTMLElement | null = this.SELECTORS?.createBannerButton ? document.querySelector(this.SELECTORS.createBannerButton) : null;
194:                     if (!createBtn) {
195:                         createBtn = await this.UTILS.waitForElement(this.SELECTORS?.createBannerButton, 2000);
196:                     }
197:                     if (!createBtn) {
198:                         throw new Error("Create banner button not found");
199:                     }
200:                     createBtn.click();
201:                     
202:                     const form: Element | null = await this.UTILS.waitForElement(this.SELECTORS?.createBannerForm, 2000);
203:                     if (!form) {
204:                         throw new Error("Create banner form not found");
205:                     }
206:                     const textarea = form.querySelector('textarea') as HTMLTextAreaElement | null;
207:                     const addButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
208:                     
209:                     if (!textarea || !addButton) {
210:                         throw new Error("Textarea or submit button not found in form");
211:                     }
212: 
213:                     textarea.focus();
214:                     textarea.value = text;
215:                     textarea.dispatchEvent(new Event('input', { bubbles: true }));
216:                     textarea.blur(); 
217:                     
218:                     const waitTime = text.length > 50 ? 300 : 150;
219:                     await new Promise(r => setTimeout(r, waitTime));
220: 
221:                     if (addButton.disabled) await new Promise(r => setTimeout(r, 200));
222:                     addButton.click();
223:                     
224:                     await this.UTILS.waitForNewBanner(text, 5000);
225:                     
226:                     if (this.SELECTORS?.createBannerForm && document.querySelector(this.SELECTORS.createBannerForm)) {
227:                         this.clickCancelButton(form);
228:                     }
229: 
230:                     resolve();
231:                 } catch (error) {
232:                     reject(error);
233:                 }
234:             })();
235:         });
236:     }
237: };
238: 

 10: export interface SyhState {
 11:     itemStates: Record<string, boolean>;
 12:     lastDate: string | null;
 13:     onStateLoaded: ((states: Record<string, boolean>) => void) | null;
 14:     _saveTimer: ReturnType<typeof setTimeout> | null;
 15: 
 16:     init(callback?: () => void): void;
 17:     updateState(key: string, isChecked: boolean, delayMs?: number): void;
 18:     getState(key: string): boolean;
 19:     saveState(delayMs?: number): void;
 20:     saveStateImmediate(): void;
 21: }

142:     // Легкий парсер Markdown в HTML
143:     parseMarkdown: function(md: string): string {
144:         if (!md) return '';
145:         
146:         // 1. Спочатку екрануємо теги HTML для безпеки
147:         let html = md.replace(/&/g, "&amp;")
148:                      .replace(/</g, "&lt;")
149:                      .replace(/>/g, "&gt;");
150: 
151:         // 2. Витягуємо блоки коду, щоб вони не оброблялися покроково
152:         const codeBlocks: CodeBlockPlaceholder[] = [];
153:         html = html.replace(/```([\s\S]*?)```/g, (_match, code) => {
154:             const placeholder = `__CODE_BLOCK_${codeBlocks.length}__`;
155:             
156:             // Підсвічуємо спеціальні анотації (піде в "...") в блоках коду у вигляді стильних бейджів
157:             let highlighted = code.trim();
158:             highlighted = highlighted.replace(/\((піде в "Глядачі")\)/g, '<span style="color: #38BDF8; font-weight: bold; background: rgba(56, 189, 248, 0.1); padding: 2px 6px; border-radius: 4px; border: 1px solid rgba(56, 189, 248, 0.25); font-size: 11px; margin-left: 8px; display: inline-block; white-space: nowrap;">$1</span>');
159:             highlighted = highlighted.replace(/\((піде в "Молитви")\)/g, '<span style="color: #34D399; font-weight: bold; background: rgba(52, 211, 153, 0.1); padding: 2px 6px; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.25); font-size: 11px; margin-left: 8px; display: inline-block; white-space: nowrap;">$1</span>');
160:             highlighted = highlighted.replace(/\((піде в "Ефір")\)/g, '<span style="color: #FB923C; font-weight: bold; background: rgba(251, 146, 60, 0.1); padding: 2px 6px; border-radius: 4px; border: 1px solid rgba(251, 146, 60, 0.25); font-size: 11px; margin-left: 8px; display: inline-block; white-space: nowrap;">$1</span>');
161: 
162:             codeBlocks.push({
163:                 code: highlighted,
164:                 marginLeft: '0px'
165:             });
166:             return placeholder;
167:         });
168: 
169:         // 3. Заголовки (H1, H2, H3)
170:         html = html.replace(/^# (.*$)/gim, '<h1 style="margin-top: 10px; margin-bottom: 15px; color: #fff; font-size: 20px; font-weight: bold; border-bottom: 2px solid #005DF7; padding-bottom: 8px;">$1</h1>');
171:         html = html.replace(/^## (.*$)/gim, '<h2 style="margin-top: 20px; margin-bottom: 10px; color: #005DF7; font-size: 16px; font-weight: 600; border-bottom: 1px solid #2A303C; padding-bottom: 5px;">$1</h2>');
172:         html = html.replace(/^### (.*$)/gim, '<h3 style="margin-top: 15px; margin-bottom: 8px; color: #ffcc00; font-size: 14px; font-weight: 600;">$1</h3>');
173:         
174:         // Жирний шрифт: **текст**
175:         html = html.replace(/\*\*(.*?)\*\*/g, '<strong style="color: #fff; font-weight: bold;">$1</strong>');
176:         // Курсив: *текст*
177:         html = html.replace(/\*(.*?)\*/g, '<em style="color: #ddd;">$1</em>');
178:         
179:         // 4. Списки та параграфи
180:         const lines = html.split('\n');
181:         const processedLines: string[] = [];
182:         let listStack: number[] = []; // Стек для відстеження рівнів вкладеності списків
183:         
184:         for (let line of lines) {
185:             let trimmed = line.trim();
186:             const listMatch = line.match(/^(\s*)([-*])\s+(.*)$/);
187:             
188:             if (listMatch) {
189:                 const indent = listMatch[1].length;
190:                 const content = listMatch[3];
191:                 
192:                 // Закриваємо глибші списки, якщо відступ зменшився
193:                 while (listStack.length > 0 && listStack[listStack.length - 1] > indent) {
194:                     processedLines.push('</ul>');
195:                     listStack.pop();
196:                 }
197:                 
198:                 // Відкриваємо новий вкладений список, якщо відступ більший або це перший список
199:                 if (listStack.length === 0 || listStack[listStack.length - 1] < indent) {
200:                     const listStyle = listStack.length === 0 ? 'disc' : 'circle';
201:                     processedLines.push(`<ul style="margin-left: 20px; margin-bottom: 15px; padding-left: 0; list-style-type: ${listStyle};">`);
202:                     listStack.push(indent);
203:                 }
204:                 
205:                 processedLines.push(`<li style="margin-bottom: 8px; line-height: 1.5; color: #cbd5e1; font-size: 13px;">${content}</li>`);
206:             } else {
207:                 const isCodeBlockPlaceholder = trimmed.startsWith('__CODE_BLOCK_');
208:                 
209:                 // Закриваємо всі списки для інших елементів (заголовки, параграфи тощо)
210:                 while (listStack.length > 0) {
211:                     processedLines.push('</ul>');
212:                     listStack.pop();
213:                 }
214:                 
215:                 if (trimmed === '') {
216:                     processedLines.push('<div style="height: 8px;"></div>');
217:                 } else if (isCodeBlockPlaceholder) {
218:                     // Визначаємо відступ для коду на основі оригінальних пробілів у md
219:                     const indentMatch = line.match(/^(\s*)/);
220:                     const spaces = indentMatch ? indentMatch[1].length : 0;
221:                     
222:                     const idxMatch = trimmed.match(/\d+/);
223:                     const idx = idxMatch ? parseInt(idxMatch[0], 10) : 0;
224:                     // Розраховуємо margin-left на основі кількості пробілів відступу
225:                     const marginLeft = spaces > 0 ? `${spaces * 8}px` : '0px';
226:                     
227:                     if (codeBlocks[idx]) {
228:                         codeBlocks[idx].marginLeft = marginLeft;
229:                     }
230:                     processedLines.push(trimmed);
231:                 } else if (!trimmed.startsWith('<h') && !trimmed.startsWith('<ul') && !trimmed.startsWith('<li') && !trimmed.startsWith('</ul') && !trimmed.startsWith('<div')) {
232:                     processedLines.push(`<p style="margin-bottom: 12px; line-height: 1.5; color: #cbd5e1; font-size: 13px;">${line}</p>`);
233:                 } else {
234:                     processedLines.push(line);
235:                 }
236:             }
237:         }
238:         
239:         while (listStack.length > 0) {
240:             processedLines.push('</ul>');
241:             listStack.pop();
242:         }
243:         
244:         let resultHtml = processedLines.join('\n');
245: 
246:         // 5. Повертаємо блоки коду назад з накладенням стилів рамки та відступів
247:         codeBlocks.forEach((blockObj, idx) => {
248:             const ml = blockObj.marginLeft || '0px';
249:             const blockHtml = `<pre style="margin: 10px 0; margin-left: ${ml}; padding: 12px; background: #0F172A; border: 1px solid #334155; border-radius: 8px; color: #cbd5e1; font-family: monospace; font-size: 12px; line-height: 1.5; white-space: pre-wrap; word-break: break-all; box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);">${blockObj.code}</pre>`;
250:             resultHtml = resultHtml.replace(`__CODE_BLOCK_${idx}__`, blockHtml);
251:         });
252: 
253:         return resultHtml;
254:     }
255: };
256: 
257: if (typeof window !== 'undefined') {
258:     (window as any).SYH_INFO_MODAL = SYH_INFO_MODAL;
259: }

 54:     private initEvents(): void {
 55:         const saveBtn = document.getElementById('saveTopBtn');
 56:         if (saveBtn) saveBtn.addEventListener('click', () => this.saveSettings());
 57: 
 58:         const exportBtn = document.getElementById('exportConfigBtn');

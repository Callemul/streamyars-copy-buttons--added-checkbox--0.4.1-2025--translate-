 26: class OptionsController {
 27:     private toastTimer: any = null;
 28: 
 29:     constructor() {
 30:         this.initNavigation();
 31:         this.initEvents();
 32:         this.loadSettings();
 33:     }
 34: 
 35:     private initNavigation(): void {
 36:         const navItems = document.querySelectorAll<HTMLButtonElement>('.nav-item');
 37:         const sections = document.querySelectorAll<HTMLElement>('.content-section');
 38: 
 39:         navItems.forEach(item => {
 40:             item.addEventListener('click', () => {
 41:                 const targetId = item.getAttribute('data-target');
 42:                 navItems.forEach(n => n.classList.remove('active'));
 43:                 sections.forEach(s => s.classList.remove('active'));
 44: 
 45:                 item.classList.add('active');
 46:                 if (targetId) {
 47:                     const targetSec = document.getElementById(targetId);
 48:                     if (targetSec) targetSec.classList.add('active');
 49:                 }
 50:             });
 51:         });
 52:     }

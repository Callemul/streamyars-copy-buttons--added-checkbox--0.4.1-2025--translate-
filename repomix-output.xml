267:     calcStats: function(arr: number[]): StatsSummary {
268:         if (!arr || arr.length === 0) return { min: 0, max: 0, avg: 0, median: 0 };
269:         const sum = arr.reduce((a, b) => a + b, 0);
270:         const avg = Math.round(sum / arr.length);
271:         const max = Math.max(...arr);
272:         const min = Math.min(...arr);
273:         const sorted = [...arr].sort((a, b) => a - b);
274:         const mid = Math.floor(sorted.length / 2);
275:         const median = sorted.length % 2 !== 0 ? sorted[mid] : Math.round((sorted[mid - 1] + sorted[mid]) / 2);
276:         return { min, max, avg, median };
277:     },

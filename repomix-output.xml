150:             const dateElement = card.querySelector('[data-testid="library-media-subtitle"]') as HTMLElement | null;
151:             const titleElement = card.querySelector('span[class*="MediaTitle"]') as HTMLElement | null;
152:             
153:             if (!dateElement || !titleElement) return;
154: 
155:             const videoTitle = titleElement.innerText.toUpperCase();
156:             const dateString = dateElement.innerText.split(',').slice(0,2).join(',');
157:             const videoDate = new Date(dateString);
158:             
159:             if (!isNaN(videoDate.getTime())) {
160:                 videoDate.setHours(0, 0, 0, 0);
161:                 const diffDays = Math.round(Math.abs(now.getTime() - videoDate.getTime()) / (1000 * 60 * 60 * 24)); 
162:                 let isFresh = (diffDays <= 5);
163: 
164:                 if (isFresh && videoTitle.includes('СУББОТНЯЯ ШКОЛА')) {
165:                     if (foundSS) {
166:                         isFresh = false; 
167:                     } else {
168:                         foundSS = true; 
169:                     }
170:                 }
171: 
172:                 if (isFresh) {
173:                     if (!card.querySelector('.syh-list-controls')) {
174:                         this.appendButtonsToCard(card);
175:                     }
176:                 }
177:                 
178:                 // Маркуємо картку як оброблену, щоб більше ніколи не зчитувати її властивості повторно
179:                 card.classList.add('syh-processed');
180:             }
181:         });
182:     },
183: 
184:     appendButtonsToCard: function(card: Element): void {
185:         const menuContainer = card.querySelector('div[class*="MediaCardMenu"]');
186:         if (!menuContainer) return;
187: 
188:         const controlsWrap = document.createElement('div');
189:         controlsWrap.className = 'syh-list-controls';
190:         controlsWrap.style.cssText = 'display: flex; gap: 8px; margin-right: 12px; z-index: 10; position: relative;';
191: 
192:         const titleElement = card.querySelector('span[class*="MediaTitle"]') as HTMLElement | null;
193:         const videoTitle = titleElement ? titleElement.innerText.trim() : 'Назву не знайдено';
194: 
195:         const href = card.getAttribute('href');
196:         const videoId = href ? href.split('/').pop() : '';
197:         const videoFullUrl = `https://streamyard.com/${videoId}`;
198: 
199:         const btnCopyTitle = this.createSquareButton('📝', 'Копіювати назву', () => {
200:             navigator.clipboard.writeText(videoTitle).then(() => {
201:                 this.tempIconChange(btnCopyTitle, '✅');
202:             });
203:         });
204: 
205:         const btnCopyUrl = this.createSquareButton('🔗', 'Копіювати посилання', () => {
206:             if (videoId) {
207:                 const finalString = `Видео (в хорошем качестве)\n\n${videoFullUrl}`;
208:                 navigator.clipboard.writeText(finalString).then(() => {
209:                     this.tempIconChange(btnCopyUrl, '✅');
210:                 });
211:             } else {
212:                 this.tempIconChange(btnCopyUrl, '❌');
213:             }
214:         });
215: 
216:         controlsWrap.addEventListener('click', (e: MouseEvent) => {
217:             e.preventDefault();
218:             e.stopPropagation();
219:         });
220: 
221:         controlsWrap.appendChild(btnCopyTitle);
222:         controlsWrap.appendChild(btnCopyUrl);
223:         if (menuContainer.parentNode) {
224:             menuContainer.parentNode.insertBefore(controlsWrap, menuContainer);
225:         }
226:     },
227: 
228:     createSquareButton: function(icon: string, tooltipText: string, onClickCallback: (e: MouseEvent) => void): HTMLButtonElement {
229:         const btn = document.createElement('button');
230:         btn.innerHTML = icon;
231:         btn.title = tooltipText;
232:         
233:         btn.style.cssText = `
234:             width: 32px;
235:             height: 32px;
236:             border-radius: 4px;
237:             border: 1px solid #ddd;
238:             background-color: #fff;
239:             color: #4F5461;
240:             font-size: 16px;
241:             display: flex;
242:             align-items: center;
243:             justify-content: center;
244:             cursor: pointer;
245:             transition: all 0.2s;
246:             padding: 0;
247:         `;
248: 
249:         btn.onmouseover = () => {
250:             btn.style.backgroundColor = '#f4f4f9';
251:             btn.style.borderColor = '#ccc';
252:         };
253:         btn.onmouseout = () => {
254:             btn.style.backgroundColor = '#fff';
255:             btn.style.borderColor = '#ddd';
256:         };
257: 
258:         btn.onclick = onClickCallback;
259:         return btn;
260:     },
261: 
262:     tempIconChange: function(btn: HTMLElement, tempIcon: string): void {
263:         const originalIcon = btn.innerHTML;
264:         btn.innerHTML = tempIcon;
265:         setTimeout(() => {
266:             btn.innerHTML = originalIcon;
267:         }, 2000);
268:     },
269: 
270:     // --- ГОЛОВНА КНОПКА МАСОВОГО СКАЧУВАННЯ ---
271:     injectMasterDownloadButton: function(): void {
272:         const listContainer = document.querySelector('div[class*="ListWrap"]');
273:         
274:         if (listContainer && !document.getElementById('syh-master-download-btn')) {
275:             const btn = document.createElement('button');
276:             btn.id = 'syh-master-download-btn';
277:             btn.innerText = '📥 Завантажити всі свіжі відео (Video Only)';
278:             btn.style.cssText = `
279:                 display: block; width: 100%; padding: 15px; margin-bottom: 20px;
280:                 background-color: #005DF7; color: white; font-size: 16px; font-weight: bold;
281:                 border: none; border-radius: 8px; cursor: pointer;
282:                 box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: 0.2s;
283:             `;
284:             
285:             btn.onmouseover = () => btn.style.backgroundColor = '#0047cc';
286:             btn.onmouseout = () => btn.style.backgroundColor = '#005DF7';
287: 
288:             btn.onclick = async (e: MouseEvent) => {
289:                 e.preventDefault();
290:                 btn.innerText = '⏳ Запускаю завантаження... Не чіпайте мишку!';
291:                 btn.style.backgroundColor = '#f39c12';
292:                 btn.disabled = true;
293: 
294:                 await this.downloadAllFreshVideos();
295: 
296:                 btn.innerText = '✅ Всі завантаження ініційовано!';
297:                 btn.style.backgroundColor = '#28a745';
298:                 setTimeout(() => {
299:                     btn.innerText = '📥 Завантажити всі свіжі відео (Video Only)';
300:                     btn.style.backgroundColor = '#005DF7';
301:                     btn.disabled = false;
302:                 }, 5000);
303:             };
304: 
305:             if (listContainer.parentNode) {
306:                 listContainer.parentNode.insertBefore(btn, listContainer);
307:             }
308:         }
309:     },
310: 
311:     downloadAllFreshVideos: async function(): Promise<void> {
312:         const videoCards = document.querySelectorAll('a.media-item-card');
313:         const now = new Date();
314:         now.setHours(0, 0, 0, 0); 
315:         const freshCards: Element[] = [];
316:         let foundSS = false;
317: 
318:         videoCards.forEach(card => {
319:             const dateElement = card.querySelector('[data-testid="library-media-subtitle"]') as HTMLElement | null;
320:             const titleElement = card.querySelector('span[class*="MediaTitle"]') as HTMLElement | null;
321:             
322:             if (dateElement && titleElement) {
323:                 const videoTitle = titleElement.innerText.toUpperCase();
324:                 const dateString = dateElement.innerText.split(',').slice(0,2).join(',');
325:                 const videoDate = new Date(dateString);
326:                 
327:                 if (!isNaN(videoDate.getTime())) {
328:                     videoDate.setHours(0, 0, 0, 0);
329:                     const diffDays = Math.round(Math.abs(now.getTime() - videoDate.getTime()) / (1000 * 60 * 60 * 24));
330:                     let isFresh = (diffDays <= 5);
331: 
332:                     if (isFresh && videoTitle.includes('СУББОТНЯЯ ШКОЛА')) {
333:                         if (foundSS) {
334:                             isFresh = false;
335:                         } else {
336:                             foundSS = true;
337:                         }
338:                     }
339: 
340:                     if (isFresh) {
341:                         freshCards.push(card);
342:                     }
343:                 }
344:             }
345:         });
346: 
347:         if (freshCards.length === 0) {
348:             alert("Немає свіжих відео для завантаження.");
349:             return;
350:         }
351: 
352:         console.log(`[SYH] Знайдено ${freshCards.length} свіжих відео для скачування.`);
353: 
354:         for (let i = 0; i < freshCards.length; i++) {
355:             const card = freshCards[i];
356:             try {
357:                 const moreBtn = card.querySelector('button[aria-label="More options"]') as HTMLElement | null;
358:                 if (moreBtn) moreBtn.click();
359:                 await new Promise(r => setTimeout(r, 600));
360: 
361:                 const menuItems = Array.from(document.querySelectorAll('span.ListItemText__StyledText-sc-1i1a88x-0')) as HTMLElement[];
362:                 const downloadText = (typeof chrome !== 'undefined' && chrome.i18n && chrome.i18n.getMessage) ? chrome.i18n.getMessage('download') : 'Download';
363:                 const downloadSpan = menuItems.find(el => el.innerText.includes(downloadText) || el.innerText.includes('Download'));
364:                 if (downloadSpan) {
365:                     const btn = downloadSpan.closest('button');
366:                     if (btn) btn.click();
367:                 }
368:                 
369:                 await new Promise(r => setTimeout(r, 1200));
370: 
371:                 const videoDownloadBtn = document.querySelector('[data-testid="download-row-download-button-video"]') as HTMLElement | null;
372:                 if (videoDownloadBtn) {
373:                     videoDownloadBtn.click();
374:                     console.log(`[SYH] Завантаження ${i+1} розпочато.`);
375:                     await new Promise(r => setTimeout(r, 1500));
376:                 }
377: 
378:                 const closeBtn = document.querySelector('button[aria-label="Close modal"]') as HTMLElement | null;
379:                 if (closeBtn) {
380:                     closeBtn.click();
381:                 } else {
382:                     document.dispatchEvent(new KeyboardEvent('keydown', {'key': 'Escape'}));
383:                 }
384: 
385:                 await new Promise(r => setTimeout(r, 1000));
386: 
387:             } catch (err) {
388:                 console.error(`[SYH] Помилка на відео ${i+1}: `, err);
389:             }
390:         }
391:     }
392: };
393: 
394: if (typeof window !== 'undefined') {
395:     (window as any).SYH_VIDEO_COPIER = SYH_VIDEO_COPIER;
396: }

 24:             mockStorageStore[k] = JSON.parse(JSON.stringify(obj[k]));
 25:         }
 26:         if (callback) callback();
 27:         return Promise.resolve();
 28:     },
 29:     remove: function(keys, callback) {
 30:         const keyList = Array.isArray(keys) ? keys : [keys];
 31:         for (const k of keyList) {
 32:             delete mockStorageStore[k];
 33:         }
 34:         if (callback) callback();
 35:         return Promise.resolve();
 36:     }
 37: };

289:     // Рекурсивний сканер для автоматичного пошуку активного бренда в сховищі без кліку по вкладці
290:     getBrandFromLocalStorage: function(): string {
291:         try {
292:             for (let i = 0; i < localStorage.length; i++) {
293:                 const key = localStorage.key(i);
294:                 if (!key) continue;
295:                 
296:                 // Перевіряємо ключі, пов'язані зі станом студії чи збереженими брендами
297:                 if (key.includes('brand') || key.includes('studio') || key.includes('store') || key.includes('state')) {
298:                     const val = localStorage.getItem(key);
299:                     if (!val) continue;
300:                     
301:                     if (val.startsWith('{') || val.startsWith('[')) {
302:                         const data = JSON.parse(val);
303:                         const foundName = this.searchBrandNameInObject(data);
304:                         if (foundName) return foundName;
305:                     }
306:                 }
307:             }
308:         } catch (e) {
309:             console.warn("[SYH] Помилка автозчитування бренда з localStorage:", e);
310:         }
311:         return "";
312:     },

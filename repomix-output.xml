 60: 
 61:         const importInput = document.getElementById('importConfigFile') as HTMLInputElement;
 62:         if (importInput) importInput.addEventListener('change', (e) => this.importConfig(e));
 63: 
 64:         const resetBtn = document.getElementById('resetDefaultsBtn');
 65:         if (resetBtn) resetBtn.addEventListener('click', () => this.resetDefaults());

 1: import { test } from 'node:test';
 2: import assert from 'node:assert/strict';
 3: import fs from 'node:fs';
 4: import path from 'node:path';
 5: 
 6: const CSS_FILES = [
 7:     'styles.css',
 8:     'popup/popup.css',
 9:     'options/options.css',
10:     'youtube/youtube_styles.css'
11: ];
12: 
13: function checkCssFile(filePath) {
14:     if (!fs.existsSync(filePath)) return;
15:     const content = fs.readFileSync(filePath, 'utf8');
16: 
17:     let openBraces = 0;
18:     const lines = content.split('\n');
19:     
20:     for (let i = 0; i < lines.length; i++) {
21:         const line = lines[i];
22:         const cleanLine = line.replace(/\/\*[\s\S]*?\*\//g, '').trim();
23:         if (!cleanLine) continue;
24: 
25:         for (let char of cleanLine) {
26:             if (char === '{') openBraces++;
27:             if (char === '}') openBraces--;
28:         }
29: 
30:         assert.ok(openBraces >= 0, `Unmatched closing brace '}' in ${filePath} at line ${i + 1}`);
31: 
32:         if (openBraces === 0) {
33:             if (cleanLine.includes(':') && !cleanLine.startsWith('@') && !cleanLine.startsWith('/*') && !cleanLine.includes('{')) {
34:                 const isDeclaration = /^[a-zA-Z0-9-]+\s*:\s*[^;]+;?$/.test(cleanLine);
35:                 assert.ok(
36:                     !isDeclaration,
37:                     `Orphan CSS property declaration outside selector block in ${filePath} at line ${i + 1}: "${cleanLine}"`
38:                 );
39:             }
40:         }
41:     }
42: 
43:     assert.equal(openBraces, 0, `Unclosed open brace '{' in ${filePath}`);
44: }
45: 
46: test('CSS Linter: All CSS files have valid syntax and no orphan property declarations', () => {
47:     for (const file of CSS_FILES) {
48:         checkCssFile(path.resolve(process.cwd(), file));
49:     }
50: });
</file>


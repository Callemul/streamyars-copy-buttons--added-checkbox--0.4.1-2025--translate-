 36:     log: function(msg: string): void {
 37:         console.log(`[SYH] ${msg}`);
 38:     },
 39: 
 40:     processAndCreateBanners: async function(rawText: string): Promise<void> {
 41:         let bannersToCreate: BannerItem[] = [];
 42:         let hasStandardFormat = false;
 43: 
 44:         // 1. Очистка Telegram-заголовків (таймкод + нік відправника):
 45:         const cleaner = (this.UTILS && this.UTILS.cleanTelegramHeaders) 
 46:             ? this.UTILS.cleanTelegramHeaders 
 47:             : ((window as any).cleanTelegramHeaders || ((t: string) => t));
 48:         const cleanedText = cleaner(rawText);
 49: 
 50:         // 2. Розбиваємо очищений текст на логічні блоки/повідомлення за заголовками секцій
 51:         let messages = cleanedText.split(/(?:^|\r?\n)(?=[❓🙏]|Вопросы к|Вопросы на|Предложения по|Саша, привет|Виталик, привет)/iu).map((m: string) => m.trim()).filter(Boolean);
 52:         if (messages.length === 0) messages = [cleanedText];
 53: 
 54:         const parseBlock = (text: string, defaultCat: string): BannerItem[] => {
 55:             if (!text.trim()) return [];
 56:             let blockCategory = defaultCat;
 57:             let blockQuestions: string[] = [];
 58:             let isStd = false;
 59: 
 60:             const firstLine = text.split('\n').map((l: string) => l.trim()).filter((l: string) => l.length > 0)[0] || "";
 61:             const isQuestionStart = /^(?:\d+[.)]|(?:\d+\uFE0F?\u20E3|🔟)|🔹)/.test(firstLine);
 62: 
 63:             if (!isQuestionStart && firstLine) {
 64:                 const headerMatch = firstLine.split(/(?:^|\s)(?=\d+[.)])|(?:^|\s)(?=(?:\d+\uFE0F?\u20E3|🔟))|(?=🔹)/);
 65:                 const headerText = (headerMatch[0] || "").trim().toUpperCase();
 66:                 if (headerText.includes("МОЛИТВ") || headerText.includes("ПРОХАН") || headerText.includes("🙏")) {
 67:                     blockCategory = "prayer";
 68:                 } else if (headerText.includes("СУББОТ") || headerText.includes("СУБОТ") || headerText.includes("УРОК")) {
 69:                     blockCategory = "stream";
 70:                 } else if (headerText.includes("ВОПРОС") || headerText.includes("ПИТАН") || headerText.includes("???") || headerText.includes("❓")) {
 71:                     blockCategory = "audience";
 72:                 }
 73:             }
 74: 
 75:             if (/памятн|пам'ятн|молчанов|опарин|опарін|молчанів/i.test(text) && !/(?:^|\s)\d+[.)]+(?!\d)/.test(text) && !/(?:\d+\uFE0F?\u20E3|🔟)/.test(text)) {
 76:                 this.log("Формат: Суботня Школа (без нумерації)");
 77:                 blockQuestions = this.PARSERS.parseSabbathSchoolUnnumberedQuestions(text);
 78:                 blockCategory = "stream"; 
 79:             } else if (/(?:\d+\uFE0F?\u20E3|🔟)/.test(text)) {
 80:                 this.log("Формат: Емодзі 1️⃣");
 81:                 blockQuestions = this.PARSERS.parseEmojiNumberedQuestions(text);
 82:             } else {
 83:                 this.log("Формат: Стандартний 1.");
 84:                 blockQuestions = this.PARSERS.parseStandardNumberedQuestions(text);
 85:                 isStd = true;
 86:             }
 87: 
 88:             return blockQuestions.map((q: string) => ({ text: q, category: blockCategory, isStandard: isStd }));
 89:         };
 90: 
 91:         try {
 92:             for (const msg of messages) {
 93:                 const parts = msg.split(/(?:^|\r?\n)\s*🙏+[^\r\n]*(?:МОЛИТ|ПРОХАН)[^\r\n]*/iu);
 94:                 const questionsText = parts[0] || "";
 95:                 const prayersText = parts[1] || "";
 96: 
 97:                 if (questionsText.trim()) {
 98:                     const qItems = parseBlock(questionsText, "stream");
 99:                     bannersToCreate = bannersToCreate.concat(qItems);
100:                     if (qItems.some(item => item.isStandard)) {
101:                         hasStandardFormat = true;
102:                     }
103:                 }
104:                 if (prayersText.trim()) {
105:                     const pItems = parseBlock(prayersText, "prayer");
106:                     bannersToCreate = bannersToCreate.concat(pItems);
107:                 }
108:             }
109:         } catch (error: any) {
110:             alert(error.message);
111:             return;
112:         }
113: 
114:         if (bannersToCreate.length === 0) {
115:             alert("Питання не знайдені.");
116:             return;
117:         }
118: 
119:         await this.ensureCleanStart(); 
120: 
121:         let createdCount = 0;
122:         
123:         for (const [index, item] of bannersToCreate.entries()) {
124:             this.log(`>>> Обробка банера ${index + 1} з ${bannersToCreate.length}`);
125:             try {
126:                 const pauseTime = index === 0 ? 600 : 250;
127:                 await new Promise(r => setTimeout(r, pauseTime));
128:                 
129:                 // Очищення дужок з авторами, навіть якщо дужка не закрита (наприклад, " ( Опарин , Молчанов")
130:                 const cleanQuestion = item.text.replace(/\s*\(\s*(?:Опарин|Молчанов|Василенко|Жаловага|Молчанів|Опарін).*?$/gi, "").trim();
131: 
132:                 await this.createSingleBanner(cleanQuestion);
133:                 
134:                 const saver = (this.UTILS && this.UTILS.saveBannerCategory) ? this.UTILS.saveBannerCategory : (window as any).SYH_UTILS?.saveBannerCategory;
135:                 if (saver) {
136:                     await saver(cleanQuestion, item.category);
137:                 }
138: 
139:                 createdCount++;
140:             } catch (error: any) {
141:                 console.error(error);
142:                 this.log(`Помилка: ${error.message}`);
143:                 await this.finalCleanup();
144:             }
145:         }
146:         
147:         if (hasStandardFormat) {
148:             this.log("Додаю розділювач...");
149:             await new Promise(r => setTimeout(r, 300));
150:             await this.createSingleBanner("----Питання глядачів----");
151:         }
152: 
153:         await this.finalCleanup();
154: 
155:         alert(`Готово! Створено: ${createdCount}.`);
156:     },
157: 
158:     clickCancelButton: function(form: Element): void {
159:         const buttons = Array.from(form.querySelectorAll('button'));
160:         const cancelButton = buttons.find(b => 
161:             b.type !== 'submit' && 
162:             b.id !== 'banner-timer-dropdown-button' && 
163:             !b.closest('#banner-timer-dropdown-button')
164:         );
165:         if (cancelButton) {
166:             cancelButton.click();
167:         }
168:     },
169: 

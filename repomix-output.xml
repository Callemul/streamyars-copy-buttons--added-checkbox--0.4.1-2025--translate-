<file path="modules/storage.ts">
  1: /**
  2:  * StreamYard Helper - Centralized Storage Adapter
  3:  * Модуль керування сховищем із захистом від розриву контексту розширення (zombie context) та fallback до localStorage.
  4:  */
  5: 
  6: export interface StorageAdapter {
  7:     isChromeStorageAvailable(): boolean;
  8:     get(keys: string | string[], cb: (result: Record<string, any>) => void): void;
  9:     set(items: Record<string, any>, cb?: () => void): void;
 10:     remove(keys: string | string[], cb?: () => void): void;
 11:     onChanged(callback: (changes: Record<string, any>, areaName: string) => void): void;
 12: }
 13: 
 14: export const SYH_STORAGE: StorageAdapter = {
 15:     /**
 16:      * Перевірка доступності chrome.storage.local
 17:      */
 18:     isChromeStorageAvailable: function(): boolean {
 19:         return typeof chrome !== 'undefined' && 
 20:                !!chrome.storage && 
 21:                !!chrome.storage.local && 
 22:                !!chrome.runtime && 
 23:                !!chrome.runtime.id;
 24:     },
 25: 
 26:     /**
 27:      * Отримати значення за ключем або масивом ключів
 28:      */
 29:     /**
 30:      * Отримати значення за ключем або масивом ключів
 31:      */
 32:     get: function(keys: string | string[], cb: (result: Record<string, any>) => void): void {
 33:         if (this.isChromeStorageAvailable()) {
 34:             try {
 35:                 chrome.storage.local.get(keys, (result) => {
 36:                     if (chrome.runtime.lastError) {
 37:                         console.warn('[SYH Storage] chrome.storage.local.get error:', chrome.runtime.lastError.message);
 38:                         const res: Record<string, any> = {};
 39:                         const arr = Array.isArray(keys) ? keys : [keys];
 40:                         arr.forEach(k => {
 41:                             try {
 42:                                 const val = localStorage.getItem(k);
 43:                                 res[k] = val !== null ? JSON.parse(val) : undefined;
 44:                             } catch (e: any) {
 45:                                 console.warn('[SYH Storage] localStorage.getItem error:', e?.message || e);
 46:                                 res[k] = undefined;
 47:                             }
 48:                         });
 49:                         if (cb) cb(res);
 50:                         return;
 51:                     }
 52:                     if (cb) cb(result);
 53:                 });
 54:                 return;
 55:             } catch (e: any) {
 56:                 console.warn('[SYH Storage] Fallback to localStorage (get):', e?.message || e);
 57:             }
 58:         }
 59:         const res: Record<string, any> = {};
 60:         const arr = Array.isArray(keys) ? keys : [keys];
 61:         arr.forEach(k => {
 62:             try {
 63:                 const val = localStorage.getItem(k);
 64:                 res[k] = val !== null ? JSON.parse(val) : undefined;
 65:             } catch (e: any) {
 66:                 console.warn('[SYH Storage] localStorage.getItem error:', e?.message || e);
 67:                 res[k] = undefined;
 68:             }
 69:         });
 70:         if (cb) cb(res);
 71:     },
 72: 
 73:     /**
 74:      * Зберегти об'єкт пар ключ-значення
 75:      */
 76:     set: function(items: Record<string, any>, cb?: () => void): void {
 77:         if (this.isChromeStorageAvailable()) {
 78:             try {
 79:                 chrome.storage.local.set(items, () => {
 80:                     if (chrome.runtime.lastError) {
 81:                         console.warn('[SYH Storage] chrome.storage.local.set error:', chrome.runtime.lastError.message);
 82:                     }
 83:                     if (cb) cb();
 84:                 });
 85:                 return;
 86:             } catch (e: any) {
 87:                 console.warn('[SYH Storage] Fallback to localStorage (set):', e?.message || e);
 88:             }
 89:         }
 90:         Object.keys(items).forEach(k => {
 91:             try {
 92:                 localStorage.setItem(k, JSON.stringify(items[k]));
 93:             } catch (e: any) {
 94:                 console.warn('[SYH Storage] localStorage.setItem error:', e?.message || e);
 95:             }
 96:         });
 97:         if (cb) cb();
 98:     },
 99: 
100:     /**
101:      * Видалити значення за ключем або масивом ключів
102:      */
103:     remove: function(keys: string | string[], cb?: () => void): void {
104:         if (this.isChromeStorageAvailable()) {
105:             try {
106:                 chrome.storage.local.remove(keys, () => {
107:                     if (chrome.runtime.lastError) {
108:                         console.warn('[SYH Storage] chrome.storage.local.remove error:', chrome.runtime.lastError.message);
109:                     }
110:                     if (cb) cb();
111:                 });
112:                 return;
113:             } catch (e: any) {
114:                 console.warn('[SYH Storage] Fallback to localStorage (remove):', e?.message || e);
115:             }
116:         }
117:         const arr = Array.isArray(keys) ? keys : [keys];
118:         arr.forEach(k => {
119:             try {
120:                 localStorage.removeItem(k);
121:             } catch (e: any) {
122:                 console.warn('[SYH Storage] localStorage.removeItem error:', e?.message || e);
123:             }
124:         });
125:         if (cb) cb();
126:     },
127: 
128:     /**
129:      * Підписка на зміни сховища (якщо доступно chrome.storage.onChanged)
130:      */
131:     onChanged: function(callback: (changes: Record<string, any>, areaName: string) => void): void {
132:         if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.onChanged) {
133:             try {
134:                 chrome.storage.onChanged.addListener(callback);
135:             } catch (e: any) {
136:                 console.warn('[SYH Storage] Failed to add onChanged listener:', e?.message || e);
137:             }
138:         }
139:     }
140: };
141: 
142: if (typeof window !== 'undefined') {
143:     (window as any).SYH_STORAGE = SYH_STORAGE;
144: }
145: 
146: if (typeof module !== 'undefined' && module.exports) {
147:     module.exports = SYH_STORAGE;
148: }
</file>


314:     // Допоміжний рекурсивний обхідник JSON-дерева для знаходження імені бренда
315:     searchBrandNameInObject: function(obj: any): string | null {
316:         if (!obj || typeof obj !== 'object') return null;
317:         
318:         if (obj.activeBrand && obj.activeBrand.name) return obj.activeBrand.name;
319:         if (obj.currentBrand && obj.currentBrand.name) return obj.currentBrand.name;
320:         if (obj.brand && obj.brand.name) return obj.brand.name;
321:         
322:         for (const key in obj) {
323:             if (Object.prototype.hasOwnProperty.call(obj, key)) {
324:                 const val = obj[key];
325:                 if (key === 'activeBrandName' || key === 'brandName' || key === 'currentBrandName') {
326:                     if (typeof val === 'string') return val;
327:                 }
328:                 if (typeof val === 'object') {
329:                     const res = this.searchBrandNameInObject(val);
330:                     if (res) return res;
331:                 }
332:             }
333:         }
334:         return null;
335:     }
336: };

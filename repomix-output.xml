<file path="modules/comment_assistant.ts">
  1: // modules/comment_assistant.ts
  2: import { SYH_CONFIG } from './config.ts';
  3: 
  4: export interface CommentAssistantInterface {
  5:     triggerWords: string[];
  6:     selectors: Record<string, string>;
  7:     init(config?: any): void;
  8:     escapeHTML(str: string): string;
  9:     createTriggerRegExp(word: string): RegExp;
 10:     hasTrigger(text: string): boolean;
 11:     highlightTriggers(text: string): { highlightedText: string; matchedWords: string[] };
 12:     stripHighlights(text: string): string;
 13:     processComment(commentBlock: HTMLElement | Element): boolean;
 14:     processAllComments(): void;
 15: }
 16: 
 17: export const SYH_COMMENT_ASSISTANT: CommentAssistantInterface = {
 18:     triggerWords: SYH_CONFIG?.TRIGGER_WORDS || ['вопрос'],
 19:     selectors: SYH_CONFIG?.SELECTORS || {
 20:         commentBlock: '[class*="PlatformComment__Wrap"]',
 21:         commentText: '[class*="PlatformCommentShell__ContentSpan"]'
 22:     },
 23: 
 24:     init(config?: any) {
 25:         if (config?.TRIGGER_WORDS) {
 26:             this.triggerWords = config.TRIGGER_WORDS;
 27:         }
 28:         if (config?.SELECTORS) {
 29:             this.selectors = config.SELECTORS;
 30:         }
 31:     },
 32: 
 33:     /**
 34:      * Безпечна екранація HTML-символів
 35:      */
 36:     escapeHTML(str: string): string {
 37:         if (!str) return '';
 38:         return str
 39:             .replace(/&/g, '&amp;')
 40:             .replace(/</g, '&lt;')
 41:             .replace(/>/g, '&gt;')
 42:             .replace(/"/g, '&quot;')
 43:             .replace(/'/g, '&#039;');
 44:     },
 45: 
 46:     /**
 47:      * Створення регулярного виразу з урахуванням кириличних меж слів
 48:      * Використовує Unicode lookbehind/lookahead (?<![\p{L}\p{N}]) та (?![\p{L}\p{N}])
 49:      */
 50:     createTriggerRegExp(word: string): RegExp {
 51:         const escapedWord = word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
 52:         try {
 53:             return new RegExp(`(?<![\\p{L}\\p{N}])(${escapedWord})(?![\\p{L}\\p{N}])`, 'giu');
 54:         } catch (e) {
 55:             // Фолбек для середовищ без підтримки Unicode lookbehind
 56:             return new RegExp(`(^|[^a-zA-Z0-9а-яА-ЯёЁіІїЇєЄґҐ])(${escapedWord})($|[^a-zA-Z0-9а-яА-ЯёЁіІїЇєЄґҐ])`, 'gi');
 57:         }
 58:     },
 59: 
 60:     /**
 61:      * Перевірка чи містить текст хоча б одне тригерне слово
 62:      */
 63:     hasTrigger(text: string): boolean {
 64:         if (!text || !this.triggerWords || this.triggerWords.length === 0) return false;
 65:         return this.triggerWords.some(word => {
 66:             const rx = this.createTriggerRegExp(word);
 67:             return rx.test(text);
 68:         });
 69:     },
 70: 
 71:     /**
 72:      * Підсвічує тригерні слова у тексті за допомогою спец-тегу <mark class="syh-trigger-highlight">
 73:      */
 74:     highlightTriggers(text: string): { highlightedText: string; matchedWords: string[] } {
 75:         if (!text) return { highlightedText: '', matchedWords: [] };
 76:         
 77:         let safeHTML = this.escapeHTML(text);
 78:         const matchedWords: string[] = [];
 79: 
 80:         this.triggerWords.forEach(word => {
 81:             const rx = this.createTriggerRegExp(word);
 82:             safeHTML = safeHTML.replace(rx, (match, p1, p2, p3) => {
 83:                 // Визначаємо, чи використовується фолбек-вираз з 3 групами захоплення
 84:                 const isFallback = typeof p2 === 'string';
 85:                 const targetWord = isFallback ? p2 : (p1 || match);
 86:                 
 87:                 if (!matchedWords.includes(word.toLowerCase())) {
 88:                     matchedWords.push(word.toLowerCase());
 89:                 }
 90:                 const replacement = `<mark class="syh-trigger-highlight" data-syh-trigger="${this.escapeHTML(word.toLowerCase())}">${targetWord}</mark>`;
 91:                 
 92:                 if (isFallback) {
 93:                     return `${p1}${replacement}${p3}`;
 94:                 }
 95:                 return replacement;
 96:             });
 97:         });
 98: 
 99:         return { highlightedText: safeHTML, matchedWords };
100:     },
101: 
102:     /**
103:      * Видаляє підсвічування (повертає чистий текст)
104:      */
105:     stripHighlights(text: string): string {
106:         if (!text) return '';
107:         return text.replace(/<mark class="syh-trigger-highlight"[^>]*>(.*?)<\/mark>/gi, '$1');
108:     },
109: 
110:     /**
111:      * Головна функція обробки елемента коментаря
112:      * @param commentBlock DOM елемент коментаря
113:      * @returns boolean (чи було застосовано підсвічування)
114:      */
115:     processComment(commentBlock: HTMLElement | Element): boolean {
116:         if (!commentBlock) return false;
117: 
118:         const textNode = commentBlock.querySelector(this.selectors.commentText || '[class*="PlatformCommentShell__ContentSpan"]');
119:         if (!textNode) return false;
120: 
121:         // Отримуємо або зберігаємо початковий чистий текст коментаря
122:         let originalText = textNode.getAttribute('data-syh-original-text');
123:         if (originalText === null) {
124:             originalText = textNode.textContent || '';
125:             textNode.setAttribute('data-syh-original-text', originalText);
126:         }
127: 
128:         // Перевіряємо на тригерні слова
129:         if (this.hasTrigger(originalText)) {
130:             const { highlightedText, matchedWords } = this.highlightTriggers(originalText);
131:             textNode.innerHTML = highlightedText;
132:             commentBlock.setAttribute('data-syh-triggered', matchedWords.join(','));
133:             return true;
134:         } else {
135:             textNode.textContent = originalText;
136:             commentBlock.removeAttribute('data-syh-triggered');
137:             return false;
138:         }
139:     },
140: 
141:     /**
142:      * Сканує всі коментарі у DOM та обробляє їх
143:      */
144:     processAllComments() {
145:         if (typeof document === 'undefined') return;
146:         const selector = this.selectors.commentBlock || '[class*="PlatformComment__Wrap"]';
147:         const comments = document.querySelectorAll(selector);
148:         comments.forEach(block => this.processComment(block));
149:     }
150: };
151: 
152: if (typeof window !== 'undefined') {
153:     (window as any).SYH_COMMENT_ASSISTANT = SYH_COMMENT_ASSISTANT;
154: }
</file>


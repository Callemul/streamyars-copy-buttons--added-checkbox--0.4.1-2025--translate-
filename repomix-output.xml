162:     let grouped: Record<string, string[]> = {};
163:     
164:     SYH_UI.prayersCache.forEach((p: PrayerItem) => {
165:         if (activeFilter === 'prayer' && p.type !== 'prayer') return;
166:         if (activeFilter === 'question' && p.type !== 'question') return;
167:         if (activeFilter === 'other') return; 

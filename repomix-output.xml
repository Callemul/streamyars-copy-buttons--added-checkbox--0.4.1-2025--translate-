 52:     const process = () => {
 53:         processMutations(pendingMutations);
 54:         pendingMutations = [];
 55:         rafScheduled = false;
 56:     };
 57:     if (document.hidden) {
 58:         setTimeout(process, 200);
 59:     } else {
 60:         requestAnimationFrame(process);
 61:     }
 62: }
 63: ```

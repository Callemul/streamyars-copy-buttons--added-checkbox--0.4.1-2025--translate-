  2: // Хелпер відправки сигналу зняття зірки до StreamYard в реальному часі
  3: function sendUnstarMessage(text) {
  4:     chrome.tabs.query({ active: true, currentWindow: true }, function(tabs) {
  5:         if (tabs[0] && tabs[0].id) {
  6:             chrome.tabs.sendMessage(tabs[0].id, { action: 'unstar_comment', text: text });
  7:         }
  8:     });
  9: }

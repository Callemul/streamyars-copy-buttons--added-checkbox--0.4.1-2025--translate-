  2: 
  3: /**
  4:  * ============================================================================
  5:  * STREAMYARD HELPER - ANTI-AFK MODULE (GOLDEN STANDARD: BULLETPROOF + PREVENTIVE)
  6:  * ============================================================================
  7:  * Розроблено за Золотим стандартом проєкту (DEVELOPER_NOTES.md).
  8:  * 
  9:  * Подвійний захист від AFK:
 10:  * 1. Превентивний захист (User Activity Simulation):
 11:  *    Періодично (раз на 3 хвилини) відправляє легку фонову подію `mousemove`,
 12:  *    завдяки чому StreamYard вважає користувача активним і ВЗАГАЛІ НЕ ПОКАЗУЄ вікно AFK.
 13:  * 
 14:  * 2. Броньований (Bulletproof) сканер:
 15:  *    Якщо діалог все ж з'явився, сканує абсолютно всі клікабельні вузли
 16:  *    (button, [role="button"], a, div[tabindex]), ігноруючи специфічні React-класи.
 17:  * ============================================================================
 18:  */
 19: 
 20: export interface I18nAdapterLike {
 21:     getMessage(key: string, fallback?: string): string;
 22: }
 23: 
 24: /**
 25:  * Броньований сканер для виявлення кнопки "Stay in studio"
 26:  */
 27: export function checkAndClickAntiAfk(
 28:     docNode: Document | Element | null = typeof document !== 'undefined' ? document : null,
 29:     i18n?: I18nAdapterLike
 30: ): boolean {
 31:     if (!docNode) return false;
 32: 
 33:     // 1. Пошук контейнера модалки за різними варіантами селекторів
 34:     const dialogSelectors = [
 35:         'div[role="dialog"][aria-label="Are you still there?"]',
 36:         'div[role="dialog"]',
 37:         '[aria-modal="true"]',
 38:         'div[class*="modal"]',
 39:         'div[class*="Dialog"]'
 40:     ];
 41: 
 42:     let modalButtons: Element[] = [];
 43:     for (const selector of dialogSelectors) {
 44:         const modal = docNode.querySelector(selector);
 45:         if (modal) {
 46:             const buttons = Array.from(modal.querySelectorAll('button, [role="button"], a'));
 47:             if (buttons.length > 0) {
 48:                 modalButtons = buttons;
 49:                 break;
 50:             }
 51:         }
 52:     }
 53: 
 54:     // 2. Броньований Fallback: скануємо абсолютно всі клікабельні елементи сторінки
 55:     const candidateButtons = modalButtons.length > 0 
 56:         ? modalButtons 
 57:         : Array.from(docNode.querySelectorAll('button, [role="button"], div[tabindex="0"], a'));
 58: 
 59:     if (candidateButtons.length === 0) {
 60:         return false;
 61:     }
 62: 
 63:     // 3. Варіанти пошукових ключів
 64:     const targetTexts: string[] = [
 65:         'stay in the studio',
 66:         'stay in studio',
 67:         'stay in',
 68:         'still there',
 69:         'залишитися в студії',
 70:         'остаться в студии'
 71:     ];
 72: 
 73:     if (i18n && typeof i18n.getMessage === 'function') {
 74:         const localized = i18n.getMessage('stayInStudio');
 75:         if (localized && localized.trim()) {
 76:             targetTexts.push(localized.trim().toLowerCase());
 77:         }
 78:     } else if (typeof chrome !== 'undefined' && chrome.i18n && typeof chrome.i18n.getMessage === 'function') {
 79:         try {
 80:             const localized = chrome.i18n.getMessage('stayInStudio');
 81:             if (localized && localized.trim()) {
 82:                 targetTexts.push(localized.trim().toLowerCase());
 83:             }
 84:         } catch {
 85:             // ignore
 86:         }
 87:     }
 88: 
 89:     // 4. Пошук відповідності серед усіх елементів
 90:     for (const btn of candidateButtons) {
 91:         const text = (btn.textContent || '').trim().toLowerCase();
 92:         const ariaLabel = (btn.getAttribute('aria-label') || '').trim().toLowerCase();
 93:         const title = (btn.getAttribute('title') || '').trim().toLowerCase();
 94: 
 95:         const isMatch = targetTexts.some(target => 
 96:             text === target || text.includes(target) || 
 97:             ariaLabel === target || ariaLabel.includes(target) ||
 98:             title === target || title.includes(target)
 99:         ) || /stay in (the )?studio/i.test(text) || /still there/i.test(text);
100: 
101:         if (isMatch) {
102:             try {
103:                 console.log("[SYH Anti-AFK] AFK таймаут перехоплено! Натискаю 'Stay in the studio'.");
104:                 (btn as HTMLElement).click();
105:                 return true;
106:             } catch (err) {
107:                 console.warn("[SYH Anti-AFK] Помилка при натисканні кнопки Stay in studio:", err);
108:             }
109:         }
110:     }
111: 
112:     return false;
113: }

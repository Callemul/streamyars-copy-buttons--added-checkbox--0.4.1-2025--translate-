115: /**
116:  * Превентивна імітація активності миші (Preventive User Activity Simulation)
117:  * Запобігає появі вікна AFK взагалі.
118:  */
119: export function simulateUserActivity(): void {
120:     if (typeof document === 'undefined') return;
121:     try {
122:         const event = new MouseEvent('mousemove', {
123:             bubbles: true,
124:             cancelable: true,
125:             clientX: Math.floor(Math.random() * 100) + 10,
126:             clientY: Math.floor(Math.random() * 100) + 10
127:         });
128:         (document.body || document.documentElement || document).dispatchEvent(event);
129:         console.log("[SYH Anti-AFK] Імітація фонової активності користувача виконана.");
130:     } catch (err) {
131:         // ignore
132:     }
133: }
134: 
135: let activeAfkTimer: ReturnType<typeof setInterval> | null = null;
136: let activeActivityTimer: ReturnType<typeof setInterval> | null = null;
137: let activeAfkObserver: MutationObserver | null = null;
138: 
139: export function stopAntiAfk(): void {
140:     if (activeAfkObserver !== null) {
141:         try {
142:             activeAfkObserver.disconnect();
143:         } catch {
144:             // ignore
145:         }
146:         activeAfkObserver = null;
147:     }
148:     if (activeAfkTimer !== null) {
149:         clearInterval(activeAfkTimer);
150:         activeAfkTimer = null;
151:     }
152:     if (activeActivityTimer !== null) {
153:         clearInterval(activeActivityTimer);
154:         activeActivityTimer = null;
155:     }
156:     console.log("[SYH Anti-AFK] Anti-AFK захист зупинено.");
157: }
158: 
159: export function startAntiAfk(
160:     config?: any,
161:     storage?: any,
162:     i18n?: I18nAdapterLike,
163:     customTargetNode?: Element | Document | null
164: ): void {
165:     stopAntiAfk();
166: 
167:     const checkOptionsAndRun = (options?: any) => {
168:         const enabled = options?.anti_afk_enabled !== false;
169:         if (!enabled) {
170:             console.log("[SYH Anti-AFK] Anti-AFK вимкнено у налаштуваннях.");
171:             stopAntiAfk();
172:             return;
173:         }
174: 
175:         const intervalSec = options?.anti_afk_interval_sec || (config?.TIMINGS?.ANTI_AFK_INTERVAL ? config.TIMINGS.ANTI_AFK_INTERVAL / 1000 : 30);
176:         const intervalMs = Math.max(intervalSec * 1000, 5000);
177: 
178:         console.log(`[SYH Anti-AFK] Anti-AFK активовано (Превентивна активність + MutationObserver + Резервний таймер ${intervalSec}с).`);
179: 
180:         const rootNode = customTargetNode || (typeof document !== 'undefined' ? document.body || document.documentElement : null);
181: 
182:         // 1. Початкова перевірка
183:         checkAndClickAntiAfk(rootNode, i18n);
184: 
185:         // 2. Превентивна імітація активності кожні 2.5 хвилини (150,000 мс)
186:         simulateUserActivity();
187:         activeActivityTimer = setInterval(simulateUserActivity, 150000);
188: 
189:         // 3. MutationObserver перехоплення
190:         if (rootNode && typeof MutationObserver !== 'undefined') {
191:             try {
192:                 activeAfkObserver = new MutationObserver((mutations) => {
193:                     for (const mutation of mutations) {
194:                         if (mutation.addedNodes && mutation.addedNodes.length > 0) {
195:                             const clicked = checkAndClickAntiAfk(rootNode, i18n);
196:                             if (clicked) break;
197:                         }
198:                     }
199:                 });
200:                 activeAfkObserver.observe(rootNode, { childList: true, subtree: true });
201:             } catch (err) {
202:                 console.warn("[SYH Anti-AFK] Помилка старту MutationObserver:", err);
203:             }
204:         }
205: 
206:         // 4. Резервний таймер
207:         activeAfkTimer = setInterval(() => {
208:             try {
209:                 if (typeof chrome !== 'undefined' && chrome.runtime && !chrome.runtime.id) {
210:                     stopAntiAfk();
211:                     return;
212:                 }
213:             } catch {
214:                 stopAntiAfk();
215:                 return;
216:             }
217: 
218:             checkAndClickAntiAfk(rootNode, i18n);
219:         }, intervalMs);
220:     };
221: 
222:     if (storage && typeof storage.get === 'function') {
223:         storage.get(['syh_options'], (data: any) => {
224:             checkOptionsAndRun(data?.syh_options);
225:         });
226: 
227:         if (typeof storage.onChanged === 'function') {
228:             storage.onChanged((changes: any) => {
229:                 if (changes.syh_options) {
230:                     checkOptionsAndRun(changes.syh_options.newValue);
231:                 }
232:             });
233:         }
234:     } else {
235:         checkOptionsAndRun();
236:     }
237: }
238: 
239: export const SYH_ANTI_AFK = {
240:     checkAndClickAntiAfk,
241:     simulateUserActivity,
242:     startAntiAfk,
243:     stopAntiAfk
244: };
245: 
246: if (typeof window !== 'undefined') {
247:     (window as any).SYH_ANTI_AFK = SYH_ANTI_AFK;
248: }
</file>


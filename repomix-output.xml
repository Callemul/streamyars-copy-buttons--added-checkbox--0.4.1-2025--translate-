226:         if (this.toastTimer) clearTimeout(this.toastTimer);
227:         this.toastTimer = setTimeout(() => {
228:             toast.classList.remove('show');
229:         }, 3000);
230:     }
231: }
232: 
233: document.addEventListener('DOMContentLoaded', () => {
234:     new OptionsController();
235: });

346: window.parseTelegramExportLineByLine = function(text) {
347:     const rawItems = [];
348:     const lines = text.split('\n');
349:     const headerARegex = /^.+?, \[\d{2}\.\d{2}\.\d{4} \d{2}:\d{2}\]$/;
350:     const headerBRegex = /^\[\d{2}\.\d{2}\.\d{4} \d{2}:\d{2}\]\s*.+?$/;
351:     const tgHeaderBRegex = /^\[\d{2}\.\d{2}\.\d{4} \d{2}:\d{2}\]\s*([^:\n]+)(?::\s*(.*))?$/;
352:     let currentItem = null;
353: 
354:     lines.forEach(line => {
355:         const trimmed = line.trim();
356:         const isHeader = headerARegex.test(trimmed) || headerBRegex.test(trimmed);
357:         
358:         if (isHeader) {
359:             if (currentItem && currentItem.textLines.length > 0) { 
360:                 rawItems.push({ author: currentItem.author || "Питання з чату", text: currentItem.textLines.join('\n').trim(), source: 'new' }); 
361:             }
362:             let author = null;
363:             const textLines = [];
364:             if (headerBRegex.test(trimmed)) {
365:                 const match = trimmed.match(tgHeaderBRegex);
366:                 if (match) {
367:                     const trailing = match[2] ? match[2].trim() : "";
368:                     if (trailing) {
369:                         if (trailing.startsWith('@')) {
370:                             author = window.cleanAuthorName(trailing);
371:                         } else {
372:                             textLines.push(trailing);
373:                         }
374:                     }
375:                 }
376:             }
377:             currentItem = { author: author, textLines: textLines };
378:         } else if (currentItem) {
379:             if (trimmed === "") return;
380:             if (currentItem.author === null) {
381:                 if (trimmed.startsWith('@')) { 
382:                     currentItem.author = window.cleanAuthorName(trimmed); 
383:                 } else { 
384:                     currentItem.author = "Питання з чату"; 
385:                     currentItem.textLines.push(trimmed); 
386:                 }
387:             } else { 
388:                 currentItem.textLines.push(trimmed); 
389:             }
390:         }
391:     });
392: 
393:     if (currentItem && currentItem.textLines.length > 0) { 
394:         rawItems.push({ author: currentItem.author || "Питання з чату", text: currentItem.textLines.join('\n').trim(), source: 'new' }); 
395:     }
396: 
397:     const groupedItems = [];
398:     rawItems.forEach(item => {
399:         if (groupedItems.length > 0) {
400:             const lastGroup = groupedItems[groupedItems.length - 1];
401:             if (lastGroup.author === item.author) {
402:                 if (!lastGroup.text.startsWith('🔹')) lastGroup.text = `🔹${lastGroup.text}`;
403:                 lastGroup.text += `\n🔹${item.text}`;
404:                 return;
405:             }
406:         }
407:         groupedItems.push(item);
408:     });
409:     return groupedItems;
410: };

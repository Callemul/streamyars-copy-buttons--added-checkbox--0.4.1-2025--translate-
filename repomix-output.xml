  3: 
  4: export interface SyhState {
  5:     itemStates: Record<string, boolean>;
  6:     lastDate: string | null;
  7:     onStateLoaded: ((states: Record<string, boolean>) => void) | null;
  8:     _saveTimer: ReturnType<typeof setTimeout> | null;
  9: 
 10:     init(callback?: () => void): void;
 11:     updateState(key: string, isChecked: boolean, delayMs?: number): void;
 12:     getState(key: string): boolean;
 13:     saveState(delayMs?: number): void;
 14:     saveStateImmediate(): void;
 15: }
 16: 
 17: export const SYH_STATE: SyhState = {
 18:     itemStates: {},
 19:     lastDate: null,
 20:     onStateLoaded: null,
 21:     _saveTimer: null,
 22: 
 23:     init: function(callback?: () => void): void {
 24:         const self = this;
 25:         const today = (SYH_UTILS && typeof SYH_UTILS.getTodayDateString === 'function')
 26:             ? SYH_UTILS.getTodayDateString()
 27:             : new Date().toLocaleDateString('sv-SE');
 28: 
 29:         // Отримання централізованого адаптера сховища
 30:         const storage = SYH_STORAGE || ((window as any).SYH_STORAGE || ((window as any).SYH_UTILS && (window as any).SYH_UTILS.storage));
 31: 
 32:         if (!storage) {
 33:             console.error("SYH_STATE: Не знайдено адаптер сховища!");
 34:             if (callback) callback();
 35:             return;
 36:         }
 37: 
 38:         storage.get(['syh_checkbox_state'], function(result: any) {
 39:             const stored = (result && result.syh_checkbox_state) ? result.syh_checkbox_state : {};
 40:             const savedDate = stored.date;
 41:             
 42:             console.log("SYH_STATE: Ініціалізація стану. Збережена дата в кеші:", savedDate, "Поточна дата:", today);
 43: 
 44:             // Очищення або завантаження стану залежно від поточної дати (Cache Invalidation)
 45:             if (savedDate && savedDate !== today) {
 46:                 console.log("SYH_STATE: Виявлено новий день. Очищення стану збережених чекбоксів.");
 47:                 self.itemStates = {};
 48:                 self.lastDate = today;
 49:                 storage.remove('syh_checkbox_state', function() {
 50:                     if (typeof self.onStateLoaded === 'function') {
 51:                         self.onStateLoaded(self.itemStates);
 52:                     }
 53:                     if (callback) callback();
 54:                 });
 55:             } else {
 56:                 self.itemStates = stored.data || {};
 57:                 self.lastDate = savedDate || today;
 58:                 console.log("SYH_STATE: Стан успішно завантажено з сховища:", self.itemStates);
 59:                 if (typeof self.onStateLoaded === 'function') {
 60:                     self.onStateLoaded(self.itemStates);
 61:                 }
 62:                 if (callback) callback();
 63:             }
 64:         });
 65:     },
 66: 
 67:     updateState: function(key: string, isChecked: boolean, delayMs: number = 150): void {
 68:         this.itemStates[key] = isChecked;
 69:         this.saveState(delayMs);
 70:     },
 71: 
 72:     getState: function(key: string): boolean {
 73:         return !!this.itemStates[key];
 74:     },
 75: 
 76:     saveState: function(delayMs: number = 150): void {
 77:         if (this._saveTimer) {
 78:             clearTimeout(this._saveTimer);
 79:             this._saveTimer = null;
 80:         }
 81: 
 82:         const self = this;
 83:         const doSave = function(): void {
 84:             self._saveTimer = null;
 85:             self.saveStateImmediate();
 86:         };
 87: 
 88:         if (delayMs <= 0) {
 89:             doSave();
 90:         } else {
 91:             this._saveTimer = setTimeout(doSave, delayMs);
 92:         }
 93:     },
 94: 
 95:     saveStateImmediate: function(): void {
 96:         if (this._saveTimer) {
 97:             clearTimeout(this._saveTimer);
 98:             this._saveTimer = null;
 99:         }
100:         const today = (SYH_UTILS && typeof SYH_UTILS.getTodayDateString === 'function')
101:             ? SYH_UTILS.getTodayDateString()
102:             : new Date().toLocaleDateString('sv-SE');
103:         const stateToSave = {
104:             date: today,
105:             data: this.itemStates
106:         };
107: 
108:         // Отримання централізованого адаптера сховища
109:         const storage = SYH_STORAGE || ((window as any).SYH_STORAGE || ((window as any).SYH_UTILS && (window as any).SYH_UTILS.storage));
110: 
111:         if (storage) {
112:             storage.set({ 'syh_checkbox_state': stateToSave }, function() {
113:                 console.log("SYH_STATE: Оновлений стан чекбоксів успішно записано.");
114:             });
115:         } else {
116:             console.error("SYH_STATE: Не вдалося зберегти стан, адаптер сховища відсутній!");
117:         }
118:     }
119: };
120: 
121: if (typeof window !== 'undefined') {
122:     (window as any).SYH_STATE = SYH_STATE;
123: }

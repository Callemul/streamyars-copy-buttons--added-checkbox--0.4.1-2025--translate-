 23: export const SYH_STATE: SyhState = {
 24:     itemStates: {},
 25:     lastDate: null,
 26:     onStateLoaded: null,
 27:     _saveTimer: null,
 28: 
 29:     init: function(callback?: () => void): void {
 30:         const self = this;
 31:         const today = getTodayDateString();
 32: 
 33:         // Отримання централізованого адаптера сховища
 34:         const storage = SYH_STORAGE || (typeof window !== 'undefined' ? ((window as any).SYH_STORAGE || ((window as any).SYH_UTILS && (window as any).SYH_UTILS.storage)) : null);
 35: 
 36:         if (!storage) {
 37:             console.error("SYH_STATE: Не знайдено адаптер сховища!");
 38:             if (callback) callback();
 39:             return;
 40:         }
 41: 
 42:         storage.get(['syh_checkbox_state'], function(result: any) {
 43:             const stored = (result && result.syh_checkbox_state) ? result.syh_checkbox_state : {};
 44:             const savedDate = stored.date;
 45:             
 46:             console.log("SYH_STATE: Ініціалізація стану. Збережена дата в кеші:", savedDate, "Поточна дата:", today);
 47: 
 48:             // Очищення або завантаження стану залежно від поточної дати (Cache Invalidation)
 49:             if (savedDate && savedDate !== today) {
 50:                 console.log("SYH_STATE: Виявлено новий день. Очищення стану збережених чекбоксів.");
 51:                 self.itemStates = {};
 52:                 self.lastDate = today;
 53:                 storage.remove('syh_checkbox_state', function() {
 54:                     if (typeof self.onStateLoaded === 'function') {
 55:                         self.onStateLoaded(self.itemStates);
 56:                     }
 57:                     if (callback) callback();
 58:                 });
 59:             } else {
 60:                 self.itemStates = stored.data || {};
 61:                 self.lastDate = savedDate || today;
 62:                 console.log("SYH_STATE: Стан успішно завантажено з сховища:", self.itemStates);
 63:                 if (typeof self.onStateLoaded === 'function') {
 64:                     self.onStateLoaded(self.itemStates);
 65:                 }
 66:                 if (callback) callback();
 67:             }
 68:         });
 69:     },
 70: 
 71:     updateState: function(key: string, isChecked: boolean, delayMs: number = 150): void {
 72:         this.itemStates[key] = isChecked;
 73:         this.saveState(delayMs);
 74:     },
 75: 
 76:     getState: function(key: string): boolean {
 77:         return !!this.itemStates[key];
 78:     },
 79: 
 80:     saveState: function(delayMs: number = 150): void {
 81:         if (this._saveTimer) {
 82:             clearTimeout(this._saveTimer);
 83:             this._saveTimer = null;
 84:         }
 85: 
 86:         const self = this;
 87:         const doSave = function(): void {
 88:             self._saveTimer = null;
 89:             self.saveStateImmediate();
 90:         };
 91: 
 92:         if (delayMs <= 0) {
 93:             doSave();
 94:         } else {
 95:             this._saveTimer = setTimeout(doSave, delayMs);
 96:         }
 97:     },
 98: 
 99:     saveStateImmediate: function(): void {
100:         if (this._saveTimer) {
101:             clearTimeout(this._saveTimer);
102:             this._saveTimer = null;
103:         }
104:         const today = getTodayDateString();
105:         const stateToSave = {
106:             date: today,
107:             data: this.itemStates
108:         };
109: 
110:         // Отримання централізованого адаптера сховища
111:         const storage = SYH_STORAGE || (typeof window !== 'undefined' ? ((window as any).SYH_STORAGE || ((window as any).SYH_UTILS && (window as any).SYH_UTILS.storage)) : null);
112: 
113:         if (storage) {
114:             storage.set({ 'syh_checkbox_state': stateToSave }, function() {
115:                 console.log("SYH_STATE: Оновлений стан чекбоксів успішно записано.");
116:             });
117:         } else {
118:             console.error("SYH_STATE: Не вдалося зберегти стан, адаптер сховища відсутній!");
119:         }
120:     }
121: };

154: window.parseTelegramExportLineByLine = function(text) {
155:     const rawItems = [];
156:     const lines = text.split('\n');
157:     const headerRegex = /^.+?, \[\d{2}\.\d{2}\.\d{4} \d{2}:\d{2}\]$/;
158:     let currentItem = null;
159: 
160:     lines.forEach(line => {
161:         const trimmed = line.trim();
162:         if (headerRegex.test(trimmed)) {
163:             if (currentItem && currentItem.textLines.length > 0) { rawItems.push({ author: currentItem.author, text: currentItem.textLines.join('\n').trim(), source: 'new' }); }
164:             currentItem = { author: null, textLines: [] };
165:         } else if (currentItem) {
166:             if (trimmed === "") return;
167:             if (currentItem.author === null) {
168:                 if (trimmed.startsWith('@')) { currentItem.author = window.cleanAuthorName(trimmed); } 
169:                 else { currentItem.author = "Питання з чату"; currentItem.textLines.push(trimmed); }
170:             } else { currentItem.textLines.push(trimmed); }
171:         }
172:     });
173: 
174:     if (currentItem && currentItem.textLines.length > 0) { rawItems.push({ author: currentItem.author || "Питання з чату", text: currentItem.textLines.join('\n').trim(), source: 'new' }); }
175: 
176:     const groupedItems = [];
177:     rawItems.forEach(item => {
178:         if (groupedItems.length > 0) {
179:             const lastGroup = groupedItems[groupedItems.length - 1];
180:             if (lastGroup.author === item.author) {
181:                 if (!lastGroup.text.startsWith('🔹')) lastGroup.text = `🔹${lastGroup.text}`;
182:                 lastGroup.text += `\n🔹${item.text}`;
183:                 return;
184:             }
185:         }
186:         groupedItems.push(item);
187:     });
188:     return groupedItems;
189: };

 30:     init: function(config?: any, utils?: any, parsers?: any): void {
 31:         this.SELECTORS = config ? config.SELECTORS : (SYH_CONFIG ? SYH_CONFIG.SELECTORS : null);
 32:         this.UTILS = utils || SYH_UTILS;
 33:         this.PARSERS = parsers || SYH_PARSERS;
 34:     },

336:         .val { font-size: 36px; font-weight: bold; color: #005DF7; }
337:         .lab { font-size: 14px; color: #64748b; text-transform: uppercase; }
338:         table { width: 100%; border-collapse: collapse; margin-top: 20px; }
339:         th, td { padding: 15px; border-bottom: 1px solid #e2e8f0; text-align: center; font-size: 18px; }
340:         th { background: #005DF7; color: white; }
341:         .accent { color: #005DF7; font-weight: bold; }
342:     </style>
343: </head>
344: <body>
345:     <div class="slide">
346:         <h1>📊 Загальна статистика: ${currentBrand}</h1>
347:         <p>Дата: <b>${dateStr}</b></p>
348:         <div style="background: #fff3cd; border-left: 5px solid #ffc107; padding: 15px; font-size: 18px;">
349:             👀 Глядачів, які очікували на старті ефіру: <b>${initialViewers}</b>
350:         </div>
351:         <div class="grid">
352:             <div class="card"><div class="val">${overall.max}</div><div class="lab">Пік онлайн</div></div>
353:             <div class="card"><div class="val">${overall.avg}</div><div class="lab">Середнє</div></div>
354:             <div class="card"><div class="val">${overall.median}</div><div class="lab">Медіана</div></div>
355:             <div class="card"><div class="val">${overall.min}</div><div class="lab">Мінімум</div></div>
356:         </div>
357:     </div>
358: 
359:     <div class="slide">
360:         <h1>📑 Розподіл по блоках (Фази)</h1>
361:         <table>
362:             <tr>
363:                 <th>Фаза</th>
364:                 <th>Середній онлайн</th>
365:                 <th>Пік у фазі</th>

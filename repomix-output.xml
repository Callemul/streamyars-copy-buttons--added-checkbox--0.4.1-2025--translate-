280:     // 9. Логіка ресайзера кроку 3 (дві колонки Telegram / YouTube)
281:     function initStep3Resizer() {
282:         const $divider = $('#step3Divider');
283:         const $container = $('#step3Columns');
284:         const $left = $('#step3Left');
285:         const $right = $('#step3Right');
286: 
287:         if (!$divider.length || !$container.length) return;
288: 
289:         let isDragging = false;
290: 
291:         $divider.on('mousedown', function(e) {
292:             e.preventDefault();
293:             isDragging = true;
294:             $divider.addClass('is-dragging');
295:             $('body').css('user-select', 'none');
296:         });
297: 
298:         $(document).on('mousemove', function(e) {
299:             if (!isDragging) return;
300:             const containerOffset = $container.offset();
301:             const containerWidth = $container.width();
302:             if (!containerOffset || containerWidth <= 0) return;
303: 
304:             const leftWidth = e.pageX - containerOffset.left;
305:             let percent = (leftWidth / containerWidth) * 100;
306:             if (percent < 15) percent = 15;
307:             if (percent > 85) percent = 85;
308: 
309:             $left.css('flex', percent);
310:             $right.css('flex', 100 - percent);
311:         });
312: 
313:         $(document).on('mouseup', function() {
314:             if (isDragging) {
315:                 isDragging = false;
316:                 $divider.removeClass('is-dragging');
317:                 $('body').css('user-select', '');
318: 
319:                 const flexLeft = parseFloat($left.css('flex-grow')) || 1;
320:                 const flexRight = parseFloat($right.css('flex-grow')) || 1;
321:                 const total = flexLeft + flexRight;
322:                 const posPercent = (flexLeft / total) * 100;
323: 
324:                 chrome.storage.local.set({ 'syh_popup_divider_pos': posPercent });
325:             }
326:         });
327:     }
328: 
329:     initStep3Resizer();

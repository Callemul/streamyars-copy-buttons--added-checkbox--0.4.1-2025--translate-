247:     calcStats: function(arr: number[]): StatsSummary {
248:         if (!arr || arr.length === 0) return { min: 0, max: 0, avg: 0, median: 0 };
249:         const sum = arr.reduce((a, b) => a + b, 0);
250:         const avg = Math.round(sum / arr.length);
251:         const max = Math.max(...arr);
252:         const min = Math.min(...arr);
253:         const sorted = [...arr].sort((a, b) => a - b);
254:         const mid = Math.floor(sorted.length / 2);
255:         const median = sorted.length % 2 !== 0 ? sorted[mid] : Math.round((sorted[mid - 1] + sorted[mid]) / 2);

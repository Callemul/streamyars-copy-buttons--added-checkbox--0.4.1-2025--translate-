 15: }
 16: 
 17: export const SYH_COMMENT_ASSISTANT: CommentAssistantInterface = {
 18:     triggerWords: SYH_CONFIG?.TRIGGER_WORDS || ['вопрос'],
 19:     selectors: SYH_CONFIG?.SELECTORS || {
 20:         commentBlock: '[class*="PlatformComment__Wrap"]',
 21:         commentText: '[class*="PlatformCommentShell__ContentSpan"]'
 22:     },
 23: 
 24:     init(config?: any) {
 25:         if (config?.TRIGGER_WORDS) {
 26:             this.triggerWords = config.TRIGGER_WORDS;
 27:         }
 28:         if (config?.SELECTORS) {
 29:             this.selectors = config.SELECTORS;
 30:         }
 31:     },
 32: 
 33:     /**
 34:      * Безпечна екранація HTML-символів
 35:      */
 36:     escapeHTML(str: string): string {
 37:         if (!str) return '';
 38:         return str
 39:             .replace(/&/g, '&amp;')
 40:             .replace(/</g, '&lt;')
 41:             .replace(/>/g, '&gt;')
 42:             .replace(/"/g, '&quot;')
 43:             .replace(/'/g, '&#039;');
 44:     },
 45: 
 46:     /**
 47:      * Створення регулярного виразу з урахуванням кириличних меж слів
 48:      * Використовує Unicode lookbehind/lookahead (?<![\p{L}\p{N}]) та (?![\p{L}\p{N}])
 49:      */
 50:     createTriggerRegExp(word: string): RegExp {
 51:         const escapedWord = word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
 52:         try {
 53:             return new RegExp(`(?<![\\p{L}\\p{N}])(${escapedWord})(?![\\p{L}\\p{N}])`, 'giu');
 54:         } catch (e) {
 55:             // Фолбек для середовищ без підтримки Unicode lookbehind
 56:             return new RegExp(`(^|[^a-zA-Z0-9а-яА-ЯёЁіІїЇєЄґҐ])(${escapedWord})($|[^a-zA-Z0-9а-яА-ЯёЁіІїЇєЄґҐ])`, 'gi');
 57:         }
 58:     },
 59: 
 60:     /**
 61:      * Перевірка чи містить текст хоча б одне тригерне слово
 62:      */
 63:     hasTrigger(text: string): boolean {
 64:         if (!text || !this.triggerWords || this.triggerWords.length === 0) return false;
 65:         return this.triggerWords.some(word => {
 66:             const rx = this.createTriggerRegExp(word);
 67:             return rx.test(text);
 68:         });
 69:     },
 70: 
 71:     /**
 72:      * Підсвічує тригерні слова у тексті за допомогою спец-тегу <mark class="syh-trigger-highlight">
 73:      */
 74:     highlightTriggers(text: string): { highlightedText: string; matchedWords: string[] } {
 75:         if (!text) return { highlightedText: '', matchedWords: [] };
 76:         
 77:         let safeHTML = this.escapeHTML(text);
 78:         const matchedWords: string[] = [];
 79: 
 80:         this.triggerWords.forEach(word => {
 81:             const rx = this.createTriggerRegExp(word);
 82:             safeHTML = safeHTML.replace(rx, (match, p1, p2, p3) => {
 83:                 // Якщо використовувався фолбек-вираз з групами п1/п2/п3
 84:                 const targetWord = p2 || p1 || match;
 85:                 if (!matchedWords.includes(word.toLowerCase())) {
 86:                     matchedWords.push(word.toLowerCase());
 87:                 }
 88:                 const replacement = `<mark class="syh-trigger-highlight" data-syh-trigger="${this.escapeHTML(word.toLowerCase())}">${targetWord}</mark>`;
 89:                 
 90:                 if (p2) {
 91:                     return `${p1}${replacement}${p3}`;
 92:                 }
 93:                 return replacement;
 94:             });
 95:         });
 96: 
 97:         return { highlightedText: safeHTML, matchedWords };
 98:     },
 99: 
100:     /**
101:      * Видаляє підсвічування (повертає чистий текст)
102:      */
103:     stripHighlights(text: string): string {
104:         if (!text) return '';
105:         return text.replace(/<mark class="syh-trigger-highlight"[^>]*>(.*?)<\/mark>/gi, '$1');
106:     },
107: 
108:     /**
109:      * Головна функція обробки елемента коментаря
110:      * @param commentBlock DOM елемент коментаря
111:      * @returns boolean (чи було застосовано підсвічування)
112:      */
113:     processComment(commentBlock: HTMLElement | Element): boolean {
114:         if (!commentBlock) return false;
115: 
116:         const textNode = commentBlock.querySelector(this.selectors.commentText || '[class*="PlatformCommentShell__ContentSpan"]');
117:         if (!textNode) return false;
118: 
119:         // Отримуємо або зберігаємо початковий чистий текст коментаря
120:         let originalText = textNode.getAttribute('data-syh-original-text');
121:         if (originalText === null) {
122:             originalText = textNode.textContent || '';
123:             textNode.setAttribute('data-syh-original-text', originalText);
124:         }
125: 
126:         // Перевіряємо стан чекбокса "Опрацьовано"
127:         const checkbox = commentBlock.querySelector('.syh-checkbox[data-type="comment"]') as HTMLInputElement | null;
128:         const isChecked = checkbox ? checkbox.checked : false;
129: 
130:         // Якщо коментар вже опрацьований (галочка стоїть), то прибираємо підсвічування
131:         if (isChecked) {
132:             textNode.textContent = originalText;
133:             commentBlock.removeAttribute('data-syh-triggered');
134:             return false;
135:         }
136: 
137:         // Якщо галочки немає, перевіряємо на тригерні слова
138:         if (this.hasTrigger(originalText)) {
139:             const { highlightedText, matchedWords } = this.highlightTriggers(originalText);
140:             textNode.innerHTML = highlightedText;
141:             commentBlock.setAttribute('data-syh-triggered', matchedWords.join(','));
142:             return true;
143:         } else {
144:             textNode.textContent = originalText;
145:             commentBlock.removeAttribute('data-syh-triggered');
146:             return false;
147:         }
148:     },

224:     startTracking: function(): void {
225:         const self = this;
226:         
227:         this.intervalId = setInterval(() => {
228:             // KILL SWITCH: Тихе самознищення таймера без виведення помилок у панель
229:             if (typeof chrome !== 'undefined' && chrome.runtime && !chrome.runtime.id) {
230:                 if (self.intervalId) clearInterval(self.intervalId);
231:                 return;
232:             }
233: 
234:             const liveTag = document.querySelector('span[class*="Tags__LiveTag"]');
235:             if (!liveTag) return; 
236: 
237:             const brandNode = document.querySelector('.BrandSelect__BrandNameText-sc-16g9tfx-1') as HTMLElement | null;
238:             if (brandNode) self.currentBrand = brandNode.innerText.trim();
239: 
240:             const timerWrapper = document.querySelector('div[class*="Timer__TimerWrapper"]') as HTMLElement | null;
241:             const timerText = timerWrapper ? timerWrapper.innerText.replace(/\n/g, '').trim() : "0:00";
242: 
243:             const viewerEl = document.querySelector('p[class*="ViewerCount__StatText"]') as HTMLElement | null;
244:             const viewerCount = viewerEl ? parseInt(viewerEl.innerText.trim(), 10) : 0;
245: 
246:             if (isNaN(viewerCount)) return;
247: 
248:             const today = (window as any).SYH_UTILS && typeof (window as any).SYH_UTILS.getTodayDateString === 'function'
249:                 ? (window as any).SYH_UTILS.getTodayDateString()
250:                 : new Date().toLocaleDateString('sv-SE');
251: 
252:             const storage = SYH_STORAGE || ((window as any).SYH_UTILS && (window as any).SYH_UTILS.storage ? (window as any).SYH_UTILS.storage : null);
253:             if (storage) {
254:                 storage.get(['syh_stream_charts'], function(result: any) {
255:                     let db = (result && result.syh_stream_charts) ? result.syh_stream_charts : {};
256:                     
257:                     if (!db[self.currentBrand]) db[self.currentBrand] = {};
258:                     if (!db[self.currentBrand][today]) db[self.currentBrand][today] = { data: [] };
259: 
260:                     const session = db[self.currentBrand][today];
261:                     
262:                     if (session.initial_viewers === undefined && session.data.length === 0) {
263:                         session.initial_viewers = viewerCount;
264:                     }
265: 
266:                     const lastEntry = session.data[session.data.length - 1];
267:                     if (lastEntry && lastEntry.time === timerText) return;
268: 
269:                     session.data.push({
270:                         time: timerText,
271:                         viewers: viewerCount
272:                     });
273: 
274:                     storage.set({ 'syh_stream_charts': db });
275:                 });
276:             }
277:         }, ((SYH_CONFIG as any)?.TIMINGS?.STATS_TRACKING_INTERVAL) || 60000); 
278:     },

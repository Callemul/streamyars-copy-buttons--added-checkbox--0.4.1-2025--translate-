284: $(document).ready(function() {
285:     // Обробники кліку для генерації та копіювання списку питань
286:     $('#processTelegramBtn').click(function() { 
287:         try { 
288:             window.processTelegramData(); 
289:         } catch (e) { 
290:             alert("❌ Помилка:\n" + e.message); 
291:             console.error(e); 
292:         } 
293:     });
294:     
295:     $('#copyResultBtn').click(async function() {
296:         const plainText = $('#finalResultDiv').text(); 
297:         if (!plainText) return;
298: 
299:         const $btn = $(this);
300:         const originalText = $btn.text(); 
301: 
302:         const copyFallback = (txt) => {
303:             const $temp = $("<textarea>"); 
304:             $("body").append($temp); 
305:             $temp.val(txt).select(); 
306:             document.execCommand("copy"); 
307:             $temp.remove(); 
308:         };
309: 
310:         try {
311:             if (navigator.clipboard && navigator.clipboard.writeText) {
312:                 await navigator.clipboard.writeText(plainText);
313:             } else {
314:                 copyFallback(plainText);
315:             }
316:         } catch (err) {
317:             console.warn("Clipboard API failed, using fallback:", err);
318:             copyFallback(plainText);
319:         }
320: 
321:         $btn.text("Скопійовано! ✅"); 
322:         setTimeout(() => $btn.text(originalText), 2000);
323:     });
324: });

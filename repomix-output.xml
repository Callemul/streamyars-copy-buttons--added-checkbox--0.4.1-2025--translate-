161: window.parseAndFilterOldList = function(text, answeredIds) {
162:     // Отримуємо очищувач для очищення вкладених заголовків
163:     const cleaner = (window.SYH_UTILS && window.SYH_UTILS.cleanTelegramHeaders) 
164:         ? window.SYH_UTILS.cleanTelegramHeaders 
165:         : (window.cleanTelegramHeaders || (t => t));
166: 
167:     const messages = [text];
168: 
169:     let allQuestions = [];
170:     let allPrayers = [];
171:     const deletedItems = [];
172: 
173:     const processOldItem = (itemsArray, itemObj, filterIds, id, deletedArr, src) => {
174:         const lines = itemObj.rawLines;
175:         while (lines.length > 0 && lines[0].trim() === "") lines.shift();
176:         if (lines.length === 0) return;
177: 
178:         let author = lines[0].trim();
179:         author = author.replace(/\s*•.*$/, '').trim();
180:         let rawText = lines.slice(1).map(l => l.trimEnd()).join('\n').trim();
181:         if (!author) author = "Анонім";
182: 
183:         // Очищаємо вкладені заголовки всередині блоку тексту питання/молитви
184:         rawText = cleaner(rawText);
185: 
186:         const totalQuestionsInBlock = window.countQuestionsInText(rawText);
187: 
188:         if (filterIds && filterIds.includes(id)) {
189:             deletedArr.push({ originalId: id, author: author, type: 'block', count: totalQuestionsInBlock });
190:             return;
191:         }
192:         
193:         if (rawText.includes('🔹') && filterIds) {
194:             const subIndexesToRemove = filterIds
195:                 .filter(fid => Math.floor(fid) === id)
196:                 .map(fid => {
197:                     const parts = fid.toString().split('.');
198:                     return parts[1] ? parseInt(parts[1], 10) : 0;
199:                 })
200:                 .filter(subIdx => subIdx > 0);
201: 
202:             if (subIndexesToRemove.length > 0) {
203:                 const subQuestions = rawText.split('🔹').map(t => t.trim()).filter(Boolean);
204:                 subIndexesToRemove.forEach(idx => {
205:                     if (subQuestions[idx-1]) deletedArr.push({ originalId: `${id}.${idx}`, author: author, type: 'sub', count: 1 });
206:                 });
207: 
208:                 const filteredSubQuestions = subQuestions.filter((_, idx) => !subIndexesToRemove.includes(idx + 1));
209: 
210:                 if (filteredSubQuestions.length === 0) {
211:                     deletedArr.push({ originalId: id, author: author, type: 'block', count: totalQuestionsInBlock });
212:                     return; 
213:                 } else if (filteredSubQuestions.length === 1) {
214:                     rawText = filteredSubQuestions[0];
215:                 } else {
216:                     rawText = filteredSubQuestions.map(q => `🔹${q}`).join('\n');
217:                 }
218:             }
219:         }
220:         itemsArray.push({ author, text: rawText, source: src });
221:     };
222: 
223:     const parseSection = (sectionText, filterIds, sourceType) => {
224:         const lines = sectionText.split('\n');
225:         const items = [];
226:         let currentItem = null;
227:         let currentCounter = (sourceType === 'old') ? allQuestions.length : allPrayers.length;
228: 
229:         const emojiNumberRegex = /^(?:\d+\uFE0F?\u20E3|🔟)+\s*$/;
230:         const tgHeaderARegex = /^.+?,\s*\[\d{2}\.\d{2}\.\d{4} \d{2}:\d{2}\]\s*$/;
231:         const tgHeaderBRegex = /^\[\d{2}\.\d{2}\.\d{4} \d{2}:\d{2}\]\s*([^:\n]+)(?::\s*(.*))?$/;
232: 
233:         const hasKeycapInRemainingLines = (lines, currentIndex) => {
234:             const regex = /(?:\d+\uFE0F?\u20E3|🔟)/;
235:             for (let i = currentIndex; i < lines.length; i++) {
236:                 if (regex.test(lines[i])) {
237:                     return true;
238:                 }
239:             }
240:             return false;
241:         };
242: 
243:         const finalizeCurrentItem = () => {
244:             if (currentItem) {
245:                 if (currentItem.type === 'telegram') {
246:                     const bodyLines = currentItem.bodyLines;
247:                     if (currentItem.author === null) {
248:                         let firstNonEmptyIdx = -1;
249:                         for (let i = 0; i < bodyLines.length; i++) {
250:                             if (bodyLines[i].trim() !== "") {
251:                                 firstNonEmptyIdx = i;
252:                                 break;
253:                             }
254:                         }
255:                         if (firstNonEmptyIdx !== -1) {
256:                             const firstLine = bodyLines[firstNonEmptyIdx].trim();
257:                             if (firstLine.startsWith('@')) {
258:                                 currentItem.author = window.cleanAuthorName(firstLine);
259:                                 bodyLines.splice(firstNonEmptyIdx, 1);
260:                             } else {
261:                                 currentItem.author = "Питання з чату";
262:                             }
263:                         } else {
264:                             currentItem.author = "Питання з чату";
265:                         }
266:                     }
267:                     currentItem.rawLines = [currentItem.author, ...bodyLines];
268:                 }
269:                 processOldItem(items, currentItem, filterIds, currentCounter, deletedItems, sourceType);
270:             }
271:         };
272: 
273:         lines.forEach((line, idx) => {
274:             const trimmedLine = line.trim();
275:             if (trimmedLine.includes("❓❓❓ВОПРОСЫ")) return;
276:             if (trimmedLine.includes("Віталій Кривко")) return;
277: 
278:             // 1. Перевіряємо, чи це лінія з keycap emoji
279:             if (emojiNumberRegex.test(trimmedLine)) {
280:                 finalizeCurrentItem();
281:                 currentCounter++;
282:                 currentItem = { type: 'keycap', rawLines: [] };
283:                 return;
284:             }
285: 
286:             // 2. Перевіряємо, чи це Telegram-заголовок (Формат A чи B)
287:             const isHeaderA = tgHeaderARegex.test(trimmedLine);
288:             const isHeaderB = tgHeaderBRegex.test(trimmedLine);
289: 
290:             if ((isHeaderA || isHeaderB) && sourceType === 'old' && !hasKeycapInRemainingLines(lines, idx + 1)) {
291:                 finalizeCurrentItem();
292:                 currentCounter++;
293: 
294:                 let author = null;
295:                 const bodyLines = [];
296: 
297:                 if (isHeaderB) {
298:                     const match = trimmedLine.match(tgHeaderBRegex);
299:                     if (match) {
300:                         const trailing = match[2] ? match[2].trim() : "";
301:                         if (trailing) {
302:                             if (trailing.startsWith('@')) {
303:                                 author = window.cleanAuthorName(trailing);
304:                             } else {
305:                                 bodyLines.push(trailing);
306:                             }
307:                         }
308:                     }
309:                 }
310:                 currentItem = { type: 'telegram', author: author, bodyLines: bodyLines };
311:                 return;
312:             }
313: 
314:             // 3. Інакше додаємо до поточного блоку
315:             if (currentItem) {
316:                 if (currentItem.type === 'keycap') {
317:                     currentItem.rawLines.push(line);
318:                 } else if (currentItem.type === 'telegram') {
319:                     currentItem.bodyLines.push(line);
320:                 }
321:             }
322:         });
323: 
324:         finalizeCurrentItem();
325:         return items;
326:     };
327: 
328:     for (const msg of messages) {
329:         const parts = msg.split(/(?:^|\r?\n)\s*🙏+[^\r\n]*(?:МОЛИТ|ПРОХАН)[^\r\n]*/iu);
330:         const questionsText = parts[0] || "";
331:         const prayersText = parts[1] || "";
332: 
333:         if (questionsText.trim()) {
334:             const qs = parseSection(questionsText, answeredIds, 'old');
335:             allQuestions = allQuestions.concat(qs);
336:         }
337:         if (prayersText.trim()) {
338:             const prs = parseSection(prayersText, null, 'pray');
339:             allPrayers = allPrayers.concat(prs);
340:         }
341:     }
342: 
343:     return { questions: allQuestions, prayers: allPrayers, deleted: deletedItems };
344: };

  1: // modules/anti_afk.ts
  2: 
  3: /**
  4:  * ============================================================================
  5:  * STREAMYARD HELPER - ANTI-AFK MODULE (GOLDEN STANDARD: BULLETPROOF + PREVENTIVE)
  6:  * ============================================================================
  7:  * Розроблено за Золотим стандартом проєкту (DEVELOPER_NOTES.md).
  8:  * 
  9:  * Подвійний захист від AFK:
 10:  * 1. Превентивний захист (User Activity Simulation):
 11:  *    Періодично (раз на 3 хвилини) відправляє легку фонову подію `mousemove`,
 12:  *    завдяки чому StreamYard вважає користувача активним і ВЗАГАЛІ НЕ ПОКАЗУЄ вікно AFK.
 13:  * 
 14:  * 2. Броньований (Bulletproof) сканер:
 15:  *    Якщо діалог все ж з'явився, сканує абсолютно всі клікабельні вузли
 16:  *    (button, [role="button"], a, div[tabindex]), ігноруючи специфічні React-класи.
 17:  * ============================================================================
 18:  */
 19: 
 20: export interface I18nAdapterLike {
 21:     getMessage(key: string, fallback?: string): string;
 22: }
 23: 
 24: /**
 25:  * Броньований сканер для виявлення кнопки "Stay in studio"
 26:  */
 27: export function checkAndClickAntiAfk(
 28:     docNode: Document | Element | null = typeof document !== 'undefined' ? document : null,
 29:     i18n?: I18nAdapterLike
 30: ): boolean {
 31:     if (!docNode) return false;
 32: 
 33:     // 1. Пошук контейнера модалки за різними варіантами селекторів
 34:     const dialogSelectors = [
 35:         'div[role="dialog"][aria-label="Are you still there?"]',
 36:         'div[role="dialog"]',
 37:         '[aria-modal="true"]',
 38:         'div[class*="modal"]',
 39:         'div[class*="Dialog"]'
 40:     ];
 41: 
 42:     let modalButtons: Element[] = [];
 43:     for (const selector of dialogSelectors) {
 44:         const modal = docNode.querySelector(selector);
 45:         if (modal) {
 46:             const buttons = Array.from(modal.querySelectorAll('button, [role="button"], a'));
 47:             if (buttons.length > 0) {
 48:                 modalButtons = buttons;
 49:                 break;
 50:             }
 51:         }
 52:     }
 53: 
 54:     // 2. Броньований Fallback: скануємо абсолютно всі клікабельні елементи сторінки
 55:     const candidateButtons = modalButtons.length > 0 
 56:         ? modalButtons 
 57:         : Array.from(docNode.querySelectorAll('button, [role="button"], div[tabindex="0"], a'));
 58: 
 59:     if (candidateButtons.length === 0) {
 60:         return false;
 61:     }
 62: 
 63:     // 3. Варіанти пошукових ключів
 64:     const targetTexts: string[] = [
 65:         'stay in the studio',
 66:         'stay in studio',
 67:         'stay in',
 68:         'still there',
 69:         'залишитися в студії',
 70:         'остаться в студии'
 71:     ];
 72: 
 73:     if (i18n && typeof i18n.getMessage === 'function') {
 74:         const localized = i18n.getMessage('stayInStudio');
 75:         if (localized && localized.trim()) {
 76:             targetTexts.push(localized.trim().toLowerCase());
 77:         }
 78:     } else if (typeof chrome !== 'undefined' && chrome.i18n && typeof chrome.i18n.getMessage === 'function') {
 79:         try {
 80:             const localized = chrome.i18n.getMessage('stayInStudio');
 81:             if (localized && localized.trim()) {
 82:                 targetTexts.push(localized.trim().toLowerCase());
 83:             }
 84:         } catch {
 85:             // ignore
 86:         }
 87:     }
 88: 
 89:     // 4. Пошук відповідності серед усіх елементів
 90:     for (const btn of candidateButtons) {
 91:         const text = (btn.textContent || '').trim().toLowerCase();
 92:         const ariaLabel = (btn.getAttribute('aria-label') || '').trim().toLowerCase();
 93:         const title = (btn.getAttribute('title') || '').trim().toLowerCase();
 94: 
 95:         const isMatch = targetTexts.some(target => 
 96:             text === target || text.includes(target) || 
 97:             ariaLabel === target || ariaLabel.includes(target) ||
 98:             title === target || title.includes(target)
 99:         ) || /stay in (the )?studio/i.test(text) || /still there/i.test(text);
100: 
101:         if (isMatch) {
102:             try {
103:                 console.log("[SYH Anti-AFK] AFK таймаут перехоплено! Натискаю 'Stay in the studio'.");
104:                 (btn as HTMLElement).click();
105:                 return true;
106:             } catch (err) {
107:                 console.warn("[SYH Anti-AFK] Помилка при натисканні кнопки Stay in studio:", err);
108:             }
109:         }
110:     }
111: 
112:     return false;
113: }
114: 
115: /**
116:  * Превентивна імітація активності миші (Preventive User Activity Simulation)
117:  * Запобігає появі вікна AFK взагалі.
118:  */
119: export function simulateUserActivity(): void {
120:     if (typeof document === 'undefined') return;
121:     try {
122:         const event = new MouseEvent('mousemove', {
123:             bubbles: true,
124:             cancelable: true,
125:             clientX: Math.floor(Math.random() * 100) + 10,
126:             clientY: Math.floor(Math.random() * 100) + 10
127:         });
128:         (document.body || document.documentElement || document).dispatchEvent(event);
129:         console.log("[SYH Anti-AFK] Імітація фонової активності користувача виконана.");
130:     } catch (err) {
131:         // ignore
132:     }
133: }
134: 
135: let activeAfkTimer: ReturnType<typeof setInterval> | null = null;
136: let activeActivityTimer: ReturnType<typeof setInterval> | null = null;
137: let activeAfkObserver: MutationObserver | null = null;
138: 
139: export function stopAntiAfk(): void {
140:     if (activeAfkObserver !== null) {
141:         try {
142:             activeAfkObserver.disconnect();
143:         } catch {
144:             // ignore
145:         }
146:         activeAfkObserver = null;
147:     }
148:     if (activeAfkTimer !== null) {
149:         clearInterval(activeAfkTimer);
150:         activeAfkTimer = null;
151:     }
152:     if (activeActivityTimer !== null) {
153:         clearInterval(activeActivityTimer);
154:         activeActivityTimer = null;
155:     }
156:     console.log("[SYH Anti-AFK] Anti-AFK захист зупинено.");
157: }
158: 
159: export function startAntiAfk(
160:     config?: any,
161:     storage?: any,
162:     i18n?: I18nAdapterLike,
163:     customTargetNode?: Element | Document | null
164: ): void {
165:     stopAntiAfk();
166: 
167:     const checkOptionsAndRun = (options?: any) => {
168:         const enabled = options?.anti_afk_enabled !== false;
169:         if (!enabled) {
170:             console.log("[SYH Anti-AFK] Anti-AFK вимкнено у налаштуваннях.");
171:             stopAntiAfk();
172:             return;
173:         }
174: 
175:         const intervalSec = options?.anti_afk_interval_sec || (config?.TIMINGS?.ANTI_AFK_INTERVAL ? config.TIMINGS.ANTI_AFK_INTERVAL / 1000 : 30);
176:         const intervalMs = Math.max(intervalSec * 1000, 5000);
177: 
178:         console.log(`[SYH Anti-AFK] Anti-AFK активовано (Превентивна активність + MutationObserver + Резервний таймер ${intervalSec}с).`);
179: 
180:         const rootNode = customTargetNode || (typeof document !== 'undefined' ? document.body || document.documentElement : null);
181: 
182:         // 1. Початкова перевірка
183:         checkAndClickAntiAfk(typeof document !== 'undefined' ? document : null, i18n);
184: 
185:         // 2. Превентивна імітація активності кожні 2.5 хвилини (150,000 мс)
186:         simulateUserActivity();
187:         activeActivityTimer = setInterval(simulateUserActivity, 150000);
188: 
189:         // 3. MutationObserver перехоплення
190:         if (rootNode && typeof MutationObserver !== 'undefined') {
191:             try {
192:                 activeAfkObserver = new MutationObserver((mutations) => {
193:                     for (const mutation of mutations) {
194:                         if (mutation.addedNodes && mutation.addedNodes.length > 0) {
195:                             const clicked = checkAndClickAntiAfk(typeof document !== 'undefined' ? document : null, i18n);
196:                             if (clicked) break;
197:                         }
198:                     }
199:                 });
200:                 activeAfkObserver.observe(rootNode, { childList: true, subtree: true });
201:             } catch (err) {
202:                 console.warn("[SYH Anti-AFK] Помилка старту MutationObserver:", err);
203:             }
204:         }
205: 
206:         // 4. Резервний таймер
207:         activeAfkTimer = setInterval(() => {
208:             try {
209:                 if (typeof chrome !== 'undefined' && chrome.runtime && !chrome.runtime.id) {
210:                     stopAntiAfk();
211:                     return;
212:                 }
213:             } catch {
214:                 stopAntiAfk();
215:                 return;
216:             }
217: 
218:             checkAndClickAntiAfk(typeof document !== 'undefined' ? document : null, i18n);
219:         }, intervalMs);
220:     };
221: 
222:     if (storage && typeof storage.get === 'function') {
223:         storage.get(['syh_options'], (data: any) => {
224:             checkOptionsAndRun(data?.syh_options);
225:         });
226: 
227:         if (typeof storage.onChanged === 'function') {
228:             storage.onChanged((changes: any) => {
229:                 if (changes.syh_options) {
230:                     checkOptionsAndRun(changes.syh_options.newValue);
231:                 }
232:             });
233:         }
234:     } else {
235:         checkOptionsAndRun();
236:     }
237: }
238: 
239: export const SYH_ANTI_AFK = {
240:     checkAndClickAntiAfk,
241:     simulateUserActivity,
242:     startAntiAfk,
243:     stopAntiAfk
244: };
245: 
246: if (typeof window !== 'undefined') {

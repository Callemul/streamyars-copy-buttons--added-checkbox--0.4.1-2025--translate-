 50: 
 51:     waitForElement: function(selector: string, timeout = 3000): Promise<Element> {
 52:         return new Promise((resolve, reject) => {
 53:             const interval = 100;
 54:             let elapsedTime = 0;
 55:             const timer = setInterval(() => {
 56:                 const element = document.querySelector(selector);
 57:                 if (element && $(element).is(':visible')) {
 58:                     clearInterval(timer);
 59:                     resolve(element);
 60:                 }
 61:                 elapsedTime += interval;
 62:                 if (elapsedTime >= timeout) {
 63:                     clearInterval(timer);
 64:                     reject(new Error(`Element [${selector}] not found or not visible within ${timeout}ms`));
 65:                 }
 66:             }, interval);
 67:         });
 68:     },
 69: 
 70:     waitForElementToDisappear: function(selector: string, timeout = 3000): Promise<void> {
 71:         return new Promise((resolve, reject) => {
 72:             const interval = 100;
 73:             let elapsedTime = 0;
 74:             const timer = setInterval(() => {
 75:                 if (!document.querySelector(selector)) {
 76:                     clearInterval(timer);
 77:                     resolve();
 78:                 }
 79:                 elapsedTime += interval;
 80:                 if (elapsedTime >= timeout) {
 81:                     clearInterval(timer);
 82:                     reject(new Error(`Element ${selector} did not disappear within ${timeout}ms`));
 83:                 }
 84:             }, interval);
 85:         });
 86:     },
 87: 
 88:     waitForNewBanner: function(bannerText: string, timeout = 5000): Promise<Element> {
 89:         return new Promise((resolve, reject) => {
 90:             const interval = 100;
 91:             let elapsedTime = 0;
 92:             const timer = setInterval(() => {
 93:                 const selector = this.SELECTORS?.bannerText || '[class*="Banner__BannerText"]';
 94:                 const banners = document.querySelectorAll(selector);
 95:                 for (const banner of banners) {
 96:                     if (banner.textContent?.trim() === bannerText.trim()) {
 97:                         clearInterval(timer);
 98:                         resolve(banner);
 99:                         return;
100:                     }
101:                 }
102:                 
103:                 elapsedTime += interval;
104:                 if (elapsedTime >= timeout) {
105:                     clearInterval(timer);
106:                     reject(new Error(`New banner with text "${bannerText}" did not appear within ${timeout}ms`));
107:                 }
108:             }, interval);
109:         });
110:     },
111: 
112:     clickElementByText: function(text: string, timeout = 2000): Promise<void> {
113:         return new Promise((resolve) => {
114:             const interval = 100;
115:             let elapsedTime = 0;
116:             const timer = setInterval(() => {
117:                 const xpath = `//*[contains(text(), '${text}')]`;
118:                 const matchingElement = document.evaluate(xpath, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue as HTMLElement | null;
119: 
120:                 if (matchingElement && $(matchingElement).is(':visible')) {
121:                     matchingElement.click();
122:                     clearInterval(timer);
123:                     resolve();
124:                 }
125:                 
126:                 elapsedTime += interval;
127:                 if (elapsedTime >= timeout) {
128:                     clearInterval(timer);
129:                     console.warn(`SYH: Element with text "${text}" not found.`);
130:                     resolve();
131:                 }
132:             }, interval);
133:         });
134:     },
135: 
136:     // Розумний крос-пошук: точний збіг, двостороння транслітерація, нечіткий фаззі-пошук та автоматична зміна розкладки
137:     smartSearch: function(query: string | null | undefined, targetText: string | null | undefined): boolean {
138:         if (!query) return true;
139:         if (!targetText) return false;
140: 
141:         // 1. Створюємо "Супер-рядок" цільового тексту, який містить всі його варіації
142:         const rawTarget = targetText.toLowerCase();
143:         const normTarget = this.normalizeText(rawTarget);
144:         const transTarget = this.transliterate(rawTarget);
145:         const layoutTarget = this.switchKeyboardLayout(rawTarget);
146:         const fuzzyTarget = this.toFuzzy(rawTarget);
147:         const fuzzyTransTarget = this.toFuzzy(transTarget);
148: 
149:         const fullTarget = normTarget + " " + transTarget + " " + layoutTarget + " " + fuzzyTarget + " " + fuzzyTransTarget;
150: 
151:         const queryWords = query.toLowerCase().split(/\s+/).filter(Boolean);
152: 
153:         return queryWords.every(word => {
154:             // 2. Створюємо всі варіації для кожного слова з пошукового запиту
155:             const normWord = this.normalizeText(word);
156:             const transWord = this.transliterate(word);
157:             const layoutWord = this.switchKeyboardLayout(word);
158:             const fuzzyWord = this.toFuzzy(word);
159: 
160:             // 3. Якщо хоча б одна варіація слова є в Супер-рядку — це збіг
161:             return fullTarget.includes(normWord) || 
162:                    fullTarget.includes(transWord) || 
163:                    fullTarget.includes(layoutWord) ||
164:                    (fuzzyWord && fullTarget.includes(fuzzyWord));
165:         });
166:     },
167: 
168:     normalizeText: function(str: string | null | undefined): string {
169:         if (!str) return "";
170:         let normalized = str.toLowerCase().trim();
171:         const replacementMap: Record<string, string> = {
172:             'a': 'а', 'e': 'е', 'o': 'о', 'i': 'і', 'c': 'с', 'p': 'р', 'x': 'х', 'y': 'у', 't': 'т', 'h': 'н'
173:         };
174:         for (const char in replacementMap) {
175:             normalized = normalized.replaceAll(char, replacementMap[char]);
176:         }
177:         return normalized;
178:     },
179: 
180:     transliterate: function(str: string | null | undefined): string {
181:         if (!str) return "";
182:         // Картування з підтримкою дифтонгів та гнучкої транслітерації
183:         const map: Record<string, string> = {
184:             'shch':'шч','ch':'ч','sh':'ш','zh':'ж','ts':'ц','tz':'ц','cz':'ц','kh':'х','ph':'ф','th':'т',
185:             'ya':'я','ia':'я','ja':'я','yu':'ю','iu':'ю','ju':'ю','ye':'є','ie':'є','je':'є','yo':'ё','jo':'йо',
186:             'ai':'ай','ay':'ай','aj':'ай','ei':'ей','ey':'ей','ej':'ей','oi':'ой','oy':'ой','oj':'ой','ui':'уй','uy':'уй','uj':'уй',
187:             'a':'а','b':'б','v':'в','g':'г','d':'д','e':'е','z':'з','i':'и','y':'й','k':'к','l':'л','m':'м','n':'н','o':'о','p':'п','r':'р','s':'с','t':'т','u':'у','f':'ф','h':'х',
188:             'c':'ц','w':'в','x':'кс','q':'к','j':'дж'
189:         };
190:         let res = "";
191:         let i = 0;
192:         const s = str.toLowerCase();
193:         while (i < s.length) {
194:             if (i <= s.length - 4 && map[s.substring(i, i + 4)]) {
195:                 res += map[s.substring(i, i + 4)];
196:                 i += 4;
197:             } else if (i <= s.length - 2 && map[s.substring(i, i + 2)]) {
198:                 res += map[s.substring(i, i + 2)];
199:                 i += 2;
200:             } else if (map[s[i]]) {
201:                 res += map[s[i]];
202:                 i++;
203:             } else {
204:                 res += s[i];
205:                 i++;
206:             }
207:         }
208:         return this.normalizeText(res);
209:     },
210: 
211:     // Фонологічна уніфікація голосних та голосних/приголосних варіацій для нечіткого пошуку
212:     toFuzzy: function(str: string | null | undefined): string {
213:         if (!str) return "";
214:         let s = str.toLowerCase().trim();
215: 
216:         const multiMap: [string, string][] = [
217:             ['shch', 'щ'], ['ch', 'ч'], ['sh', 'ш'], ['zh', 'ж'],
218:             ['ts', 'ц'], ['tz', 'ц'], ['cz', 'ц'],
219:             ['kh', 'х'], ['ph', 'ф'], ['th', 'т'],
220:             ['ya', 'я'], ['ia', 'я'], ['ja', 'я'],
221:             ['yu', 'ю'], ['iu', 'ю'], ['ju', 'ю'],
222:             ['ye', 'е'], ['ie', 'е'], ['je', 'е'],
223:             ['yo', 'е'], ['jo', 'е'],
224:             ['ai', 'аи'], ['ay', 'аи'], ['aj', 'аи'],
225:             ['ei', 'еи'], ['ey', 'еи'], ['ej', 'еи'],
226:             ['oi', 'ои'], ['oy', 'ои'], ['oj', 'ои'],
227:             ['ui', 'уи'], ['uy', 'уи'], ['uj', 'уи'],
228:             ['yi', 'и'], ['yy', 'и'], ['yj', 'и']
229:         ];
230: 
231:         for (const [pattern, replacement] of multiMap) {
232:             s = s.replaceAll(pattern, replacement);
233:         }
234: 
235:         const singleMap: Record<string, string> = {
236:             'a': 'а', 'b': 'б', 'v': 'в', 'w': 'в', 'g': 'г', 'd': 'д', 'e': 'е',
237:             'z': 'з', 'i': 'и', 'y': 'и', 'j': 'и', 'k': 'к', 'l': 'л', 'm': 'м',
238:             'n': 'н', 'o': 'о', 'p': 'п', 'r': 'р', 's': 'с', 't': 'т', 'u': 'у',
239:             'f': 'ф', 'h': 'х', 'c': 'с', 'q': 'к', 'x': 'кс',
240:             'й': 'и', 'і': 'и', 'ї': 'и', 'ы': 'и',
241:             'є': 'е', 'ё': 'е', 'э': 'е',
242:             'ь': '', 'ъ': '', '\'': ''
243:         };
244: 
245:         let res = "";
246:         for (let i = 0; i < s.length; i++) {
247:             const char = s[i];
248:             res += singleMap[char] !== undefined ? singleMap[char] : char;
249:         }
250: 
251:         return res;
252:     },
253: 
254:     switchKeyboardLayout: function(str: string | null | undefined): string {
255:         if (!str) return "";
256:         const layoutMap: Record<string, string> = {
257:             'q':'й','w':'ц','e':'у','r':'к','t':'е','y':'н','u':'г','i':'ш','o':'щ','p':'з','[':'х',']':'ї',
258:             'a':'ф','s':'і','d':'в','f':'а','g':'п','h':'р','j':'о','k':'л','l':'д',';':'ж','\'':'є',
259:             'z':'я','x':'ч','c':'с','v':'м','b':'и','n':'т','m':'ь',',':'б','.':'ю'
260:         };
261:         let res = "";
262:         const s = str.toLowerCase();
263:         for (let i = 0; i < s.length; i++) {
264:             res += layoutMap[s[i]] || s[i];
265:         }
266:         return this.normalizeText(res);
267:     },
268: 
269:     saveBannerCategory: function(text: string, type: string): Promise<void> {
270:         return new Promise(resolve => {
271:             if (!this.storage) {
272:                 console.error("SYH_UTILS: Не знайдено адаптер сховища!");
273:                 resolve();
274:                 return;
275:             }
276: 
277:             this.storage.get(['syh_banner_categories'], (result: Record<string, any>) => {
278:                 const db = result.syh_banner_categories || {};
279:                 db[text] = type;
280:                 this.storage.set({ 'syh_banner_categories': db }, resolve);
281:             });
282:         });
283:     },
284: 
285:     cleanTelegramHeaders: function(text: string | null | undefined): string {
286:         if (!text) return "";
287:         const tgHeaderRegex = /(?:^|\r?\n)\s*\[\d{2}\.\d{2}\.\d{4}\s+\d{2}:\d{2}\](?:[^\r\n:]*:\s*|[^\r\n]*(?=\r?\n|$))/g;
288:         return text.replace(tgHeaderRegex, (_match, offset) => {
289:             return offset === 0 ? "" : "\n";
290:         }).trim();
291:     }
292: };

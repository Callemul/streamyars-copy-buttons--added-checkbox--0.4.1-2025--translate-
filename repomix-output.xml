  1: // youtube/yt_events.ts
  2: import { YT_SELECTORS } from './yt_selectors.ts';
  3: import { extractCommentData, restoreButtonState, restoreCheckboxState } from './yt_ui.ts';
  4: import { SYH_STORAGE } from '../modules/storage.ts';
  5: 
  6: export interface YTCollectedItem {
  7:     id: string;
  8:     author: string;
  9:     text: string;
 10:     type: 'question' | 'prayer';
 11:     timestamp: number;
 12:     videoId: string;
 13: }
 14: 
 15: export function getVideoId(): string {
 16:     if (typeof window === 'undefined') return '';
 17:     try {
 18:         const urlParams = new URLSearchParams(window.location.search);
 19:         return urlParams.get('v') || '';
 20:     } catch {
 21:         return '';
 22:     }
 23: }
 24: 
 25: /**
 26:  * Копіює текст у буфер обміну з фолбеком
 27:  */
 28: export async function copyToClipboard(text: string): Promise<boolean> {
 29:     try {
 30:         if (navigator.clipboard && navigator.clipboard.writeText) {
 31:             await navigator.clipboard.writeText(text);
 32:             return true;
 33:         }
 34:     } catch (err) {
 35:         console.warn('[SYH YT] Clipboard API error, trying execCommand:', err);
 36:     }
 37: 
 38:     try {
 39:         const textarea = document.createElement('textarea');
 40:         textarea.value = text;
 41:         textarea.style.position = 'fixed';
 42:         textarea.style.opacity = '0';
 43:         document.body.appendChild(textarea);
 44:         textarea.select();
 45:         const success = document.execCommand('copy');
 46:         document.body.removeChild(textarea);
 47:         return success;
 48:     } catch (err) {
 49:         console.error('[SYH YT] Copy failed:', err);
 50:         return false;
 51:     }
 52: }
 53: 
 54: /**
 55:  * Зберігає збираний коментар у syh_yt_collected
 56:  */
 57: export function saveCollectedItem(
 58:     item: YTCollectedItem,
 59:     collectedList: YTCollectedItem[]
 60: ): YTCollectedItem[] {
 61:     const index = collectedList.findIndex(i => i.id === item.id);
 62:     let updated: YTCollectedItem[];
 63:     if (index >= 0) {
 64:         updated = [...collectedList];
 65:         updated[index] = item;
 66:     } else {
 67:         updated = [item, ...collectedList];
 68:     }
 69:     SYH_STORAGE.set({ syh_yt_collected: updated });
 70:     return updated;
 71: }
 72: 
 73: /**
 74:  * Налаштовує обробники подій для кнопок, чекбоксу та ПКМ коментаря
 75:  */
 76: export function bindYTEvents(
 77:     commentNode: Element,
 78:     commentId: string,
 79:     caches: {
 80:         buttonStates: Record<string, 'question' | 'prayer'>;
 81:         checkboxStates: Record<string, { checked: boolean; timestamp: number }>;
 82:         collectedList: YTCollectedItem[];
 83:     }
 84: ): void {
 85:     if (!commentNode || (commentNode as HTMLElement).dataset.syhEventsBound === 'true') {
 86:         return;
 87:     }
 88:     (commentNode as HTMLElement).dataset.syhEventsBound = 'true';
 89: 
 90:     const btnQuestion = commentNode.querySelector('.syh-yt-btn-question') as HTMLButtonElement | null;
 91:     const btnPrayer = commentNode.querySelector('.syh-yt-btn-prayer') as HTMLButtonElement | null;
 92:     const btnCopy = commentNode.querySelector('.syh-yt-btn-copy') as HTMLButtonElement | null;
 93:     const checkbox = commentNode.querySelector('.syh-yt-checkbox') as HTMLInputElement | null;
 94:     const bodyEl = commentNode.querySelector(YT_SELECTORS.commentBody) as HTMLElement | null;
 95: 
 96:     // Спільна функція установки чекбоксу при додаванні
 97:     const autoCheck = () => {
 98:         if (!checkbox) return;
 99:         checkbox.checked = true;
100:         commentNode.classList.add('syh-yt-comment-checked');
101:         caches.checkboxStates[commentId] = {
102:             checked: true,
103:             timestamp: Date.now()
104:         };
105:         SYH_STORAGE.set({ syh_yt_checkbox_state: caches.checkboxStates });
106:     };
107: 
108:     // 1. Клік "Додати до питань"
109:     if (btnQuestion) {
110:         btnQuestion.addEventListener('click', async (e) => {
111:             e.stopPropagation();
112:             const { author, text } = extractCommentData(commentNode);
113:             const formatted = `@${author}\n\n${text}`;
114:             await copyToClipboard(formatted);
115: 
116:             // Оновлення кнопок
117:             btnQuestion.innerText = 'Скопійовано';
118:             btnQuestion.dataset.state = 'added';
119:             if (btnPrayer) {
120:                 btnPrayer.dataset.state = '';
121:                 btnPrayer.innerText = 'Додати до молитов';
122:             }
123: 
124:             setTimeout(() => {
125:                 btnQuestion.innerText = 'Додано до питань';
126:             }, 1500);
127: 
128:             // Кеш кнопок
129:             caches.buttonStates[commentId] = 'question';
130:             SYH_STORAGE.set({ syh_yt_button_states: caches.buttonStates });
131: 
132:             // Збереження у зібрані
133:             const item: YTCollectedItem = {
134:                 id: commentId,
135:                 author,
136:                 text,
137:                 type: 'question',
138:                 timestamp: Date.now(),
139:                 videoId: getVideoId()
140:             };
141:             caches.collectedList = saveCollectedItem(item, caches.collectedList);
142: 
143:             // Авто-чекбокс
144:             autoCheck();
145:         });
146:     }
147: 
148:     // 2. Клік "Додати до молитов"
149:     if (btnPrayer) {
150:         btnPrayer.addEventListener('click', async (e) => {
151:             e.stopPropagation();
152:             const { author, text } = extractCommentData(commentNode);
153:             const formatted = `@${author}\n\n${text}`;
154:             await copyToClipboard(formatted);
155: 
156:             // Оновлення кнопок
157:             btnPrayer.innerText = 'Скопійовано';
158:             btnPrayer.dataset.state = 'added';
159:             if (btnQuestion) {
160:                 btnQuestion.dataset.state = '';
161:                 btnQuestion.innerText = 'Додати до питань';
162:             }
163: 
164:             setTimeout(() => {
165:                 btnPrayer.innerText = 'Додано до молитов';
166:             }, 1500);
167: 
168:             // Кеш кнопок
169:             caches.buttonStates[commentId] = 'prayer';
170:             SYH_STORAGE.set({ syh_yt_button_states: caches.buttonStates });
171: 
172:             // Збереження у зібрані
173:             const item: YTCollectedItem = {
174:                 id: commentId,
175:                 author,
176:                 text,
177:                 type: 'prayer',
178:                 timestamp: Date.now(),
179:                 videoId: getVideoId()
180:             };
181:             caches.collectedList = saveCollectedItem(item, caches.collectedList);
182: 
183:             // Авто-чекбокс
184:             autoCheck();
185:         });
186:     }
187: 
188:     // 3. Клік 📄 (копіювати)
189:     if (btnCopy) {
190:         btnCopy.addEventListener('click', async (e) => {
191:             e.stopPropagation();
192:             const { author, text } = extractCommentData(commentNode);
193:             const formatted = `@${author}\n\n${text}`;
194:             const success = await copyToClipboard(formatted);
195: 
196:             const origText = btnCopy.innerText;
197:             btnCopy.innerText = success ? '✓' : '❌';
198:             btnCopy.classList.add('syh-copied-flash');
199:             setTimeout(() => {
200:                 btnCopy.innerText = origText;
201:                 btnCopy.classList.remove('syh-copied-flash');
202:             }, 1200);
203:         });
204:     }
205: 
206:     // 4. Зміна Checkbox
207:     if (checkbox) {
208:         checkbox.addEventListener('change', (e) => {
209:             e.stopPropagation();
210:             const isChecked = checkbox.checked;
211:             if (isChecked) {
212:                 commentNode.classList.add('syh-yt-comment-checked');
213:             } else {
214:                 commentNode.classList.remove('syh-yt-comment-checked');
215:             }
216:             caches.checkboxStates[commentId] = {
217:                 checked: isChecked,
218:                 timestamp: Date.now()
219:             };
220:             SYH_STORAGE.set({ syh_yt_checkbox_state: caches.checkboxStates });
221:         });
222:     }
223: 
224:     // 5. ПКМ на #body (тіло коментаря) — тогл чекбоксу
225:     if (bodyEl && checkbox) {
226:         bodyEl.addEventListener('contextmenu', (e) => {
227:             e.preventDefault();
228:             e.stopPropagation();
229:             checkbox.checked = !checkbox.checked;
230:             checkbox.dispatchEvent(new Event('change', { bubbles: true }));
231:         });
232:     }
233: }

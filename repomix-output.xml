145: export function filterStarredComments(): void {
146:     const selectors = SYH_UI.SELECTORS || SYH_CONFIG.SELECTORS;
147:     const $commentList = $(selectors.starredList);
148:     if (!$commentList.length) return;
149: 
150:     const activeFilter = SYH_UI.activeFilter;
151:     const searchQuery = SYH_UI.searchQuery;
152: 
153:     const safeHtmlUpdate = (jqEl: JQuery, newHtml: string) => {
154:         if (jqEl.length && jqEl.html() !== newHtml) jqEl.html(newHtml);
155:     };
156:     const safeTextUpdate = (selector: string, newText: string) => {
157:         const el = $(selector);
158:         if (el.length && el.text() !== newText) el.text(newText);
159:     };
160: 
161:     let sortedTexts: string[] = [];
162:     let grouped: Record<string, string[]> = {};
163:     
164:     SYH_UI.prayersCache.forEach((p: PrayerItem) => {
165:         if (activeFilter === 'prayer' && p.type !== 'prayer') return;
166:         if (activeFilter === 'question' && p.type !== 'question') return;
167:         if (activeFilter === 'other') return; 
168:         
169:         const cleanAuthor = p.author.replace(/^@+/, '');
170:         if (!grouped[cleanAuthor]) grouped[cleanAuthor] = [];
171:         grouped[cleanAuthor].push(p.text);
172:     });
173: 
174:     for (let author in grouped) {
175:         sortedTexts = sortedTexts.concat(grouped[author]);
176:     }
177: 
178:     if ($commentList.css('display') !== 'flex') $commentList.css({ 'display': 'flex', 'flex-direction': 'column' });
179: 
180:     let visibleCount = 0;
181:     let countAbsolute = { all: 0, question: 0, prayer: 0, other: 0 };
182:     let countSearch = { all: 0, question: 0, prayer: 0, other: 0 };
183: 
184:     $commentList.find('> li').each(function() {
185:         const $li = $(this);
186:         
187:         if ($li.attr('data-syh-deleted') === 'true') return;
188: 
189:         const $commentWrap = $li.find(selectors.commentBlock);
190:         if (!$commentWrap.length) return;
191: 
192:         const originalText = $commentWrap.find(selectors.commentText).text();
193:         const authorText = $commentWrap.find(selectors.commentAuthor).text();
194:         
195:         const foundInCache = SYH_UI.prayersCache.find((item: PrayerItem) => item.text === originalText);
196:         const commentType = foundInCache ? foundInCache.type : 'none';
197:         
198:         updateCommentVisuals($commentWrap, commentType);
199:         
200:         countAbsolute.all++;
201:         if (commentType === 'question') countAbsolute.question++;
202:         else if (commentType === 'prayer') countAbsolute.prayer++;
203:         else countAbsolute.other++;
204:         
205:         let matchesSearch = true;
206:         if (searchQuery) {
207:             const combinedTarget = originalText + " " + authorText;
208:             matchesSearch = SYH_UTILS && typeof SYH_UTILS.smartSearch === 'function'
209:                 ? SYH_UTILS.smartSearch(searchQuery, combinedTarget)
210:                 : ((window as any).SYH_UTILS && typeof (window as any).SYH_UTILS.smartSearch === 'function'
211:                     ? (window as any).SYH_UTILS.smartSearch(searchQuery, combinedTarget)
212:                     : combinedTarget.toLowerCase().includes(searchQuery.toLowerCase()));
213:         }
214: 
215:         if (matchesSearch) {
216:             countSearch.all++;
217:             if (commentType === 'question') countSearch.question++;
218:             else if (commentType === 'prayer') countSearch.prayer++;
219:             else countSearch.other++;
220:         }
221: 
222:         let isVisible = matchesSearch;
223: 
224:         if (activeFilter === 'prayer' && commentType !== 'prayer') isVisible = false;
225:         if (activeFilter === 'question' && commentType !== 'question') isVisible = false;
226:         if (activeFilter === 'other' && commentType !== 'none') isVisible = false;
227: 
228:         if (isVisible) {
229:             if ($li.css('display') === 'none') $li.show();
230:             const exactOrder = sortedTexts.indexOf(originalText);
231:             const targetOrder = exactOrder !== -1 ? exactOrder : 9999;
232:             if (parseInt($li.css('order')) !== targetOrder) $li.css('order', targetOrder);
233:             visibleCount++;
234:         } else {
235:             if ($li.css('display') !== 'none') $li.hide();
236:             if (parseInt($li.css('order')) !== 9999) $li.css('order', 9999); 
237:         }
238:     });
239: 
240:     const $otherTabBtn = $('#syh-comment-filter-other');
241:     if (countAbsolute.other === 0) {
242:         if ($otherTabBtn.css('display') !== 'none') $otherTabBtn.hide();
243:         
244:         if (SYH_UI.activeFilter === 'other') {
245:             SYH_UI.activeFilter = 'all';
246:             $('.syh-filter-btn').removeClass('active');
247:             $('#syh-comment-filter-all').addClass('active');
248:             return filterStarredComments(); 
249:         }
250:     } else {
251:         if ($otherTabBtn.css('display') === 'none') $otherTabBtn.css('display', 'inline-flex');
252:     }
253: 
254:     safeTextUpdate('#syh-comment-filter-all .tab-count', ` (${countAbsolute.all})`);
255:     safeTextUpdate('#syh-comment-filter-question .tab-count', ` (${countAbsolute.question})`);
256:     safeTextUpdate('#syh-comment-filter-prayer .tab-count', ` (${countAbsolute.prayer})`);
257:     safeTextUpdate('#syh-comment-filter-other .tab-count', ` (${countAbsolute.other})`);
258: 
259:     const $emptyState = $('#syh-empty-state-msg');
260:     const $emptyQuery = $('#syh-empty-query');
261:     const $emptySuggestion = $('#syh-empty-suggestion');
262: 
263:     if (visibleCount === 0) {
264:         let messageHTML: string;
265:         
266:         if (searchQuery) {
267:             messageHTML = `Нічого не знайдено за запитом: <b style="color: #e74c3c;">"${searchQuery}"</b><br><br>
268:             <a href="#" id="syh-empty-clear-link" style="color: #005DF7; text-decoration: none; font-weight: bold; background: #e3f2fd; padding: 5px 10px; border-radius: 4px;">Скинути пошук ✕</a>`;
269:             
270:             let suggestions: string[] = [];
271:             if (activeFilter !== 'all' && countSearch.all > 0) {
272:                 if (countSearch.question > 0 && activeFilter !== 'question') suggestions.push(`<a href="#" class="syh-switch-tab" data-filter="question" style="color: #f39c12; text-decoration: underline;">❓ Питання (${countSearch.question})</a>`);
273:                 if (countSearch.prayer > 0 && activeFilter !== 'prayer') suggestions.push(`<a href="#" class="syh-switch-tab" data-filter="prayer" style="color: #f39c12; text-decoration: underline;">🙏 Молитви (${countSearch.prayer})</a>`);
274:                 if (countSearch.other > 0 && activeFilter !== 'other') suggestions.push(`<a href="#" class="syh-switch-tab" data-filter="other" style="color: #f39c12; text-decoration: underline;">📝 Інші (${countSearch.other})</a>`);
275:             }
276:             
277:             if (suggestions.length > 0) {
278:                 safeHtmlUpdate($emptySuggestion, `Знайдено в інших категоріях: ` + suggestions.join(', '));
279:                 if ($emptySuggestion.css('display') === 'none') $emptySuggestion.show();
280:                 
281:                 $('.syh-switch-tab').off('click').on('click', function(e) {
282:                     e.preventDefault();
283:                     const filter = $(this).data('filter');
284:                     $(`.syh-filter-btn[data-filter="${filter}"]`).click();
285:                 });
286:             } else {
287:                 if ($emptySuggestion.css('display') !== 'none') $emptySuggestion.hide();
288:             }
289:         } else {
290:             if ($emptySuggestion.css('display') !== 'none') $emptySuggestion.hide();
291:             const filterNames: Record<string, string> = { 
292:                 'all': 'списку коментарів', 
293:                 'question': 'категорії "❓ Питання"', 
294:                 'prayer': 'категорії "🙏 Молитви"', 
295:                 'other': 'категорії "📝 Інші"' 
296:             };
297:             messageHTML = `<span style="color: #777;">Тут ще немає коментарів для ${filterNames[activeFilter] || 'списку'}</span>`;
298:         }
299: 
300:         safeHtmlUpdate($emptyQuery, messageHTML);
301:         if ($emptyState.css('display') === 'none') $emptyState.show();
302:     } else {
303:         if ($emptyState.css('display') !== 'none') $emptyState.hide();
304:         if ($emptySuggestion.css('display') !== 'none') $emptySuggestion.hide();
305:     }
306: }

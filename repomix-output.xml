 1: /**
 2:  * StreamYard Helper - Background Service Worker
 3:  * Обробка фонових задач, подій встановлення/оновлення та комунікації між компонентами.
 4:  */
 5: 
 6: // Подія встановлення або оновлення розширення
 7: if (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.onInstalled) {
 8:   chrome.runtime.onInstalled.addListener((details: chrome.runtime.InstalledDetails) => {
 9:     console.log(`[Service Worker] StreamYard Helper installed/updated: ${details.reason}`);
10:     
11:     if (details.reason === 'install') {
12:       // Ініціалізація дефолтних налаштувань у сховищі при першому встановленні
13:       if (chrome.storage && chrome.storage.local) {
14:         chrome.storage.local.set({
15:           syh_installed_at: new Date().toISOString(),
16:           syh_version: chrome.runtime.getManifest().version
17:         });
18:       }
19:     }
20:   });
21: }
22: 
23: // Обробник повідомлень від content scripts та popup
24: if (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.onMessage) {
25:   chrome.runtime.onMessage.addListener((message: any, sender: chrome.runtime.MessageSender, sendResponse: (response?: any) => void) => {
26:     if (!message || typeof message !== 'object') return false;
27: 
28:     switch (message.type) {
29:       case 'PING':
30:         sendResponse({ status: 'ok', response: 'PONG', timestamp: Date.now() });
31:         return false;
32: 
33:       case 'GET_VERSION':
34:         const manifest = chrome.runtime.getManifest();
35:         sendResponse({ version: manifest.version, name: manifest.name });
36:         return false;
37: 
38:       case 'BACKGROUND_LOG':
39:         console.log(`[Content/Popup Log]:`, message.data);
40:         sendResponse({ status: 'logged' });
41:         return false;
42: 
43:       default:
44:         // Якщо тип повідомлення не розпізнано фоновим скриптом
45:         return false;
46:     }
47:   });
48: }

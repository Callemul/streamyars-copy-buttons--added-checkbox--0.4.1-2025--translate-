<file path="options/options.css">
  1: :root {
  2:     --bg-color: #f4f6f8;
  3:     --card-bg: #ffffff;
  4:     --text-primary: #1f2937;
  5:     --text-secondary: #6b7280;
  6:     --primary-color: #2563eb;
  7:     --primary-hover: #1d4ed8;
  8:     --secondary-bg: #e5e7eb;
  9:     --secondary-hover: #d1d5db;
 10:     --border-color: #e5e7eb;
 11:     --danger-color: #ef4444;
 12:     --danger-hover: #dc2626;
 13:     --success-color: #10b981;
 14:     --radius: 10px;
 15:     --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
 16: }
 17: 
 18: * {
 19:     box-sizing: border-box;
 20:     margin: 0;
 21:     padding: 0;
 22: }
 23: 
 24: body {
 25:     font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
 26:     background-color: var(--bg-color);
 27:     color: var(--text-primary);
 28:     line-height: 1.5;
 29:     padding: 24px;
 30: }
 31: 
 32: .options-container {
 33:     max-width: 960px;
 34:     margin: 0 auto;
 35:     background-color: var(--card-bg);
 36:     border-radius: var(--radius);
 37:     box-shadow: var(--shadow);
 38:     overflow: hidden;
 39: }
 40: 
 41: /* Header */
 42: .options-header {
 43:     display: flex;
 44:     justify-content: space-between;
 45:     align-items: center;
 46:     padding: 20px 28px;
 47:     border-bottom: 1px solid var(--border-color);
 48:     background-color: #ffffff;
 49: }
 50: 
 51: .header-brand {
 52:     display: flex;
 53:     align-items: center;
 54:     gap: 16px;
 55: }
 56: 
 57: .app-logo {
 58:     width: 42px;
 59:     height: 42px;
 60:     border-radius: 8px;
 61:     object-fit: cover;
 62: }
 63: 
 64: .options-header h1 {
 65:     font-size: 20px;
 66:     font-weight: 700;
 67:     color: var(--text-primary);
 68: }
 69: 
 70: .version-badge {
 71:     font-size: 12px;
 72:     color: var(--text-secondary);
 73: }
 74: 
 75: /* Body & Navigation */
 76: .options-body {
 77:     display: grid;
 78:     grid-template-columns: 240px 1fr;
 79:     min-height: 520px;
 80: }
 81: 
 82: .options-nav {
 83:     background-color: #f8fafc;
 84:     border-right: 1px solid var(--border-color);
 85:     padding: 16px 12px;
 86:     display: flex;
 87:     flex-direction: column;
 88:     gap: 6px;
 89: }
 90: 
 91: .nav-item {
 92:     display: flex;
 93:     align-items: center;
 94:     gap: 10px;
 95:     padding: 10px 14px;
 96:     border: none;
 97:     border-radius: 8px;
 98:     background: transparent;
 99:     color: var(--text-secondary);
100:     font-size: 14px;
101:     font-weight: 500;
102:     cursor: pointer;
103:     text-align: left;
104:     transition: all 0.2s ease;
105: }
106: 
107: .nav-item:hover {
108:     background-color: #f1f5f9;
109:     color: var(--text-primary);
110: }
111: 
112: .nav-item.active {
113:     background-color: #eff6ff;
114:     color: var(--primary-color);
115:     font-weight: 600;
116: }
117: 
118: .nav-item .icon {
119:     font-size: 16px;
120: }
121: 
122: /* Content Area */
123: .options-content {
124:     padding: 28px;
125: }
126: 
127: .content-section {
128:     display: none;
129: }
130: 
131: .content-section.active {
132:     display: block;
133: }
134: 
135: .content-section h2 {
136:     font-size: 18px;
137:     font-weight: 600;
138:     margin-bottom: 4px;
139: }
140: 
141: .section-desc {
142:     font-size: 13px;
143:     color: var(--text-secondary);
144:     margin-bottom: 20px;
145: }
146: 
147: .card {
148:     background: var(--card-bg);
149:     border: 1px solid var(--border-color);
150:     border-radius: 8px;
151:     padding: 20px;
152:     display: flex;
153:     flex-direction: column;
154:     gap: 18px;
155: }
156: 
157: .form-group {
158:     display: flex;
159:     flex-direction: column;
160:     gap: 6px;
161: }
162: 
163: .form-group label {
164:     font-size: 14px;
165:     font-weight: 600;
166:     color: var(--text-primary);
167: }
168: 
169: .form-control {
170:     padding: 10px 12px;
171:     border: 1px solid var(--border-color);
172:     border-radius: 6px;
173:     font-size: 14px;
174:     outline: none;
175:     transition: border-color 0.2s;
176: }
177: 
178: .form-control:focus {
179:     border-color: var(--primary-color);
180:     box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
181: }
182: 
183: .help-text {
184:     font-size: 12px;
185:     color: var(--text-secondary);
186: }
187: 
188: .divider {
189:     border: none;
190:     border-top: 1px solid var(--border-color);
191:     margin: 4px 0;
192: }
193: 
194: /* Switch & Controls */
195: .checkbox-group {
196:     flex-direction: row;
197:     align-items: center;
198:     justify-content: space-between;
199: }
200: 
201: .switch-label {
202:     display: flex;
203:     align-items: center;
204:     gap: 12px;
205:     cursor: pointer;
206:     user-select: none;
207: }
208: 
209: .switch-label input {
210:     display: none;
211: }
212: 
213: .slider {
214:     width: 44px;
215:     height: 24px;
216:     background-color: #cbd5e1;
217:     border-radius: 12px;
218:     position: relative;
219:     transition: background-color 0.2s;
220: }
221: 
222: .slider::before {
223:     content: "";
224:     position: absolute;
225:     top: 2px;
226:     left: 2px;
227:     width: 20px;
228:     height: 20px;
229:     background-color: white;
230:     border-radius: 50%;
231:     transition: transform 0.2s;
232: }
233: 
234: .switch-label input:checked + .slider {
235:     background-color: var(--primary-color);
236: }
237: 
238: .switch-label input:checked + .slider::before {
239:     transform: translateX(20px);
240: }
241: 
242: .label-text {
243:     font-size: 14px;
244:     font-weight: 500;
245: }
246: 
247: /* Buttons */
248: .btn {
249:     padding: 10px 16px;
250:     font-size: 14px;
251:     font-weight: 600;
252:     border-radius: 6px;
253:     border: none;
254:     cursor: pointer;
255:     transition: all 0.2s ease;
256:     display: inline-flex;
257:     align-items: center;
258:     justify-content: center;
259:     gap: 8px;
260: }
261: 
262: .primary-btn {
263:     background-color: var(--primary-color);
264:     color: white;
265: }
266: 
267: .primary-btn:hover {
268:     background-color: var(--primary-hover);
269: }
270: 
271: .secondary-btn {
272:     background-color: var(--secondary-bg);
273:     color: var(--text-primary);
274: }
275: 
276: .secondary-btn:hover {
277:     background-color: var(--secondary-hover);
278: }
279: 
280: .danger-btn {
281:     background-color: #fee2e2;
282:     color: var(--danger-color);
283: }
284: 
285: .danger-btn:hover {
286:     background-color: #fca5a5;
287: }
288: 
289: .actions-row {
290:     display: flex;
291:     gap: 12px;
292:     align-items: center;
293:     flex-wrap: wrap;
294: }
295: 
296: .file-input-label input[type="file"] {
297:     display: none;
298: }
299: 
300: /* Toast */
301: .toast {
302:     position: fixed;
303:     bottom: 24px;
304:     right: 24px;
305:     background-color: var(--text-primary);
306:     color: white;
307:     padding: 12px 20px;
308:     border-radius: 8px;
309:     font-size: 14px;
310:     box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
311:     opacity: 0;
312:     transform: translateY(10px);
313:     transition: all 0.3s ease;
314:     pointer-events: none;
315: }
316: 
317: .toast.show {
318:     opacity: 1;
319:     transform: translateY(0);
320: }
</file>


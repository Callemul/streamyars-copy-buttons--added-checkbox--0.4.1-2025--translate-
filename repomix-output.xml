145:                 version: '1.0.0',
146:                 db: result.db || {},
147:                 syh_options: result.syh_options || DEFAULT_OPTIONS
148:             };
149:             const jsonStr = JSON.stringify(exportData, null, 2);
150:             const blob = new Blob([jsonStr], { type: 'application/json' });
151:             const url = URL.createObjectURL(blob);
152: 
153:             const a = document.createElement('a');
154:             a.href = url;
155:             a.download = `streamyard_helper_config_${new Date().toISOString().slice(0, 10)}.json`;
156:             a.click();
157:             URL.revokeObjectURL(url);
158: 
159:             this.showToast('📥 Конфігурацію успішно експортовано');
160:         });
161:     }
162: 
163:     private validateImportedConfig(data: any): boolean {
164:         if (!data || typeof data !== 'object' || Array.isArray(data)) {
165:             return false;
166:         }
167:         const hasDb = 'db' in data;
168:         const hasOptions = 'syh_options' in data;
169:         if (!hasDb && !hasOptions) {
170:             return false;
171:         }
172:         if (hasDb && (typeof data.db !== 'object' || data.db === null || Array.isArray(data.db))) {
173:             return false;
174:         }
175:         if (hasOptions && (typeof data.syh_options !== 'object' || data.syh_options === null || Array.isArray(data.syh_options))) {
176:             return false;
177:         }
178:         return true;
179:     }
180: 
181:     private importConfig(event: Event): void {
182:         const input = event.target as HTMLInputElement;
183:         if (!input.files || input.files.length === 0) return;
184: 
185:         const file = input.files[0];
186:         const reader = new FileReader();
187:         reader.onload = (e) => {
188:             try {
189:                 const imported = JSON.parse(e.target?.result as string);
190:                 if (this.validateImportedConfig(imported)) {
191:                     SYH_STORAGE.set({
192:                         'db': imported.db || {},
193:                         'syh_options': imported.syh_options || DEFAULT_OPTIONS
194:                     }, () => {
195:                         this.loadSettings();
196:                         this.showToast('📤 Конфігурацію успішно імпортовано!');
197:                     });
198:                 } else {
199:                     alert('Некоректний формат файлу конфігурації.');
200:                 }
201:             } catch (err) {
202:                 alert('Помилка при зчитуванні JSON файлу.');
203:             }
204:         };
205:         reader.readAsText(file);
206:     }
207: 
208:     private resetDefaults(): void {
209:         if (confirm('Ви впевнені, що хочете скинути всі налаштування до стандартних?')) {
210:             SYH_STORAGE.set({
211:                 'db': { newTitleSS: DEFAULT_OPTIONS.newTitleSS, newTitlePreach: DEFAULT_OPTIONS.newTitlePreach },
212:                 'syh_options': DEFAULT_OPTIONS
213:             }, () => {
214:                 this.loadSettings();
215:                 this.showToast('⚠️ Налаштування скинуто до початкових!');
216:             });
217:         }
218:     }
219: 
220:     private showToast(msg: string): void {
221:         const toast = document.getElementById('toastNotification');
222:         if (!toast) return;

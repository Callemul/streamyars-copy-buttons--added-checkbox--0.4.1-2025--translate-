153:     loadChartJs: async function(): Promise<boolean> {
154:         if (typeof Chart !== 'undefined') return true;
155:         if (this._chartLoadingPromise) return this._chartLoadingPromise;
156: 
157:         this._chartLoadingPromise = (async () => {
158:             if (typeof Chart !== 'undefined') return true;
159:             try {
160:                 const url = (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.getURL) 
161:                     ? chrome.runtime.getURL('lib/chart.js') 
162:                     : 'lib/chart.js';
163:                 const response = await fetch(url);
164:                 const scriptText = await response.text();
165:                 (0, eval)(scriptText);
166:                 return typeof Chart !== 'undefined';
167:             } catch (err) {
168:                 console.error("[SYH] Помилка завантаження Chart.js:", err);
169:                 return false;
170:             }
171:         })();
172: 
173:         return this._chartLoadingPromise;

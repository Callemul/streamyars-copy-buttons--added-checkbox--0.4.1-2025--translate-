  1: // youtube/youtube_content.ts
  2: import { YT_SELECTORS } from './yt_selectors.ts';
  3: import { addButtonsToYTComment, extractCommentId, restoreButtonState, restoreCheckboxState } from './yt_ui.ts';
  4: import { bindYTEvents, YTCollectedItem } from './yt_events.ts';
  5: import { SYH_STORAGE } from '../modules/storage.ts';
  6: import { SYH_COMMENT_ASSISTANT } from '../modules/comment_assistant.ts';
  7: import { SYH_CONFIG } from '../modules/config.ts';
  8: 
  9: console.log('[SYH] YouTube content script initializing...');
 10: 
 11: interface StateCache {
 12:     buttonStates: Record<string, 'question' | 'prayer'>;
 13:     checkboxStates: Record<string, { checked: boolean; timestamp: number }>;
 14:     collectedList: YTCollectedItem[];
 15:     youtubeEnabled: boolean;
 16: }
 17: 
 18: const stateCache: StateCache = {
 19:     buttonStates: {},
 20:     checkboxStates: {},
 21:     collectedList: [],
 22:     youtubeEnabled: true
 23: };
 24: 
 25: let observer: MutationObserver | null = null;
 26: 
 27: /**
 28:  * Обробка одного вузла коментаря YouTube
 29:  */
 30: function processYTComment(commentNode: Element) {
 31:     if (!commentNode || !stateCache.youtubeEnabled) return;
 32: 
 33:     // Впевнюємося, що селектор headerAuthor присутній
 34:     const headerAuthor = commentNode.querySelector(YT_SELECTORS.headerAuthor);
 35:     if (!headerAuthor) return;
 36: 
 37:     // 1. Ін'єкція UI (кнопки, 📄, чекбокс)
 38:     addButtonsToYTComment(commentNode);
 39: 
 40:     // 2. Витягуємо ID
 41:     const commentId = extractCommentId(commentNode);
 42:     if (!commentId) return;
 43: 
 44:     // 3. Інтеграція хайлайту тригерних слів
 45:     try {
 46:         SYH_COMMENT_ASSISTANT.processComment(commentNode);
 47:     } catch (err) {
 48:         console.warn('[SYH YT] Highlight error:', err);
 49:     }
 50: 
 51:     // 4. Відновлення станів з кешу
 52:     restoreButtonState(commentNode, commentId, stateCache.buttonStates);
 53:     restoreCheckboxState(commentNode, commentId, stateCache.checkboxStates);
 54: 
 55:     // 5. Прив'язка обробників подій
 56:     bindYTEvents(commentNode, commentId, stateCache);
 57: }
 58: 
 59: /**
 60:  * Сканування та обробка всіх коментарів на сторінці
 61:  */
 62: function processAllYTComments() {
 63:     if (!stateCache.youtubeEnabled) return;
 64:     const comments = document.querySelectorAll(YT_SELECTORS.commentBlock);
 65:     comments.forEach(comment => processYTComment(comment));
 66: }
 67: 
 68: /**
 69:  * Запуск спостерігача за DOM (MutationObserver)
 70:  */
 71: function startObserver() {
 72:     if (observer) observer.disconnect();
 73: 
 74:     observer = new MutationObserver((mutations) => {
 75:         if (!stateCache.youtubeEnabled) return;
 76: 
 77:         for (const mutation of mutations) {
 78:             for (const node of Array.from(mutation.addedNodes)) {
 79:                 if (node.nodeType !== Node.ELEMENT_NODE) continue;
 80:                 const el = node as Element;
 81: 
 82:                 if (el.matches && el.matches(YT_SELECTORS.commentBlock)) {
 83:                     processYTComment(el);
 84:                 } else if (el.querySelectorAll) {
 85:                     const comments = el.querySelectorAll(YT_SELECTORS.commentBlock);
 86:                     comments.forEach(comment => processYTComment(comment));
 87:                 }
 88:             }
 89:         }
 90:     });
 91: 
 92:     observer.observe(document.body || document.documentElement, {
 93:         childList: true,
 94:         subtree: true
 95:     });
 96: }
 97: 
 98: /**
 99:  * Ініціалізація модуля
100:  */
101: function initYouTubeModule() {
102:     SYH_STORAGE.get(
103:         ['syh_options', 'syh_yt_button_states', 'syh_yt_checkbox_state', 'syh_yt_collected'],
104:         (res) => {
105:             const options = res.syh_options || {};
106:             stateCache.youtubeEnabled = options.youtube_enabled !== false;
107: 
108:             if (!stateCache.youtubeEnabled) {
109:                 console.log('[SYH YT] YouTube module is disabled in options');
110:                 return;
111:             }
112: 
113:             stateCache.buttonStates = res.syh_yt_button_states || {};
114:             stateCache.checkboxStates = res.syh_yt_checkbox_state || {};
115:             stateCache.collectedList = res.syh_yt_collected || [];
116: 
117:             // 1. Ініціалізація помічника коментарів з селекторами YouTube
118:             SYH_COMMENT_ASSISTANT.init({
119:                 SELECTORS: YT_SELECTORS,
120:                 TRIGGER_WORDS: SYH_CONFIG?.TRIGGER_WORDS || ['вопрос']
121:             });
122: 
123:             // 2. Первинна обробка коментарів
124:             processAllYTComments();
125: 
126:             // 3. Запуск MutationObserver
127:             startObserver();
128: 
129:             console.log('[SYH YT] YouTube module loaded successfully');
130:         }
131:     );
132: }
133: 
134: // Підписка на зміни у сховищі (реактивне оновлення налаштувань та станів)
135: SYH_STORAGE.onChanged((changes) => {
136:     if (changes.syh_options) {
137:         const newOptions = changes.syh_options.newValue || {};
138:         const wasEnabled = stateCache.youtubeEnabled;
139:         stateCache.youtubeEnabled = newOptions.youtube_enabled !== false;
140: 
141:         if (!wasEnabled && stateCache.youtubeEnabled) {
142:             initYouTubeModule();
143:         } else if (wasEnabled && !stateCache.youtubeEnabled) {
144:             if (observer) observer.disconnect();
145:             // Видаляємо кнопки, якщо модуль вимкнено
146:             document.querySelectorAll('.syh-yt-buttons').forEach(el => el.remove());
147:         }
148:     }
149: 
150:     if (changes.syh_yt_button_states && changes.syh_yt_button_states.newValue) {
151:         stateCache.buttonStates = changes.syh_yt_button_states.newValue;
152:         processAllYTComments();
153:     }
154: 
155:     if (changes.syh_yt_checkbox_state && changes.syh_yt_checkbox_state.newValue) {
156:         stateCache.checkboxStates = changes.syh_yt_checkbox_state.newValue;
157:         processAllYTComments();
158:     }
159: });
160: 
161: // Запуск після завантаження DOM
162: if (document.readyState === 'loading') {
163:     document.addEventListener('DOMContentLoaded', initYouTubeModule);
164: } else {
165:     initYouTubeModule();
166: }
</file>


 50: function matches(el, selector) {
 51:     if (selector.includes('button')) {
 52:         if (el.tagName === 'BUTTON' || el.getAttribute('role') === 'button') return true;
 53:     }
 54:     if (selector === 'button') {
 55:         return el.tagName === 'BUTTON';
 56:     }
 57:     if (selector === 'div[role="dialog"][aria-label="Are you still there?"]') {
 58:         return el.tagName === 'DIV' && el.getAttribute('role') === 'dialog' && el.getAttribute('aria-label') === 'Are you still there?';
 59:     }
 60:     if (selector === 'div[role="dialog"]') {
 61:         return el.tagName === 'DIV' && el.getAttribute('role') === 'dialog';
 62:     }
 63:     if (selector === '[aria-modal="true"]') {
 64:         return el.getAttribute('aria-modal') === 'true';
 65:     }
 66:     if (selector === 'div[class*="modal"]') {
 67:         return el.tagName === 'DIV' && (el.getAttribute('class') || '').includes('modal');
 68:     }
 69:     if (selector === 'div[class*="Dialog"]') {
 70:         return el.tagName === 'DIV' && (el.getAttribute('class') || '').includes('Dialog');
 71:     }
 72:     return false;
 73: }

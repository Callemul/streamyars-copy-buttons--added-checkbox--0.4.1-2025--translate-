581:             const $temp = $("<textarea>"); 
582:             $("body").append($temp); 
583:             $temp.val(txt).select(); 
584:             document.execCommand("copy"); 
585:             $temp.remove(); 
586:         };
587: 
588:         try {
589:             if (navigator.clipboard && navigator.clipboard.writeText) {
590:                 await navigator.clipboard.writeText(plainText);
591:             } else {
592:                 copyFallback(plainText);
593:             }
594:         } catch (err) {
595:             console.warn("Clipboard API failed, using fallback:", err);
596:             copyFallback(plainText);
597:         }
598: 
599:         $btn.text("Скопійовано! ✅"); 
600:         setTimeout(() => $btn.text(originalText), 2000);
601:     });
602: });

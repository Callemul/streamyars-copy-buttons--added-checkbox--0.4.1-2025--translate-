 68:     private loadSettings(): void {
 69:         SYH_STORAGE.get(['db', 'syh_options'], (result) => {
 70:             const db = result.db || {};
 71:             const opts: Partial<OptionsState> = result.syh_options || {};
 72: 
 73:             const sschoolInput = document.getElementById('optSschoolName') as HTMLInputElement;
 74:             if (sschoolInput) sschoolInput.value = db.newTitleSS || DEFAULT_OPTIONS.newTitleSS;
 75: 
 76:             const preachInput = document.getElementById('optPreachName') as HTMLInputElement;
 77:             if (preachInput) preachInput.value = db.newTitlePreach || DEFAULT_OPTIONS.newTitlePreach;
 78: 
 79:             const langSelect = document.getElementById('optLanguage') as HTMLSelectElement;
 80:             if (langSelect) langSelect.value = opts.ui_locale || DEFAULT_OPTIONS.ui_locale;
 81: 
 82:             const antiAfkToggle = document.getElementById('optAntiAfkEnabled') as HTMLInputElement;
 83:             if (antiAfkToggle) antiAfkToggle.checked = opts.anti_afk_enabled !== undefined ? opts.anti_afk_enabled : DEFAULT_OPTIONS.anti_afk_enabled;
 84: 
 85:             const antiAfkInterval = document.getElementById('optAntiAfkInterval') as HTMLInputElement;

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["chrome", "jquery"]
  },
  "include": [
    "modules/**/*",
    "main.ts",
    "popup/**/*",
    "youtube/**/*",
    "options/**/*",
    "background/**/*"
  ]
}

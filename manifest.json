{
  "name": "StreamYard Helper",
  "manifest_version": 3,
  "version": "0.8",
  "description": "Streamyard.com Extension. Add new buttons to comments and banners",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  
  "content_scripts": [
    {
      "matches": ["https://streamyard.com/*"],
      "css": ["styles.css"],
      "js": [
        "lib/jquery-3.5.0.js",
        "lib/chart.js",
        "modules/config.js",
        "modules/state.js",
        "modules/utils.js",
        "modules/ui_core.js",
        "modules/ui_comments.js",
        "modules/ui_banners_items.js",
        "modules/ui_banners_tabs.js",
        "modules/ui_banners_filters.js",
        "modules/parsers.js",
        "modules/banner_creator.js",
        "modules/event_comments.js",
        "modules/event_banners.js",
        "modules/video_copier.js",
        "modules/stats_tracker.js",
        "modules/stats_exporter.js",
        "main.js"
      ]
    }
  ],
  "action": {
    "default_title": "Streamyard Helper 0.8",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "assets/imgs/1.png",
    "32": "assets/imgs/1.png",
    "48": "assets/imgs/1.png",
    "128": "assets/imgs/1.png"
  }
}
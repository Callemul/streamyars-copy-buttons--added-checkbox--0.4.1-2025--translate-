{
  "name": "StreamYard copy buttons v0.62",
  "manifest_version": 3,
  "version": "0.62",
  "description": "Streamyard.com Extension. Add new buttons to commets and banners",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://streamyard.com/*"],
      "css": ["styles.css"],
      "js": [
        "lib/jquery-3.5.0.js",
        "lib/chart.js",
        "modules/config.js",
        "modules/state.js",
        "modules/utils.js",
        "modules/ui.js",
        "modules/parsers.js",
        "modules/banner_creator.js",
        "modules/event_handlers.js",
        "modules/video_copier.js",
        "modules/stats_tracker.js",
        "main.js"
        
      ]
    },
    {
      "run_at": "document_end",
      "js": ["google_forms.js"],
      "matches": [
        "https://docs.google.com/forms/d/1Uv2PfvWwVCbS_FKEOFA0-YwISzLicsISMqVscMeBlTU/edit?ts=62502c5a"
      ]
    }
  ],
  "action": {
    "default_title": "Streamyard Helper 0.62",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "assets/imgs/1.png",
    "32": "assets/imgs/1.png",
    "48": "assets/imgs/1.png",
    "128": "assets/imgs/1.png"
  }
}
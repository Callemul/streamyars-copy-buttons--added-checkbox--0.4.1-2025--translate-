{
  "name": "streamyard-helper",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --experimental-strip-types --import ./tests/ts_loader.js --import ./tests/setup/happy-dom.ts --test \"tests/*.test.js\"",
    "test:youtube": "node --experimental-strip-types --import ./tests/ts_loader.js --import ./tests/setup/happy-dom.ts --test \"tests/yt_*.test.js\"",
    "test:studio": "node --experimental-strip-types --import ./tests/ts_loader.js --import ./tests/setup/happy-dom.ts --test \"tests/studio_*.test.js\"",
    "test:coverage": "node --experimental-strip-types --import ./tests/ts_loader.js --import ./tests/setup/happy-dom.ts --test --experimental-test-coverage \"tests/*.test.js\"",
    "lint": "eslint --no-error-on-unmatched-pattern --no-warn-ignored \"modules/**/*.ts\" main.ts \"popup/**/*.ts\" \"options/**/*.ts\" \"youtube/**/*.ts\" \"background/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-module-cycles.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:architecture && npm test && npm run build"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/chrome": "^0.2.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}

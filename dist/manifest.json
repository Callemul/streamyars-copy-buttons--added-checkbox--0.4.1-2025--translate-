{
  "name": "__MSG_extName__",
  "manifest_version": 3,
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://streamyard.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/jquery-3.7.1.js-T69IKIHc.js",
        "assets/chart.js-CegLu_W4.js",
        "assets/main.js-loader-N14woj_u.js"
      ],
      "matches": [
        "https://streamyard.com/*"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://streamyard.com/*"
      ],
      "resources": [
        "Release_notes.md",
        "Daily_tips.md",
        "lib/chart.js",
        "assets/jquery-3.7.1.js-T69IKIHc.js",
        "assets/chart.js-CegLu_W4.js",
        "assets/storage-62pKN20L.js",
        "assets/main.js-CYxc1JOL.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "action": {
    "default_title": "StreamYard Helper v1.0.0",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/imgs/1.png",
    "32": "assets/imgs/1.png",
    "48": "assets/imgs/1.png",
    "128": "assets/imgs/1.png"
  }
}

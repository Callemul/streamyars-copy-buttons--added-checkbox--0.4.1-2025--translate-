{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "headerText": "Project source code bundle for AI audit and review.",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "topFilesFirst": true
  },
  "include": [
    "modules/**/*",
    "popup/**/*",
    "youtube/**/*",
    "options/**/*",
    "background/**/*",
    "tests/**/*",
    "main.ts",
    "manifest.json",
    "styles.css",
    "test_parsers.js",
    "eslint.config.js",
    "vite.config.js",
    "tsconfig.json",
    "package.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "package-lock.json",
      "repomix-output.xml",
      "repomix-output.txt",
      "repomix-output.md",
      "*.log",
      ".idea/**",
      ".kilo/**"
    ]
  }
}
